---
interface Props {
  backLabel?: string;
}

const { backLabel = '回裝修工具箱' } = Astro.props;
---

<header class="resource-header">
  <div class="resource-header-inner">
    <a href="/" class="resource-brand" aria-label="回懂屋首頁">
      <span class="resource-brand-mark">
        <img src="/images/logo-dongwu-white.png" alt="" width="30" height="30" />
      </span>
      <span>
        <strong>懂屋</strong>
        <small>KNOW YOUR HOME</small>
      </span>
    </a>
    <nav class="resource-nav" aria-label="領取頁導覽">
      <a href="/toolbox/">← {backLabel}</a>
      <a href="/subscribe/" class="resource-subscribe">訂閱電子報</a>
    </nav>
  </div>
</header>

<style>
  .resource-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid rgba(28, 24, 21, 0.08);
    background: rgba(245, 240, 232, 0.88);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
  }

  .resource-header-inner {
    width: min(1160px, calc(100% - 40px));
    min-height: 72px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .resource-brand {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    color: #1C1815 !important;
    text-decoration: none;
  }

  .resource-brand-mark {
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    border-radius: 13px;
    background: #1C1815;
    box-shadow: 0 8px 18px rgba(28, 24, 21, 0.12);
  }

  .resource-brand-mark img {
    width: 28px;
    height: 28px;
  }

  .resource-brand strong,
  .resource-brand small {
    display: block;
  }

  .resource-brand strong {
    font-size: 0.98rem;
    letter-spacing: 0.14em;
    line-height: 1.1;
  }

  .resource-brand small {
    margin-top: 4px;
    color: #8A7564;
    font-size: 0.57rem;
    font-weight: 700;
    letter-spacing: 0.2em;
  }

  .resource-nav {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .resource-nav a {
    color: #5E5147 !important;
    font-size: 0.86rem;
    font-weight: 700;
    text-decoration: none;
  }

  .resource-nav a:hover {
    color: #D4886A !important;
  }

  .resource-nav .resource-subscribe {
    padding: 9px 16px;
    border: 1px solid rgba(28, 24, 21, 0.14);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.58);
  }

  @media (max-width: 620px) {
    .resource-header-inner {
      width: min(100% - 28px, 1160px);
      min-height: 62px;
    }

    .resource-brand small,
    .resource-nav .resource-subscribe {
      display: none;
    }

    .resource-brand-mark {
      width: 34px;
      height: 34px;
      border-radius: 11px;
    }

    .resource-nav {
      gap: 10px;
    }

    .resource-nav a {
      font-size: 0.8rem;
    }
  }
</style>
