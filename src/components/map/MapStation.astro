---
import type { MapStation } from '../../data/mapStations';

interface Props {
  station: MapStation;
  side?: 'left' | 'right';
}

const { station, side = 'left' } = Astro.props;
---

<section
  id={station.id}
  class:list={['map-station', `map-station--${side}`, station.status === 'coming-soon' && 'is-locked']}
  data-map-station={station.id}
  data-number={station.number}
  data-name={station.name}
  data-phase={station.phase}
  data-phase-name={station.phaseName}
  data-status={station.status}
  data-scene-kind={station.sceneKind}
  data-event={station.d1Event}
>
  <div
    class="map-station__miniature"
    style={`--map-focus-x:${station.mapPosition.x}%;--map-focus-y:${station.mapPosition.y}%`}
    aria-hidden="true"
  >
    <img src="/map/map-whale-keyframe-v1.webp" alt="" width="1680" height="944" loading="lazy" decoding="async" />
    <b>{station.number}</b>
  </div>

  <article class="map-station__copy">
    <div class="map-station__meta">
      <span>{station.phaseName}</span>
      {station.status === 'coming-soon' && <span class="map-station__lock">分站上線</span>}
    </div>
    <p class="map-station__number" aria-hidden="true">{station.number}</p>
    <h2>{station.name}</h2>
    <p class="map-station__hook">{station.hook}</p>
    <div class="map-station__tool-copy">
      <h3>{station.tool.title}</h3>
      <p>{station.tool.intro}</p>
      <ul>
        {station.tool.points.map((point) => <li>{point}</li>)}
      </ul>
    </div>
    <button
      type="button"
      class="map-station__open"
      data-open-station={station.id}
      aria-haspopup="dialog"
    >
      {station.status === 'open' ? '打開本站工具' : '看本站預告'}
      <span aria-hidden="true">↗</span>
    </button>
  </article>
</section>
