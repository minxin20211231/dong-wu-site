<dialog class="station-panel" data-station-panel aria-labelledby="station-panel-title">
  <form method="dialog" class="station-panel__close-form">
    <button class="station-panel__close" value="close" aria-label="關閉工具面板">關閉 <span aria-hidden="true">×</span></button>
  </form>

  <div class="station-panel__inner">
    <header class="station-panel__header">
      <p data-panel-phase>籌備與規劃</p>
      <p class="station-panel__number" data-panel-number>01</p>
      <h2 id="station-panel-title" data-panel-name>買屋驗屋站</h2>
      <p class="station-panel__hook" data-panel-hook></p>
    </header>

    <div class="station-panel__body">
      <section class="station-panel__tool" data-panel-tool>
        <p class="station-panel__eyebrow">本站工具</p>
        <h3 data-panel-tool-title></h3>
        <p data-panel-tool-intro></p>
        <ul data-panel-tool-points></ul>
      </section>

      <section class="station-panel__gate" data-panel-gate>
        <p class="station-panel__eyebrow">免費解鎖</p>
        <h3>把前四站的工具一起打開</h3>
        <p>留下稱呼和 Email，就能一次打開前四站。這份 Demo 不會真的寄出資料。</p>
        <form class="station-panel__form" data-email-unlock-form>
          <label for="map-unlock-name">怎麼稱呼您？</label>
          <input id="map-unlock-name" name="name" type="text" autocomplete="name" required placeholder="您的稱呼" data-email-unlock-name />
          <label for="map-unlock-email">Email</label>
          <div>
            <input id="map-unlock-email" name="email" type="email" autocomplete="email" required placeholder="name@example.com" />
            <button type="submit" data-email-submit>免費解鎖</button>
          </div>
          <p class="station-panel__form-status" data-email-status role="status"></p>
        </form>
      </section>

      <section class="station-panel__waitlist" data-panel-waitlist hidden>
        <p class="station-panel__eyebrow">分站上線</p>
        <h3>這站正在把工具內容整理好</h3>
        <p>想等這站上線，可以先登記。這份 Demo 只示範流程，不會真的寄出資料。</p>
        <form class="station-panel__form" data-waitlist-form>
          <label for="map-waitlist-name">怎麼稱呼您？</label>
          <input id="map-waitlist-name" name="name" type="text" autocomplete="name" required placeholder="您的稱呼" data-waitlist-name />
          <label for="map-waitlist-email">Email</label>
          <div>
            <input id="map-waitlist-email" name="email" type="email" autocomplete="email" required placeholder="name@example.com" />
            <button type="submit" data-waitlist-submit>搶先登記</button>
          </div>
          <p class="station-panel__form-status" data-waitlist-status role="status"></p>
        </form>
      </section>
    </div>
  </div>
</dialog>
