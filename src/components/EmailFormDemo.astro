---
interface Props {
  formId: string;
  buttonLabel: string;
  note?: string;
  compact?: boolean;
  eventName?: string;
  optIn?: {
    name: string;
    label: string;
    eventName?: string;
  };
}

const {
  formId,
  buttonLabel,
  note = '下載連結直接寄給你，隨時可退訂。',
  compact = false,
  eventName,
  optIn,
} = Astro.props;
---

<form
  id={formId}
  class:list={['demo-email-form', compact && 'demo-email-form-compact']}
  data-integration="pending"
  data-event={eventName}
  data-opt-in-event={optIn?.eventName}
>
  <div class="demo-email-fields">
    <div class="demo-email-field">
      <label for={`${formId}-name`}>如何稱呼你？</label>
      <input
        id={`${formId}-name`}
        name="name"
        type="text"
        autocomplete="name"
        placeholder="你的稱呼"
        required
      />
    </div>
    <div class="demo-email-field">
      <label for={`${formId}-email`}>寄到哪個信箱？</label>
      <div class="demo-email-row">
        <input
          id={`${formId}-email`}
          name="email"
          type="email"
          inputmode="email"
          autocomplete="email"
          placeholder="你的 Email"
          required
        />
        <button type="submit">{buttonLabel}</button>
      </div>
    </div>
  </div>
  {optIn && (
    <label class="demo-email-opt-in">
      <input type="checkbox" name={optIn.name} value="yes" />
      <span>{optIn.label}</span>
    </label>
  )}
  <p>{note}</p>
</form>

<style>
  .demo-email-form { width: 100%; max-width: 620px; }
  .demo-email-fields {
    display: grid; grid-template-columns: minmax(0, .68fr) minmax(0, 1.32fr); gap: 10px;
  }
  .demo-email-field { min-width: 0; }
  .demo-email-field label {
    display: block; margin-bottom: 8px; color: #4E4239;
    font-size: 0.78rem; font-weight: 800; letter-spacing: 0.06em;
  }
  .demo-email-field > input {
    width: 100%; min-width: 0; min-height: 60px; padding: 12px 14px;
    border: 1px solid rgba(28, 24, 21, 0.1); border-radius: 16px; outline: 0;
    background: rgba(255, 255, 255, 0.78); color: #1C1815; font: inherit;
    box-shadow: 0 18px 45px rgba(89, 64, 47, 0.08);
  }
  .demo-email-row {
    display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 9px;
    padding: 6px; border: 1px solid rgba(28, 24, 21, 0.1); border-radius: 16px;
    background: rgba(255, 255, 255, 0.78); box-shadow: 0 18px 45px rgba(89, 64, 47, 0.08);
  }
  .demo-email-row input {
    width: 100%; min-width: 0; padding: 12px 13px; border: 0; outline: 0;
    background: transparent; color: #1C1815; font: inherit;
  }
  .demo-email-field input::placeholder { color: #9A8C80; }
  .demo-email-field input:focus-visible { border-radius: 10px; box-shadow: 0 0 0 3px rgba(212, 136, 106, 0.2); }
  .demo-email-row button {
    min-height: 46px; padding: 11px 20px; border: 0; border-radius: 11px;
    background: #D4886A; color: #1C1815; font: inherit; font-size: 0.9rem;
    font-weight: 900; white-space: nowrap; cursor: pointer;
    box-shadow: 0 8px 18px rgba(212, 136, 106, 0.22);
    transition: transform 0.2s ease, background 0.2s ease;
  }
  .demo-email-row button:hover { transform: translateY(-1px); background: #DE957A; }
  .demo-email-form > p { margin: 9px 4px 0; color: #7A6B60; font-size: 0.72rem; line-height: 1.5; }
  .demo-email-opt-in {
    width: fit-content; margin: 12px 4px 0; display: flex; align-items: center; gap: 10px;
    color: #4E4239; font-size: .92rem; font-weight: 750; line-height: 1.5; cursor: pointer;
  }
  .demo-email-opt-in input {
    width: 20px; height: 20px; margin: 0; flex-shrink: 0; accent-color: #D4886A; cursor: pointer;
  }
  .demo-email-form-compact .demo-email-row,
  .demo-email-form-compact .demo-email-field > input { box-shadow: none; }
  @media (max-width: 520px) {
    .demo-email-fields { grid-template-columns: 1fr; }
    .demo-email-row { grid-template-columns: 1fr; }
    .demo-email-row button { width: 100%; }
  }
</style>
