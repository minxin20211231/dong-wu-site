---
/*
 * PostLayout — 部落格文章專用 layout
 *
 * 設計原則：閱讀優先（白底黑字）
 * - 文章頁脫離首頁的「深海黑鯨金」品牌氛圍
 * - 採用閱讀型雜誌排版：白底、黑字、單欄、適中行距
 * - 連結沿用品牌 accent 色（#B8977E）建立識別
 *
 * 不修改 global.css；本 layout 用 inline <style> 覆蓋
 */
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';

interface TocHeading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description?: string;
  publishDate: Date;
  updateDate?: Date;
  dim: string;
  tags?: string[];
  heroImage?: string;
  heroAlt?: string;
  headings?: TocHeading[];
  body?: string;
}

const { title, description, publishDate, updateDate, dim, tags, heroImage, heroAlt, headings = [], body } = Astro.props;

const fullTitle = `${title}｜懂屋 Know Your Home`;

const fmt = (d: Date) =>
  d.toLocaleDateString('zh-TW', { year: 'numeric', month: 'long', day: 'numeric' });

const ogImageUrl = heroImage
  ? new URL(heroImage, Astro.site).toString()
  : null;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const logoUrl = new URL('/images/logo-dongwu-white.png', Astro.site).toString();

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description || undefined,
  image: ogImageUrl || undefined,
  datePublished: publishDate.toISOString(),
  dateModified: (updateDate || publishDate).toISOString(),
  author: {
    '@type': 'Person',
    name: '鄭晏旻',
    alternateName: 'Bibo',
    url: new URL('/about/', Astro.site).toString(),
    jobTitle: '室內設計師',
    worksFor: {
      '@type': 'Organization',
      name: '旻欣室內裝修設計工作室',
      url: 'https://minxindesign.com.tw',
    },
  },
  publisher: {
    '@type': 'Organization',
    name: '懂屋 Know Your Home',
    logo: {
      '@type': 'ImageObject',
      url: logoUrl,
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalUrl,
  },
};

// FAQPage Schema — 從文章內文「## 常見問題 FAQ」區塊解析 ### Qn 問答，
// 唯一來源是 markdown body（不在 frontmatter 重抄），全站文章共用同一機制。
function stripMd(s: string): string {
  return s
    .replace(/!\[[^\]]*\]\([^)]*\)/g, '')        // 圖片
    .replace(/\[([^\]]+)\]\([^)]*\)/g, '$1')      // 連結 → 文字
    .replace(/\*\*([^*]+)\*\*/g, '$1')            // 粗體
    .replace(/[*_`]/g, '')                         // 殘留標記
    .replace(/^\s*[-–]\s+/gm, '')                  // 項目符號
    .replace(/^\s*\d+\.\s+/gm, '')                 // 數字清單
    .replace(/\s*\n\s*/g, ' ')                     // 換行 → 空格
    .replace(/\s{2,}/g, ' ')
    .trim();
}

function extractFaq(src?: string): { q: string; a: string }[] {
  if (!src) return [];
  const sec = src.match(/##\s*常見問題\s*FAQ\s*\n([\s\S]*?)(?=\n---\s*\n|\n## (?!#)|$)/);
  if (!sec) return [];
  const out: { q: string; a: string }[] = [];
  const re = /###\s*Q\d+[：:]\s*(.+?)\s*\n([\s\S]*?)(?=\n###\s*Q\d+|$)/g;
  let m: RegExpExecArray | null;
  while ((m = re.exec(sec[1])) !== null) {
    const q = stripMd(m[1]);
    const a = stripMd(m[2]);
    if (q && a) out.push({ q, a });
  }
  return out;
}

const faqs = extractFaq(body);
const faqSchema = faqs.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    }
  : null;

// BreadcrumbList — 首頁 › 所有文章 › 本文，供 SERP 顯示路徑層級
const postsUrl = new URL('/posts/', Astro.site).toString();
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首頁', item: new URL('/', Astro.site).toString() },
    { '@type': 'ListItem', position: 2, name: '所有文章', item: postsUrl },
    { '@type': 'ListItem', position: 3, name: title, item: canonicalUrl },
  ],
};
---

<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="generator" content={Astro.generator} />
  <title>{fullTitle}</title>
  {description && <meta name="description" content={description} />}
  <link rel="canonical" href={canonicalUrl} />

  <meta property="og:title" content={fullTitle} />
  {description && <meta property="og:description" content={description} />}
  <meta property="og:type" content="article" />
  <meta property="og:locale" content="zh_TW" />
  <meta property="og:site_name" content="懂屋 Know Your Home" />
  <meta property="og:url" content={canonicalUrl} />
  {ogImageUrl && (
    <>
      <meta property="og:image" content={ogImageUrl} />
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />
      {heroAlt && <meta property="og:image:alt" content={heroAlt} />}
    </>
  )}

  <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />
  <meta name="twitter:title" content={fullTitle} />
  {description && <meta name="twitter:description" content={description} />}
  {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
</head>
<body class="post-body">
  <div class="post-progress-bar" aria-hidden="true">
    <div class="post-progress-fill" id="post-progress"></div>
  </div>

  <SiteHeader />

  <main class="post-main">
    <article class="post-article">
      <nav class="post-breadcrumb" aria-label="麵包屑">
        <a href="/">首頁</a>
        <span class="post-breadcrumb-sep" aria-hidden="true">›</span>
        <a href="/posts/">所有文章</a>
        <span class="post-breadcrumb-sep" aria-hidden="true">›</span>
        <span class="post-breadcrumb-current" aria-current="page">{dim}</span>
      </nav>
      <p class="post-dim">{dim}</p>
      <h1 class="post-title">{title}</h1>

      {heroImage && (
        <figure class="post-hero">
          <img src={heroImage} alt={heroAlt || title} loading="eager" />
        </figure>
      )}

      <p class="post-meta">
        <time datetime={publishDate.toISOString()}>{fmt(publishDate)}</time>
        {updateDate && <span> · 更新於 <time datetime={updateDate.toISOString()}>{fmt(updateDate)}</time></span>}
      </p>

      {tags && tags.length > 0 && (
        <p class="post-tags">
          {tags.map((tag) => <span class="post-tag">#{tag}</span>)}
        </p>
      )}

      {headings.length > 0 && (
        <nav class="post-toc-inline" data-toc-inline aria-label="文章目錄">
          <p class="post-toc-title">這篇讓我學到</p>
          <ol>
            {headings.map((h) => (
              <li><a href={`#${h.slug}`} data-toc-link={h.slug}>{h.text}</a></li>
            ))}
          </ol>
        </nav>
      )}

      <div class="post-content">
        <slot />
      </div>
    </article>

    {headings.length > 0 && (
      <aside class="post-toc-floating" aria-label="浮動目錄">
        <p class="post-toc-title">這篇讓我學到</p>
        <ol>
          {headings.map((h) => (
            <li><a href={`#${h.slug}`} data-toc-link={h.slug}>{h.text}</a></li>
          ))}
        </ol>
      </aside>
    )}

    <aside class="post-cta-box">
      <div class="post-cta-inner">
        <p class="post-cta-eyebrow">懂屋 · 免費裝修決策工具</p>
        <h3 class="post-cta-title">裝修不知從何開始？</h3>
        <p class="post-cta-text">5 分鐘 AI 裝修診斷，找出你的裝修決策優先順序。</p>
        <a href="/ai-diagnosis/" class="post-cta-btn">免費裝修診斷</a>
      </div>
    </aside>
  </main>

  <footer class="post-footer">
    <div class="post-footer-inner">
      <div class="post-footer-grid">
        <div class="post-footer-col post-footer-brand-col">
          <p class="post-footer-name">懂屋 Know Your Home</p>
          <p class="post-footer-slogan">新成屋屋主的裝修決策系統</p>
        </div>

        <div class="post-footer-col">
          <p class="post-footer-coltitle">站內導覽</p>
          <nav class="post-footer-nav">
            <a href="/about/">關於懂屋</a>
            <a href="/posts/">所有文章</a>
            <a href="https://minxindesign.com.tw" target="_blank" rel="noopener">設計師工作室</a>
            <a href="/subscribe/">訂閱電子報</a>
          </nav>
        </div>

        <div class="post-footer-col">
          <p class="post-footer-coltitle">公司資訊</p>
          <dl class="post-footer-info">
            <div>
              <dt>公司全名</dt>
              <dd>旻欣室內裝修設計工作室</dd>
            </div>
            <div>
              <dt>統一編號</dt>
              <dd>92493311</dd>
            </div>
          </dl>
        </div>
      </div>

      <p class="post-footer-copy">© 2026 懂屋 Know Your Home · 旻欣室內裝修設計工作室</p>
    </div>
  </footer>
</body>
</html>

<style is:global>
  /* 文章頁專用：覆蓋 global.css 的深底配色 */
  body.post-body {
    background: #FFFFFF;
    color: #1A1A1A;
  }

  body.post-body a {
    color: #B8977E;
  }

  body.post-body a:hover {
    color: #D4886A;
    text-decoration: underline;
  }

  /* 閱讀進度條（最頂端、scroll-linked） */
  .post-progress-bar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: rgba(184, 151, 126, 0.12);
    z-index: 100;
    pointer-events: none;
  }

  .post-progress-fill {
    height: 100%;
    width: 0;
    background: linear-gradient(90deg, #B8977E 0%, #D4886A 100%);
    transition: width 0.08s ease-out;
  }

  /* 主容器 */
  .post-main {
    background: #FFFFFF;
    min-height: calc(100vh - 120px);
    padding: 48px 24px 96px;
  }

  .post-article {
    max-width: 720px;
    margin: 0 auto;
  }

  .post-breadcrumb {
    font-size: 0.8rem;
    color: #999;
    margin-bottom: 20px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    line-height: 1.5;
  }

  .post-breadcrumb a {
    color: #888 !important;
    text-decoration: none;
  }

  .post-breadcrumb a:hover {
    color: #B8977E !important;
    text-decoration: underline;
  }

  .post-breadcrumb-sep {
    color: #CCC;
  }

  .post-breadcrumb-current {
    color: #555;
  }

  .post-dim {
    display: inline-block;
    font-size: 0.8rem;
    color: #B8977E;
    letter-spacing: 0.1em;
    margin-bottom: 16px;
    padding: 4px 10px;
    border: 1px solid #B8977E;
    border-radius: 999px;
  }

  .post-title {
    font-size: clamp(1.6rem, 3.4vw, 2.4rem);
    line-height: 1.4;
    color: #1A1A1A;
    font-weight: 700;
    margin-bottom: 16px;
    letter-spacing: -0.01em;
  }

  .post-hero {
    margin: 24px 0 32px;
    border-radius: 12px;
    overflow: hidden;
    background: #FAFAFA;
  }

  .post-hero img {
    width: 100%;
    height: auto;
    display: block;
  }

  .post-meta {
    color: #888888;
    font-size: 0.875rem;
    margin-bottom: 16px;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 48px;
  }

  .post-tag {
    display: inline-block;
    font-size: 0.8rem;
    color: #B8977E;
    background: #FAF7F2;
    padding: 3px 10px;
    border-radius: 999px;
    letter-spacing: 0.02em;
  }

  /* 文章內文 typography */
  .post-content {
    font-size: 1.0625rem;
    line-height: 1.85;
    color: #1A1A1A;
  }

  .post-content h2 {
    font-size: 1.4rem;
    line-height: 1.5;
    font-weight: 700;
    color: #1A1A1A;
    margin: 56px 0 16px;
    padding-top: 24px;
    border-top: 1px solid #EAEAEA;
  }

  .post-content h3 {
    font-size: 1.1rem;
    font-weight: 700;
    color: #1A1A1A;
    margin: 32px 0 12px;
  }

  .post-content p {
    margin: 0 0 20px;
  }

  .post-content strong {
    font-weight: 700;
    color: #000000;
  }

  .post-content ul,
  .post-content ol {
    margin: 0 0 24px;
    padding-left: 24px;
  }

  .post-content li {
    margin: 8px 0;
  }

  .post-content blockquote {
    margin: 28px 0;
    padding: 16px 20px;
    border-left: 3px solid #B8977E;
    background: #FAF7F2;
    color: #444;
    font-size: 0.95em;
    border-radius: 0 4px 4px 0;
  }

  .post-content blockquote p:last-child {
    margin-bottom: 0;
  }

  /* 文末註解區塊（生詞解釋、補充說明） */
  .post-content .post-footnote {
    background: #FAF7F2;
    border: 1px solid #E8DCC8;
    border-radius: 8px;
    padding: 20px 24px;
    margin: 48px 0 0;
    font-size: 0.92rem;
    color: #444;
    line-height: 1.75;
  }

  .post-content .post-footnote + .post-footnote {
    margin-top: 16px;
  }

  .post-content .post-footnote-label {
    display: inline-block;
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    color: #B8977E;
    font-weight: 700;
    margin-bottom: 8px;
  }

  .post-content .post-footnote-title {
    font-weight: 700;
    color: #1A1A1A;
    margin: 0 0 6px;
    font-size: 1rem;
  }

  .post-content .post-footnote p {
    margin: 0 0 8px;
  }

  .post-content .post-footnote p:last-child {
    margin-bottom: 0;
  }

  .post-content table {
    width: 100%;
    border-collapse: collapse;
    margin: 28px 0;
    font-size: 0.95em;
    background: #FFFFFF;
  }

  .post-content table th,
  .post-content table td {
    text-align: left;
    padding: 10px 12px;
    border: 1px solid #E5E5E5;
    vertical-align: top;
  }

  .post-content table th {
    background: #F8F5F1;
    font-weight: 700;
    color: #1A1A1A;
  }

  .post-content table tr:nth-child(even) td {
    background: #FBFAF8;
  }

  .post-content code {
    background: #F4F1ED;
    color: #1A1A1A;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 0.9em;
    font-family: 'Menlo', 'Monaco', 'Consolas', monospace;
  }

  .post-content pre {
    background: #F8F5F1;
    padding: 16px;
    border-radius: 6px;
    overflow-x: auto;
    margin: 24px 0;
  }

  .post-content pre code {
    background: transparent;
    padding: 0;
  }

  .post-content hr {
    border: 0;
    border-top: 1px solid #EAEAEA;
    margin: 48px 0;
  }

  .post-content img {
    width: 100%;
    height: auto;
    margin: 24px 0;
    border-radius: 10px;
    background: #FAFAFA;
  }

  .post-content p img {
    margin: 0;
  }

  /* 通用 CTA box（每篇文末自動繼承） */
  .post-cta-box {
    max-width: 720px;
    margin: 64px auto 0;
    padding: 0 24px;
  }

  .post-cta-inner {
    background: #FAF7F2;
    border: 1px solid #E8DCC8;
    border-radius: 12px;
    padding: 32px 28px;
    text-align: center;
  }

  .post-cta-eyebrow {
    font-size: 0.75rem;
    color: #B8977E;
    letter-spacing: 0.15em;
    margin-bottom: 12px;
    text-transform: uppercase;
  }

  .post-cta-title {
    font-size: 1.4rem;
    font-weight: 700;
    color: #1A1A1A;
    margin-bottom: 8px;
  }

  .post-cta-text {
    color: #555;
    font-size: 0.95rem;
    margin-bottom: 24px;
  }

  .post-cta-btn {
    display: inline-block;
    background: #D4886A;
    color: #FFFFFF !important;
    padding: 12px 28px;
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.95rem;
    transition: background 0.2s;
  }

  .post-cta-btn:hover {
    background: #B8977E;
    text-decoration: none !important;
  }

  .post-cta-btn-disabled {
    background: #C4B8A8;
    cursor: not-allowed;
    pointer-events: none;
    color: #FFFFFF;
  }

  /* 內嵌 TOC（米色框、置於引言後） */
  .post-toc-inline {
    background: #FAF7F2;
    border: 1px solid #E8DCC8;
    border-radius: 8px;
    padding: 24px 28px;
    margin: 32px 0 40px;
  }

  .post-toc-title {
    text-align: center;
    font-weight: 700;
    color: #1A1A1A;
    margin-bottom: 16px;
    padding-bottom: 12px;
    border-bottom: 1px solid #E8DCC8;
    font-size: 1.2rem;
    letter-spacing: 0.05em;
  }

  .post-toc-inline ol {
    list-style: none;
    padding: 0;
    margin: 0;
    counter-reset: toc-item;
  }

  .post-toc-inline ol li {
    counter-increment: toc-item;
    margin: 10px 0;
    padding-left: 0;
  }

  .post-toc-inline ol li a {
    color: #1A1A1A !important;
    font-size: 0.95rem;
    line-height: 1.6;
    display: inline-block;
  }

  .post-toc-inline ol li a::before {
    content: counter(toc-item) ". ";
    color: #B8977E;
    font-weight: 600;
    margin-right: 4px;
  }

  .post-toc-inline ol li a:hover {
    color: #D4886A !important;
    text-decoration: underline;
  }

  .post-toc-inline ol li a.toc-active {
    color: #D4886A !important;
    font-weight: 600;
  }

  /* 浮動 TOC（桌面右側 sticky） */
  .post-toc-floating {
    display: none;  /* 預設隱藏，桌面 1280+ 才顯示 */
    position: fixed;
    top: 96px;
    right: 32px;
    width: 240px;
    max-height: calc(100vh - 140px);
    overflow-y: auto;
    background: #FFFFFF;
    border: 1px solid #E8DCC8;
    border-radius: 8px;
    padding: 16px 18px;
    z-index: 10;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  }

  .post-toc-floating .post-toc-title {
    background: #FAF7F2;
    margin: -16px -18px 12px;
    padding: 12px 18px;
    border-radius: 8px 8px 0 0;
    border-bottom: 1px solid #E8DCC8;
    font-size: 1rem;
  }

  .post-toc-floating ol {
    list-style: none;
    padding: 0;
    margin: 0;
    counter-reset: toc-float;
  }

  .post-toc-floating ol li {
    counter-increment: toc-float;
    margin: 8px 0;
  }

  .post-toc-floating ol li a {
    color: #555 !important;
    font-size: 0.85rem;
    line-height: 1.55;
    display: block;
    padding: 4px 0 4px 12px;
    border-left: 2px solid transparent;
    transition: color 0.15s, border-color 0.15s;
  }

  .post-toc-floating ol li a::before {
    content: counter(toc-float) ". ";
    color: #B8977E;
    margin-right: 2px;
  }

  .post-toc-floating ol li a:hover {
    color: #B8977E !important;
    text-decoration: none !important;
  }

  .post-toc-floating ol li a.toc-active {
    color: #D4886A !important;
    border-left-color: #D4886A;
    font-weight: 600;
  }

  @media (min-width: 1280px) {
    .post-toc-floating {
      display: block;
    }
  }

  /* 文章底部 footer — 3 欄式（品牌 / 站內導覽 / 公司資訊） */
  .post-footer {
    border-top: 1px solid #EAEAEA;
    background: #FAFAFA;
    margin-top: 64px;
  }

  .post-footer-inner {
    max-width: 1180px;
    margin: 0 auto;
    padding: 48px 24px 28px;
  }

  .post-footer-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr 1.6fr;
    gap: 48px;
    padding-bottom: 28px;
    border-bottom: 1px solid #EAEAEA;
    margin-bottom: 20px;
  }

  .post-footer-col {
    min-width: 0;
  }

  .post-footer-coltitle {
    font-size: 0.78rem;
    font-weight: 700;
    color: #1A1A1A;
    letter-spacing: 0.12em;
    margin-bottom: 16px;
    text-transform: uppercase;
  }

  .post-footer-name {
    font-size: 1.05rem;
    font-weight: 700;
    color: #1A1A1A;
    margin-bottom: 6px;
  }

  .post-footer-slogan {
    font-size: 0.875rem;
    color: #666;
    line-height: 1.6;
  }

  .post-footer-nav {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .post-footer-nav a {
    font-size: 0.875rem;
    color: #555 !important;
    text-decoration: none;
  }

  .post-footer-nav a:hover {
    color: #B8977E !important;
  }

  .post-footer-nav a.disabled {
    color: #AAA !important;
    cursor: not-allowed;
    pointer-events: none;
  }

  .post-footer-info {
    margin: 0;
  }

  .post-footer-info > div {
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: 12px;
    padding: 6px 0;
    font-size: 0.82rem;
    line-height: 1.65;
  }

  .post-footer-info dt {
    color: #888;
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  .post-footer-info dd {
    margin: 0;
    color: #333;
  }

  .post-footer-copy {
    font-size: 0.78rem;
    color: #888;
  }

  @media (max-width: 720px) {
    .post-footer-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .post-footer-info > div {
      grid-template-columns: 90px 1fr;
    }
  }

  /* 手機版微調 */
  @media (max-width: 600px) {
    .post-main {
      padding: 32px 20px 64px;
    }

    .post-content {
      font-size: 1rem;
    }

    .post-content table {
      font-size: 0.875em;
    }

    /* 表格手機版：每列拆成一張卡片，第一欄當標題、其餘欄名當小標 */
    .post-content table.rwd-table thead {
      display: none;
    }
    .post-content table.rwd-table,
    .post-content table.rwd-table tbody,
    .post-content table.rwd-table tr,
    .post-content table.rwd-table td {
      display: block;
      width: 100%;
    }
    .post-content table.rwd-table {
      margin: 20px 0;
    }
    .post-content table.rwd-table tr {
      margin: 0 0 16px;
      border: 1px solid #E5E5E5;
      border-radius: 8px;
      overflow: hidden;
      background: #FFFFFF;
    }
    .post-content table.rwd-table tr:nth-child(even) td {
      background: transparent;
    }
    .post-content table.rwd-table td {
      border: none;
      border-bottom: 1px solid #EEEAE3;
      padding: 10px 14px;
    }
    .post-content table.rwd-table td:last-child {
      border-bottom: none;
    }
    .post-content table.rwd-table td::before {
      content: attr(data-label);
      display: block;
      font-weight: 700;
      font-size: 0.95em;
      color: #A8825F;
      margin-bottom: 4px;
    }
    .post-content table.rwd-table td:first-child {
      background: #F8F5F1;
      font-weight: 700;
      font-size: 1.02em;
    }
    .post-content table.rwd-table td:first-child::before {
      display: none;
    }
    .post-content table.rwd-table td:empty {
      display: none;
    }
  }
</style>

<script>
  // 1) 把內嵌 TOC 從引言後移到第一個 H2 前
  // 2) IntersectionObserver 處理滾動 highlight（內嵌 + 浮動 TOC 同步）
  function initToc() {
    const inlineToc = document.querySelector('[data-toc-inline]');
    const content = document.querySelector('.post-content');
    if (!inlineToc || !content) return;

    const firstH2 = content.querySelector('h2');
    if (firstH2 && firstH2.parentNode) {
      firstH2.parentNode.insertBefore(inlineToc, firstH2);
    }

    const headings = content.querySelectorAll('h2');
    const tocLinks = document.querySelectorAll('[data-toc-link]');
    if (headings.length === 0 || tocLinks.length === 0) return;

    const setActive = (slug: string) => {
      tocLinks.forEach((link) => {
        const isActive = link.getAttribute('data-toc-link') === slug;
        link.classList.toggle('toc-active', isActive);
      });
    };

    const observer = new IntersectionObserver(
      (entries) => {
        // 找出最靠近頂部、且仍在視窗內的 heading
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => a.target.getBoundingClientRect().top - b.target.getBoundingClientRect().top);
        if (visible.length > 0) {
          const id = visible[0].target.id;
          if (id) setActive(id);
        }
      },
      {
        rootMargin: '-80px 0px -65% 0px',
        threshold: 0,
      }
    );

    headings.forEach((h) => {
      if (h.id) observer.observe(h);
    });

    // 初始化 — 預設 active 第一個
    if (headings[0]?.id) setActive(headings[0].id);
  }

  // 閱讀進度條 — scroll-linked，動畫平滑
  function initProgressBar() {
    const bar = document.getElementById('post-progress');
    if (!bar) return;

    let ticking = false;
    const update = () => {
      const scrollTop = window.scrollY;
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      const progress = docHeight > 0 ? Math.min(100, (scrollTop / docHeight) * 100) : 0;
      bar.style.width = `${progress}%`;
      ticking = false;
    };

    const onScroll = () => {
      if (!ticking) {
        window.requestAnimationFrame(update);
        ticking = true;
      }
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    update();
  }

  // 表格手機版 RWD — 每個 td 標上欄名（給 CSS ::before 用），加 rwd-table class
  function initResponsiveTables() {
    const tables = document.querySelectorAll('.post-content table');
    tables.forEach((table) => {
      const headers = Array.from(table.querySelectorAll('thead th')).map((th) => th.textContent.trim());
      if (headers.length === 0) return;
      table.querySelectorAll('tbody tr').forEach((tr) => {
        tr.querySelectorAll('td').forEach((td, i) => {
          if (headers[i]) td.setAttribute('data-label', headers[i]);
        });
      });
      table.classList.add('rwd-table');
    });
  }

  // Astro 5 view transitions 友善
  document.addEventListener('DOMContentLoaded', () => {
    initToc();
    initProgressBar();
    initResponsiveTables();
  });
  document.addEventListener('astro:page-load', () => {
    initToc();
    initProgressBar();
    initResponsiveTables();
  });
</script>
