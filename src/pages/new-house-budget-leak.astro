---
/*
 * D002 — 新成屋裝修預算漏算
 * URL slug = new-house-budget-leak
 */
import { getCollection } from 'astro:content';
import PostLayout from '../layouts/PostLayout.astro';

export const prerender = true;

const posts = await getCollection('posts');
const post = posts.find((p) => p.data.id === 'D002');
if (!post) throw new Error('Post D002 not found in collection');

const { Content, headings } = await post.render();
const tocHeadings = headings.filter((h) => h.depth === 2);
---

<PostLayout
  title={post.data.title}
  description={post.data.description}
  publishDate={post.data.publishDate}
  updateDate={post.data.updateDate}
  dim={post.data.dim}
  tags={post.data.tags}
  heroImage={post.data.heroImage}
  heroAlt={post.data.heroAlt}
  headings={tocHeadings}
>
  <Content />
</PostLayout>
