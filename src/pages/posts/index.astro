---
import { getCollection, type CollectionEntry } from 'astro:content';
import '../../styles/global.css';

// dev 看 draft、prod 過濾
const filter = import.meta.env.DEV
  ? undefined
  : ({ data }: CollectionEntry<'posts'>) => !data.draft;

const posts = await getCollection('posts', filter);

// 依發佈日新→舊
const sorted = posts.sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);

const fmt = (d: Date) =>
  d.toLocaleDateString('zh-TW', { year: 'numeric', month: 'long', day: 'numeric' });
---

<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="generator" content={Astro.generator} />
  <title>所有文章｜懂屋 Know Your Home</title>
  <meta name="description" content="懂屋整理的所有裝修知識文章，依時間排序，隨時可查。" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body class="post-body">
  <header class="post-topbar">
    <div class="post-topbar-inner">
      <a href="/" class="post-brand">
        <img src="/images/logo-dongwu-white.png" alt="" class="post-brand-logo" width="32" height="32" />
        <span class="brand-full">懂屋 · Know Your Home</span>
        <span class="brand-short">懂屋</span>
      </a>
      <nav class="post-nav post-nav-desktop" aria-label="主導覽">
        <a href="/about/" class="post-nav-link">關於懂屋</a>
        <a href="/posts/" class="post-nav-link" aria-current="page">所有文章</a>
        <a href="/ai-diagnosis/" class="post-nav-cta post-nav-cta-primary">免費裝修診斷</a>
        <a href="/subscribe/" class="post-nav-cta">訂閱電子報</a>
      </nav>
      <div class="post-nav-mobile">
        <a href="/ai-diagnosis/" class="post-nav-cta post-nav-cta-mobile post-nav-cta-primary">免費裝修診斷</a>
        <a href="/subscribe/" class="post-nav-cta post-nav-cta-mobile">訂閱電子報</a>
        <details class="post-menu">
          <summary class="post-menu-toggle" aria-label="開啟選單">
            <span class="post-menu-bars" aria-hidden="true"></span>
          </summary>
          <nav class="post-menu-panel" aria-label="次要導覽">
            <a href="/about/" class="post-menu-link">關於懂屋</a>
            <a href="/posts/" class="post-menu-link" aria-current="page">所有文章</a>
          </nav>
        </details>
      </div>
    </div>
  </header>

  <main class="list-main">
    <div class="list-inner">
      <header class="list-header">
        <h1 class="list-title">所有文章</h1>
        <p class="list-sub">依發佈日新到舊</p>
      </header>

      <div class="post-grid">
        {sorted.map((post) => (
          <a href={post.data.urlSlug ? `/${post.data.urlSlug}/` : `/posts/${post.data.id}/`} class="post-card">
            <div class="post-card-cover">
              {post.data.heroImage ? (
                <img src={post.data.heroImage} alt={post.data.heroAlt || post.data.title} loading="lazy" />
              ) : (
                <div class="post-card-cover-fallback">
                  <span>{post.data.dim}</span>
                </div>
              )}
            </div>

            <div class="post-card-body">
              <p class="post-card-dim">{post.data.dim}</p>
              <h2 class="post-card-title">{post.data.title}</h2>
              {post.data.tags && post.data.tags.length > 0 && (
                <p class="post-card-tags">
                  {post.data.tags.map((tag) => <span class="post-card-tag">#{tag}</span>)}
                </p>
              )}
              <div class="post-card-foot">
                <time class="post-card-date" datetime={post.data.publishDate.toISOString()}>
                  {fmt(post.data.publishDate)}
                </time>
                <span class="post-card-more">繼續閱讀 →</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </main>

  <footer class="post-footer">
    <div class="post-footer-inner">
      <div class="post-footer-brand">
        <p class="post-footer-name">懂屋 Know Your Home</p>
        <p class="post-footer-slogan">新成屋屋主的裝修決策系統</p>
      </div>

      <nav class="post-footer-nav">
        <a href="/ai-diagnosis/">免費裝修診斷</a>
        <a href="https://minxindesign.com.tw" target="_blank" rel="noopener">設計師工作室</a>
        <a href="/subscribe/">訂閱電子報</a>
      </nav>

      <p class="post-footer-copy">© 2026 懂屋 Know Your Home · 旻欣室內裝修設計工作室</p>
    </div>
  </footer>
</body>
</html>

<style is:global>
  /* 列表頁專用：複用文章頁的白底配色 */
  body.post-body {
    background: #FFFFFF;
    color: #1A1A1A;
  }

  body.post-body a {
    color: #B8977E;
    text-decoration: none;
  }

  body.post-body a:hover {
    color: #D4886A;
  }

  /* topbar 樣式（與 PostLayout 同步 — 深海黑鯨金品牌色） */
  .post-topbar {
    border-bottom: 1px solid rgba(184, 151, 126, 0.22);
    background: #1C1815;
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .post-topbar-inner {
    max-width: 1180px;
    margin: 0 auto;
    padding: 16px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    position: relative;
  }

  .post-brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 0.9rem;
    letter-spacing: 0.18em;
    color: #F5F0E8 !important;
    font-weight: 700;
    flex-shrink: 0;
  }

  .post-brand:hover {
    color: #B8977E !important;
  }

  .post-brand-logo {
    height: 32px;
    width: 32px;
    display: block;
    flex-shrink: 0;
  }

  .post-brand .brand-short {
    display: none;
  }

  .post-nav-mobile {
    display: none;
  }

  .post-nav {
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .post-nav-link {
    font-size: 0.9rem;
    color: #F5F0E8 !important;
    letter-spacing: 0.06em;
    font-weight: 600;
    transition: color 0.18s ease;
  }

  .post-nav-link:hover {
    color: #B8977E !important;
  }

  .post-nav-link[aria-current="page"] {
    color: #B8977E !important;
    font-weight: 700;
  }

  .post-nav-cta {
    display: inline-flex;
    align-items: center;
    padding: 9px 22px;
    border: 1px solid rgba(184, 151, 126, 0.55);
    border-radius: 999px;
    font-size: 0.85rem;
    color: #F5F0E8 !important;
    letter-spacing: 0.06em;
    font-weight: 600;
    background: transparent;
    text-decoration: none;
    transition: background 0.18s ease, color 0.18s ease, border-color 0.18s ease;
  }

  .post-nav-cta:hover {
    background: #B8977E;
    border-color: #B8977E;
    color: #1C1815 !important;
  }

  /* 主按鈕：實心金，比訂閱（外框）更突出 */
  .post-nav-cta-primary {
    background: #B8977E;
    border-color: #B8977E;
    color: #1C1815 !important;
  }

  .post-nav-cta-primary:hover {
    background: #C9A98E;
    border-color: #C9A98E;
    color: #1C1815 !important;
  }

  @media (max-width: 720px) {
    .post-topbar-inner {
      padding: 12px 16px;
      gap: 10px;
    }
    .post-brand {
      font-size: 1.25rem;
      letter-spacing: 0.06em;
      gap: 10px;
    }
    .post-brand-logo {
      height: 36px;
      width: 36px;
    }
    .post-brand .brand-full {
      display: none;
    }
    .post-brand .brand-short {
      display: inline;
    }
    .post-nav-desktop {
      display: none;
    }
    .post-nav-mobile {
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }
    /* 兩顆 pill 並列：免費裝修診斷（實心）+ 訂閱電子報（外框），縮小以容納漢堡 */
    .post-nav-cta-mobile {
      padding: 6px 10px;
      font-size: 0.72rem;
      letter-spacing: 0;
    }
    .post-menu {
      position: relative;
    }
    .post-menu-toggle {
      list-style: none;
      cursor: pointer;
      width: 36px;
      height: 36px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 8px;
      border: 1px solid rgba(184, 151, 126, 0.32);
    }
    .post-menu-toggle::-webkit-details-marker {
      display: none;
    }
    .post-menu-bars,
    .post-menu-bars::before,
    .post-menu-bars::after {
      display: block;
      width: 18px;
      height: 2px;
      background: #F5F0E8;
      border-radius: 2px;
    }
    .post-menu-bars {
      position: relative;
    }
    .post-menu-bars::before,
    .post-menu-bars::after {
      content: "";
      position: absolute;
      left: 0;
    }
    .post-menu-bars::before {
      top: -6px;
    }
    .post-menu-bars::after {
      top: 6px;
    }
    .post-menu-bars,
    .post-menu-bars::before,
    .post-menu-bars::after {
      transition: transform 0.2s ease, top 0.2s ease, background 0.2s ease;
    }
    /* 開啟時漢堡變 X（雷蒙風） */
    .post-menu[open] .post-menu-bars {
      background: transparent;
    }
    .post-menu[open] .post-menu-bars::before {
      top: 0;
      transform: rotate(45deg);
    }
    .post-menu[open] .post-menu-bars::after {
      top: 0;
      transform: rotate(-45deg);
    }
    /* 全寬下拉面板 — 大列好點，手機友善 */
    .post-menu[open] .post-menu-panel {
      position: fixed;
      top: 57px;
      left: 0;
      right: 0;
      background: #1C1815;
      border-top: 1px solid rgba(184, 151, 126, 0.28);
      padding: 4px 0 8px;
      display: flex;
      flex-direction: column;
      box-shadow: 0 14px 30px rgba(0, 0, 0, 0.5);
      z-index: 60;
    }
    .post-menu-link {
      display: block;
      padding: 16px 24px;
      color: #F5F0E8 !important;
      font-size: 1rem;
      letter-spacing: 0.04em;
      font-weight: 600;
      text-decoration: none;
      border-bottom: 1px solid rgba(184, 151, 126, 0.12);
    }
    .post-menu-link[aria-current="page"] {
      color: #B8977E !important;
    }
    .post-menu-link:active,
    .post-menu-link:hover {
      color: #B8977E !important;
      background: rgba(184, 151, 126, 0.08);
    }
  }

  /* 列表主容器 */
  .list-main {
    background: #FFFFFF;
    min-height: calc(100vh - 200px);
    padding: 56px 24px 96px;
  }

  .list-inner {
    max-width: 1180px;
    margin: 0 auto;
  }

  .list-header {
    margin-bottom: 48px;
  }

  .list-title {
    font-size: clamp(2rem, 4vw, 2.8rem);
    font-weight: 700;
    color: #1A1A1A;
    letter-spacing: -0.01em;
    margin-bottom: 8px;
  }

  .list-sub {
    color: #888;
    font-size: 0.95rem;
  }

  /* 文章卡片 grid */
  .post-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 36px;
  }

  @media (min-width: 720px) {
    .post-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 28px 24px;
    }
  }

  @media (min-width: 1080px) {
    .post-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .post-card {
    display: flex;
    flex-direction: column;
    background: #FFFFFF;
    color: #1A1A1A !important;
    overflow: hidden;
    transition: transform 0.18s ease;
  }

  .post-card:hover {
    text-decoration: none !important;
    transform: translateY(-4px);
  }

  .post-card:hover .post-card-cover img {
    transform: scale(1.04);
  }

  .post-card:hover .post-card-title {
    color: #D4886A;
  }

  .post-card:hover .post-card-more {
    color: #D4886A;
  }

  /* 卡片首圖（比例對齊 OG 標準 1200×630） */
  .post-card-cover {
    position: relative;
    aspect-ratio: 1200 / 630;
    border-radius: 12px;
    overflow: hidden;
    background: #FAF7F2;
    margin-bottom: 18px;
  }

  .post-card-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .post-card-cover-fallback {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #FAF7F2 0%, #E8DCC8 100%);
    color: #B8977E;
    font-weight: 600;
    letter-spacing: 0.1em;
  }

  /* 標題下方 #tag 文字行 */
  .post-card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 0;
  }

  .post-card-tag {
    font-size: 0.8rem;
    color: #999;
    letter-spacing: 0.02em;
  }

  /* 卡片內文 */
  .post-card-body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 0 4px;
  }

  .post-card-dim {
    font-size: 0.8rem;
    color: #B8977E;
    letter-spacing: 0.08em;
    font-weight: 600;
  }

  .post-card-title {
    font-size: 1.4rem;
    font-weight: 700;
    color: #1A1A1A;
    line-height: 1.55;
    letter-spacing: -0.005em;
    margin: 0;
    transition: color 0.18s ease;
  }

  .post-card-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 6px;
    padding-top: 12px;
    border-top: 1px solid #F0F0F0;
  }

  .post-card-date {
    font-size: 0.825rem;
    color: #888;
  }

  .post-card-more {
    font-size: 0.825rem;
    color: #B8977E;
    font-weight: 600;
    transition: color 0.18s ease;
  }

  /* footer 與 PostLayout 同步 */
  .post-footer {
    border-top: 1px solid #EAEAEA;
    background: #FAFAFA;
  }

  .post-footer-inner {
    max-width: 1180px;
    margin: 0 auto;
    padding: 40px 24px 32px;
  }

  .post-footer-brand {
    margin-bottom: 24px;
  }

  .post-footer-name {
    font-size: 1rem;
    font-weight: 700;
    color: #1A1A1A;
    margin-bottom: 4px;
  }

  .post-footer-slogan {
    font-size: 0.875rem;
    color: #666;
  }

  .post-footer-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    margin-bottom: 24px;
    padding-bottom: 24px;
    border-bottom: 1px solid #EAEAEA;
  }

  .post-footer-nav a {
    font-size: 0.875rem;
    color: #555 !important;
  }

  .post-footer-nav a:hover {
    color: #B8977E !important;
  }

  .post-footer-nav a.disabled {
    color: #AAA !important;
    cursor: not-allowed;
    pointer-events: none;
  }

  .post-footer-copy {
    font-size: 0.8rem;
    color: #888;
  }

  @media (max-width: 600px) {
    .list-main {
      padding: 36px 20px 64px;
    }

    .post-card-title {
      font-size: 1.2rem;
    }
  }
</style>
