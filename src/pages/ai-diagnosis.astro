      <div class="style-result-body">
        <div class="style-result-row"><span class="style-result-label">色調</span><span class="style-result-value">${styleInfo.palette}</span></div>
        <div class="style-result-row"><span class="style-result-label">關鍵材質</span><span class="style-result-value">${styleInfo.materials}</span></div>
        <div class="style-result-row"><span class="style-result-label">材質建議</span><span class="style-result-value">${styleInfo.matAdvice}</span></div>
        ${cleaning === 'B' ? '<div class="style-result-warn">不愛打掃建議避開：深色人字拼木地板、開放層板、白色烤漆廚具</div>' : ''}
