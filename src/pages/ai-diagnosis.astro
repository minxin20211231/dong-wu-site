const renderLabels = ['客廳視角','臥室視角','廚房視角'];
const sty = answers.style || 'A';

function fakeGenerate(slot) {
  const el = document.getElementById('render-' + slot);
  if (!el || !el.classList.contains('render-empty')) return;

  // Show generating state
  el.classList.remove('render-empty');
  el.onclick = null;
  el.innerHTML = `
    <div class="render-generating">
      <div style="width:32px;height:32px;border:2px solid var(--border);border-top-color:var(--accent);border-radius:50%;animation:spin 1s linear infinite;margin:0 auto 10px"></div>
      <div style="font-size:14px;font-weight:600;color:var(--text)">AI 正在渲染${renderLabels[slot-1]}⋯</div>
      <div style="font-size:12px;color:var(--muted);margin-top:4px">大約 3 秒</div>
    </div>
  `;

  // Fake delay then show image
  setTimeout(() => {
    const styleKey = answers.style || 'A';
    const imgs = renderImgs[styleKey] || renderImgs.A;
    const styleNames = { A:'北歐風', B:'日式 MUJI', C:'工業風', D:'奶油風', E:'輕鄉村', F:'現代簡約', G:'法式輕奢', H:'侘寂風' };
    const stylePalettes = { A:'白色＋木色＋淺灰', B:'白色＋原木色＋米色', C:'黑色＋深灰＋白色', D:'奶茶米色＋暖白', E:'白色＋薄荷綠＋粉藕', F:'白色＋淺灰＋黑線條', G:'白色＋金色＋米色', H:'灰泥色＋大地色＋焦茶' };

    el.innerHTML = `
      <div class="render-img-wrap">
        <img src="${imgs[slot-1]}" alt="AI 渲染 #${slot}" style="width:100%;height:220px;object-fit:cover;display:block;border-radius:16px"
          onerror="this.style.background='linear-gradient(135deg,rgba(184,151,126,0.2),rgba(212,136,106,0.15))';this.style.height='220px'">
        <div class="render-overlay">
          <div class="render-badge">${slot} / 3 免費</div>
          <div class="render-caption">${styleNames[styleKey]} · ${renderLabels[slot-1]}</div>
        </div>
      </div>
      <div class="render-meta">
        <div class="render-meta-left">
          <span style="color:var(--accent);font-weight:600">${styleNames[styleKey]}</span>
          <span style="color:var(--muted)">·</span>
          <span style="color:var(--muted)">${stylePalettes[styleKey]}</span>
        </div>
        <div class="render-meta-right">
          <span style="font-size:11px;color:var(--muted);display:inline-flex;align-items:center;gap:4px"><svg class="icon"><use href="#i-clock"/></svg>3 分鐘</span>
        </div>
      </div>
    `;
    el.style.animation = 'fadeIn 0.5s ease';

    // Update counter
    renderUsed++;
    updateRenderCounter();

    // If all 3 used, show upsell
    if (renderUsed >= 3) {
      setTimeout(() => {
        document.getElementById('render-upsell').style.display = 'block';
        document.getElementById('render-upsell').style.animation = 'fadeIn 0.5s ease';
      }, 500);
    }
  }, 2500);
}

function updateRenderCounter() {
  const dots = document.querySelectorAll('.rdot');
  dots.forEach((d, i) => {
    if (i < renderUsed) d.classList.add('used');
    else d.classList.remove('used');
  });
  const text = document.getElementById('render-count-text');
  if (text) text.textContent = `已用 ${renderUsed} / 3`;
  if (renderUsed >= 3 && text) {
    text.textContent = '免費額度已用完';
    text.style.color = 'var(--accent2)';
  }
}

// Go to generator with diagnostic data
function goToGenerator() {
  const params = new URLSearchParams({
    style: answers.style || 'A',
    color: 'warm',
    sqm: answers.sqm || '',
    from: 'diagnostic'
  });
  // Try relative path, fallback to encoded
  try {
    window.location.href = encodeURI('懂屋_風格圖生成器_v4.html') + '?' + params.toString();
  } catch(e) {
    window.open('懂屋_風格圖生成器_v4.html?' + params.toString(), '_blank');
  }
}

function animateBudgetBars() {
  document.querySelectorAll('.budget-bar').forEach(bar => {
    const pct = parseFloat(bar.getAttribute('data-pct')) || 0;
    bar.style.width = pct + '%';
  });
}

function initScrollAnimations() {
  const els = document.querySelectorAll('.anim-in');
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) { e.target.classList.add('visible'); observer.unobserve(e.target); }
    });
  }, { threshold: 0.1 });
  els.forEach((el, i) => {
    el.style.transitionDelay = (i * 0.07) + 's';
    observer.observe(el);
  });
}

// ══════════ SHARE / DOWNLOAD / PRINT ══════════
function printReport() {
  window.print();
}

function shareLine() {
  const text = encodeURIComponent('我剛用「懂屋」做了裝修診斷，超有用！免費的 → ');
  const url = encodeURIComponent(window.location.href.split('?')[0]);
  window.open('https://social-plugins.line.me/lineit/share?url=' + url + '&text=' + text, '_blank');
}

function copyLink() {
  const url = window.location.href.split('?')[0];
  if (navigator.clipboard) {
    navigator.clipboard.writeText(url).then(() => showToast('已複製連結！'));
  } else {
    const ta = document.createElement('textarea');
    ta.value = url; document.body.appendChild(ta); ta.select();
    document.execCommand('copy'); document.body.removeChild(ta);
    showToast('已複製連結！');
  }
}

function showToast(msg) {
  let t = document.getElementById('toast-el');
  if (!t) {
    t = document.createElement('div');
    t.id = 'toast-el'; t.className = 'toast';
    document.body.appendChild(t);
  }
  t.textContent = msg;
  t.classList.add('show');
  setTimeout(() => t.classList.remove('show'), 2500);
}

// ══════════ LEAD CAPTURE ══════════
function submitLead() {
  const email = document.getElementById('lead-email').value.trim();
  if (!email) {
    showToast('請填寫 Email');
    return;
  }
  if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
    showToast('請輸入正確的 Email 格式');
    return;
  }

  const leadData = {
    email,
    personality: answers.fear || '',
    budget: answers.budget || '',
    sqm: answers.sqm || 0,
    style: answers.style || '',
    timestamp: new Date().toISOString()
  };

  try { localStorage.setItem('dongwu_lead', JSON.stringify(leadData)); } catch(e) {}

  // TODO: Replace with actual webhook/API call:
  // fetch('YOUR_WEBHOOK_URL', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(leadData) });

  document.getElementById('lead-form').style.display = 'none';
  document.getElementById('lead-success').style.display = 'block';
  showToast('已寄出！去信箱看看吧 ');
}

// ══════════ RESTART ══════════
function restartQuiz() {
  // 重填問卷 — 清資料 + 直接跳第一題（不回 landing）
  clearLocal();
  Object.keys(answers).forEach(k => delete answers[k]);
  Object.keys(checkedSets).forEach(k => delete checkedSets[k]);
  Object.keys(phaseAnswered).forEach(k => delete phaseAnswered[k]);
  document.getElementById('results').style.display = 'none';
  document.getElementById('landing').style.display = 'none';
  document.getElementById('quiz-container').style.display = 'block';
  document.getElementById('progress-bar').style.width = '0%';
  _toggleSiteHeader(false);
  buildQuiz();
  currentPhase = 0;
  showPhase(0);
  window.scrollTo(0, 0);
}

function goHome() {
  // 回首頁 — 清資料 + 跳 landing
  clearLocal();
  Object.keys(answers).forEach(k => delete answers[k]);
  Object.keys(checkedSets).forEach(k => delete checkedSets[k]);
  Object.keys(phaseAnswered).forEach(k => delete phaseAnswered[k]);
  document.getElementById('results').style.display = 'none';
  document.getElementById('quiz-container').style.display = 'none';
  document.getElementById('landing').style.display = 'flex';
  document.getElementById('progress-bar').style.width = '0%';
  _toggleSiteHeader(true);
  window.scrollTo(0, 0);
}

// Init landing animations
window.addEventListener('load', () => {
  const landingEls = document.querySelectorAll('#landing .value-card');
  const obs = new IntersectionObserver((entries) => {
    entries.forEach(e => { if (e.isIntersecting) e.target.style.opacity = '1'; });
  }, { threshold: 0.1 });
  landingEls.forEach(el => { el.style.opacity = '0'; el.style.transition = 'opacity 0.5s ease'; obs.observe(el); });
  setTimeout(() => landingEls.forEach(el => el.style.opacity = '1'), 300);

  // Hero 標題字元 stagger
  const h1 = document.querySelector('.landing-title');
  if (h1) {
    const html = h1.innerHTML;
    const parts = html.split(/<br\s*\/?>/i);
    let ci = 0;
    h1.innerHTML = parts.map((seg, pi) => {
      const chars = [...seg].map(c => {
        if (c === ' ') return '<span class="ch" style="width:.4em">&nbsp;</span>';
        const delay = (ci++ * 55 + 350);
        return `<span class="ch" style="animation-delay:${delay}ms">${c}</span>`;
      }).join('');
      return chars + (pi < parts.length - 1 ? '<span class="ch br"></span>' : '');
    }).join('');
  }
});
</script>

