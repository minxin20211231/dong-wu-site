}

function generateResults() {
  const sqm = answers.sqm || 0;
  const budget = answers.budget || 'B';
  const fear = answers.fear || 'A';
  const style = answers.style || 'A';
  const family = answers.family || [];
  const wfh = answers.wfh || 'A';
  const kitchenArr = Array.isArray(answers.kitchen) ? answers.kitchen : (answers.kitchen ? [answers.kitchen] : ['A']);
  const kitchenHas = (v) => kitchenArr.includes(v);
  const kitchen = kitchenArr[0] || 'A';
  const appliance = answers.appliances || 'A';
  const cleaning = answers.cleaning || 'A';
  const timeline = answers.timeline || 'B';
  const layout = answers.layout || 'A';
  const sprinkler = answers.sprinkler || 'C';
  const clothes = answers.clothes || 'A';
  const shoes = answers.shoes || 'A';
  const bigstuff = answers.bigstuff || 'A';
  const people = answers.people || '2';

  // 屋主類型分流
  const archetype = calculateArchetype(answers);
  const archetypeCardHtml = renderArchetypeCard(archetype);

  // Personality
  const personality = getPersonality(budget, fear);

  // Budget numbers (3 級制：標準/精緻/客製)
  // 每坪單價區間（與 Part 2 選項一致）：標準 5–7、精緻 7–8、客製 8–9 萬/坪
  // 頭條預算＝實際坪數 × 每坪單價，並守 80 萬承接下限；沒填坪數時回退 30 坪估值
  const perSqmRange = { A: [5,7], B: [7,8], C: [8,9] };
  const budgetTierLabel = { A:'標準', B:'精緻', C:'客製' }[budget] || '標準';
  const [pLow, pHigh] = perSqmRange[budget] || [5,7];
  const baseSqm = sqm > 0 ? sqm : 30;
  const bLow = Math.max(Math.round(baseSqm * pLow), 80);
  const bHigh = Math.max(Math.round(baseSqm * pHigh), 80);
  const midB = Math.round(baseSqm * (pLow + pHigh) / 2);

  // Timeline weeks
  const tlMap = { A: '4–6 週', B: '8–12 週', C: '16–24 週' };
  const tlLabel = tlMap[timeline] || '8–12 週';

  // Style（8 風格，含建議最低預算等級）
  const styleMap = {
    A: { name:'北歐風', minBudget:'A', minLabel:'標準型', materials:'橡木貼皮、白色文化石、亞麻布沙發、超耐磨木地板', palette:'白色＋木色＋淺灰', img:'/ai-diagnosis/styles/01_北歐風.png', emoji:'北', matAdvice:'重點放在木紋地板與白牆，燈具選暖白 3000K 以下，沙發選天然亞麻布。系統櫃＋木作貼皮即可到位。' },
    B: { name:'日式 MUJI', minBudget:'A', minLabel:'標準型', materials:'淺木色系統櫃、白橡木地板、棉麻窗簾、無印收納', palette:'白色＋原木色＋米色', img:'/ai-diagnosis/styles/02_日式MUJI.png', emoji:'日', matAdvice:'留白是關鍵——牆面大面積留白，家具選低矮款，收納全部藏起來。燈光選暖白 3000K，軟裝選棉麻材質。' },
    C: { name:'工業風', minBudget:'A', minLabel:'標準型', materials:'黑色鐵件、水泥板、深色木紋、清水模漆', palette:'黑色＋深灰＋白色', img:'/ai-diagnosis/styles/03_工業風.png', emoji:'工', matAdvice:'天花板局部保留管線外露可省 5-15 萬，用黑色鐵件燈具呼應，牆面以清水模漆替代真清水模省 60%。' },
    D: { name:'奶油風', minBudget:'B', minLabel:'精緻型', materials:'奶油色牆漆、木質線板、布藝床頭、拱形門洞', palette:'奶茶米色＋暖白＋淺棕', img:'/ai-diagnosis/styles/04_奶油風.png', emoji:'奶', matAdvice:'色調一致性最關鍵，牆漆選 2-3 個同色系，門框與踢腳板統一白色，軟裝選奶茶米系列。造型工序多，建議精緻型以上。' },
    E: { name:'輕鄉村', minBudget:'B', minLabel:'精緻型', materials:'白色線板、復古把手、花磚點綴、百葉窗簾、木百葉門', palette:'白色＋薄荷綠＋奶油黃＋粉藕', img:'/ai-diagnosis/styles/05_輕鄉村.png', emoji:'村', matAdvice:'線板和門片造型是靈魂，建議集中在客廳主牆和廚房門片。花磚用在玄關或浴室局部點綴，不要大面積。' },
    F: { name:'現代簡約', minBudget:'B', minLabel:'精緻型', materials:'無把手門片、隱藏式收納、石紋磁磚、嵌入式燈具', palette:'白色＋淺灰＋黑色線條', img:'/ai-diagnosis/styles/06_現代簡約.png', emoji:'簡', matAdvice:'無把手設計需要按壓五金，成本比一般把手高但質感差距大。隱藏收納和嵌燈讓空間更乾淨，細節工序多建議精緻型以上。' },
    G: { name:'法式輕奢', minBudget:'C', minLabel:'客製型', materials:'大理石紋磚、鍍鈦金屬把手、絨布沙發、高光烤漆', palette:'白色＋金色＋米色', img:'/ai-diagnosis/styles/07_法式輕奢.png', emoji:'奢', matAdvice:'重點投資在玄關或電視牆的大理石紋磚，五金把手全室統一鍍鈦金，其他區域可用仿石材磁磚。材料單價高，建議客製型。' },
    H: { name:'侘寂風', minBudget:'C', minLabel:'客製型', materials:'微水泥塗料、特殊質感漆、手作陶盆、原木粗獷家具、亞麻布藝', palette:'灰泥色＋大地色＋焦茶', img:'/ai-diagnosis/styles/08_侘寂風.png', emoji:'寂', matAdvice:'微水泥和特殊塗料需要專業師傅施工，工資高但用量少。家具選原木手作款，不完美就是美。全訂製路線，建議客製型。' }
  };
  const styleInfo = styleMap[style] || styleMap.A;

  // 風格 vs 預算匹配檢查
  const budgetOrder = { A:0, B:1, C:2 };
  const styleBudgetMismatch = (budgetOrder[budget] || 0) < (budgetOrder[styleInfo.minBudget] || 0);

  // Storage need
  let storageNeed = '中等';
  if (shoes === 'C' || clothes === 'C' || bigstuff === 'D') storageNeed = '高';
  else if (shoes === 'A' && clothes === 'A') storageNeed = '低';

  // Modules
  const modules = [];
  if (Array.isArray(family)) {
    if (family.includes('B')) modules.push('toddler');
    if (family.includes('D')) modules.push('elderly');
    if (family.includes('E')) modules.push('pet');
  }
  if (wfh === 'C') modules.push('wfh');

  // Budget breakdown
  const budgetBreakdown = sqm > 0 ? calcBudget(sqm, budget, sprinkler) : null;

  // Save/Don't save
  const saveData = getSaveDontSave(personality.key, style, cleaning);

  // Action steps
  const actions = getActionSteps(personality.key, timeline, style);

  // Build HTML
  let html = `
    <div class="results-brand anim-in" style="text-align:center">
      <img src="/ai-diagnosis/assets/logo_gold.png" alt="懂屋" style="width:56px;height:56px;object-fit:contain;margin:0 auto 12px;display:block;opacity:.9">
      <div class="results-brand-label">懂屋 KNOW YOUR HOME</div>
      <div class="results-brand-title">你的專屬裝修診斷書</div>
