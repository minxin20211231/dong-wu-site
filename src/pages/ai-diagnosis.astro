function getFearTitle(fear) {
  const map = { A:'預算超支', B:'收納不夠用', C:'質感出不來', D:'工期一直拖' };
  return map[fear] || '裝修品質';
}

function getFearDesc(fear, pk) {
  const map = {
    A: '預算控制最關鍵的是「前期規劃」。報價前先定好優先級，第一輪一定超預算，砍掉優先級最低的項目。',
    B: '收納規劃必須在畫設計圖時就決定，不是裝修完了再找地方塞。每個房間都要有「歸位點」。',
    C: '質感來自一致性，不是貴不貴。同色調的三件套、同把手材質、一致的圓角或直角——這些不花錢但差很多。',
    D: '工期拖延 80% 是因為「中途改設計」。簽約前確認好所有細節，施工中零更動是最快入住的唯一方法。'
  };
  return map[fear] || '';
}

function getLayoutLabel(layout) {
  return { A:'不改格局', B:'小改', C:'大改' }[layout] || '不改';
}

function calcBudget(sqm, budget, sprinkler) {
  // 3 級制：標準型 5-7萬/坪, 精緻型 7-8萬/坪, 客製型 8-9萬/坪
  // 風格對應建議最低等級：北歐/工業→標準, 奶油→精緻, 輕奢→客製
  const style = answers.style || 'A';
  // 每坪單價由預算等級決定中位數
  const budgetPerSqm = { A: 6, B: 7.5, C: 8.5 };
  const perSqm = budgetPerSqm[budget] || 6;
  const rawTotal = Math.round(sqm * perSqm);
  const totalWan = Math.max(rawTotal, 80); // 最低承接門檻 80 萬

  // Read user answers to adjust breakdown
  const layout = answers.layout || 'A';
  const appliance = answers.appliances || 'A';
  const hasCeiling = sprinkler !== 'A';
  const clothes = answers.clothes || 'A';
  const kitchenArr2 = Array.isArray(answers.kitchen) ? answers.kitchen : (answers.kitchen ? [answers.kitchen] : ['A']);
  const kitchenHas2 = (v) => kitchenArr2.includes(v);
  const kitchen = kitchenArr2[0] || 'A';

  // Layout cost adjustment
  const layoutExtra = layout === 'C' ? 15 : layout === 'B' ? 5 : 0;
  // Appliance deduction
  const applianceCost = appliance === 'C' ? 20 : appliance === 'B' ? 12 : 0;
  // Kitchen extra (glass door / extra circuits)
  const kitchenExtra = (kitchenHas2('B') ? 2 : 0) + (kitchenHas2('C') ? 3 : 0);

  const netBudget = totalWan - applianceCost;
  const adjustedTotal = netBudget + layoutExtra + kitchenExtra;

  // Dynamic percentages based on answers
  const ceilingPct = hasCeiling ? 25 : 17;
  const storagePct = clothes === 'C' ? 27 : clothes === 'B' ? 24 : 21;
  const basePct = layout === 'C' ? 30 : layout === 'B' ? 28 : 25;
  const paintPct = 100 - ceilingPct - storagePct - basePct - 12; // 12 = management
  const mgmtPct = 12;

  const items = [
    { name:`基礎工程（水電、泥作${layout !== 'A' ? '、拆除' : ''}）`, pct: basePct, note: layout !== 'A' ? `含格局變動費用約 ${layoutExtra} 萬` : '' },
    { name:`天地壁（地板、磁磚${hasCeiling ? '、天花板' : ''}）`, pct: ceilingPct, note: !hasCeiling ? '你選擇不做天花板，這部分省了約 5-15 萬' : '' },
    { name:'收納系統（木作、系統櫃）', pct: storagePct, note: clothes === 'C' ? '因衣物量大，收納比例加大' : '' },
    { name:`油漆、軟裝、燈具${kitchenExtra > 0 ? '、廚房加裝' : ''}`, pct: paintPct, note: kitchenExtra > 0 ? `含廚房${kitchenHas2('B') ? '玻璃拉門' : ''}${kitchenHas2('B') && kitchenHas2('C') ? ' + ' : ''}${kitchenHas2('C') ? '額外電器迴路' : ''}約 ${kitchenExtra} 萬` : '' },
    { name:'設計管理費', pct: mgmtPct, note: '' }
  ];

  return {
    total: adjustedTotal,
    netBudget: netBudget,
    applianceCost: applianceCost,
    layoutExtra: layoutExtra,
    kitchenExtra: kitchenExtra,
    items: items.map(item => ({
      ...item,
      amount: Math.round(adjustedTotal * item.pct / 100)
    }))
  };
}

function getTimelineHTML(tl, layout) {
  const extraWeeks = layout === 'C' ? 3 : layout === 'B' ? 1 : 0;
  const phases = tl === 'A' ? [
    { num:'01', name:'設計規劃', dur:'1–2 週', detail:'找設計師/統包、確認平面圖、選材下單（系統櫃+現成家具）', note:'極速模式：材料要提前訂好' },
    { num:'02', name:'施工期', dur:`${2+extraWeeks}–3 週`, detail:'保護工程 → 水電配管 → 泥作防水 → 油漆 → 系統櫃安裝', note:'每週至少到場一次確認進度' },
    { num:'03', name:'收尾入住', dur:'1 週', detail:'清潔打掃 → 家具進場 → 缺失修補 → 驗收簽名', note:'交屋前做完整缺失清查再簽名' }
  ] : tl === 'B' ? [
    { num:'01', name:'設計規劃', dur:'3–4 週', detail:'找設計師簽約 → 丈量出圖 → 平面定案 → 選材確認 → 報價簽約', note:'這階段不要急，圖面確認越仔細，施工越順' },
    { num:'02', name:'施工期', dur:`${5+extraWeeks}–8 週`, detail:'保護→拆除→水電→泥作防水→木作→系統櫃→油漆→燈具', note:'關鍵驗收點：水電完成後、油漆前各一次' },
    { num:'03', name:'收尾驗收', dur:'2–3 週', detail:'細部修補 → 深度清潔 → 家具家電進場 → 逐項驗收', note:'準備驗收清單，拍照記錄每個缺失' }
  ] : [
    { num:'01', name:'設計規劃', dur:'4–6 週', detail:'找設計師比較 → 深度溝通需求 → 多次修圖 → 材料比價 → 簽約', note:'時間充裕可以多比較幾家' },
    { num:'02', name:'施工期', dur:`${8+extraWeeks}–14 週`, detail:'保護→拆除→水電→泥作→防水→木作→系統櫃→油漆→特殊工程', note:'可以安排訂製木作和進口建材' },
    { num:'03', name:'收尾驗收', dur:'3–4 週', detail:'細部修補 → 軟裝佈置 → 家具家電 → 完整驗收 → 悠閒入住', note:'不趕時間，每個細節都可以做到位' }
  ];

  return phases.map(p => `
    <div class="tl-phase">
      <div class="tl-num">PHASE ${p.num}</div>
      <div class="tl-name">${p.name}</div>
      <div class="tl-dur">${p.dur}</div>
      <div class="tl-detail">${p.detail}</div>
      <div class="tl-note">${p.note}</div>
    </div>
  `).join('');
}

