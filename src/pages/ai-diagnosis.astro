      <div style="font-size:11px;color:rgba(245,240,232,0.2);margin-top:6px">懂屋 KNOW YOUR HOME · 2026</div>
    </div>
  `;

  return html;
}

// ══════════ HELPERS ══════════

// Change 5: Personality with long descriptions
function getPersonality(budget, fear) {
  const types = {
    'saver': {
      key:'saver', emoji:'聰', name:'聰明省錢派',
      tagline:'你不是小氣，你是每一塊錢都要花在刀口上。',
      desc:'你不是不願意花錢，你是不願意花冤枉錢。每次看到裝修報價單，你第一個反應是「這個真的需要嗎？」你會貨比三家、研究每一個選項的 CP 值，因為你相信聰明的選擇比盲目的花費更重要。你最大的焦慮不是預算不夠，而是「花了錢卻沒有花在對的地方」。這份診斷，就是要幫你把每一塊錢都花在刀口上。'
    },
    'storage': {
      key:'storage', emoji:'整', name:'整理控',
      tagline:'東西有地方放，心情才會好。',
      desc:'對你來說，家最重要的不是好不好看，而是東西有沒有地方放。你無法忍受桌上堆滿雜物、鞋子散在玄關、衣服塞不進衣櫃的生活。你可能已經在腦海裡想像過完美的收納系統——每樣東西都有它的位置，用完就能歸位。你最大的恐懼是住進去才發現「收納空間不夠」，因為那時候要改就太遲了。這份診斷會幫你從一開始就把收納做對。'
    },
    'beauty': {
      key:'beauty', emoji:'美', name:'美感堅持派',
      tagline:'住進去的每一天都要順眼。',
      desc:'你對「質感」兩個字有自己的標準，而且不願意妥協。你寧可少做幾件事，也不想讓家看起來廉價。你可能花了很多時間在 Pinterest 和小紅書上收集靈感圖，心裡很清楚自己想要什麼感覺，但不確定怎麼在預算內達成。你最大的焦慮不是花太多錢，而是「花了錢卻得到一個跟想像不同的家」。這份診斷會告訴你，怎麼用最聰明的方式實現你的美學標準。'
    },
    'speed': {
      key:'speed', emoji:'快', name:'快速入住派',
      tagline:'先住進去再說。',
      desc:'你已經等夠久了。不管是租屋處的不便、跟家人擠在一起的壓力，還是單純想趕快住進自己的新家——你的第一優先就是「快」。你不需要完美，你需要的是一個能住、舒適、之後可以慢慢調整的家。你最怕的是工期一延再延，入住日遙遙無期。這份診斷會幫你找到最快住進去的路徑，告訴你哪些現在一定要做、哪些之後再補也來得及。'
    },
    'all': {
      key:'all', emoji:'全', name:'全方位規劃派',
      tagline:'什麼都想兼顧，需要系統幫你排優先。',
      desc:'你什麼都想兼顧——預算要控制、質感要到位、收納要夠用、時間也不能拖太久。這不是貪心，這是因為你知道裝修是一次性的大投資，每個面向都不想留遺憾。但也正因為什麼都想兼顧，你反而不知道從哪裡開始。你最大的焦慮是「遺漏了什麼重要的事」。這份診斷就是幫你把所有面向一次攤開，讓你看清楚優先順序，不再焦慮。'
    },
    'budget-beauty': {
      key:'budget-beauty', emoji:'資', name:'小資美感派',
      tagline:'預算有限但眼光不打折。',
      desc:'你的預算有限，但你的眼光不打折。你不想因為預算而將就，但也知道不可能什麼都做到頂。你一直在找那個「最聰明的平衡點」——在有限的預算裡，把質感拉到最高。你可能已經研究過很多省錢裝修的文章，但資訊太多太雜，不知道哪些真的可信。這份診斷會幫你找到那個平衡點——告訴你哪些地方值得投資、哪些地方用替代方案一樣好看。'
