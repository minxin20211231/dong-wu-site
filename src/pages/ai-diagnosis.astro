function calculateArchetype(ans) {
  const s = { researcher:0, intuitive:0, defender:0, planner:0, solo:0 };
  const W = {
    fear: { // 核心題：權重最高
      A: { researcher:3, defender:1, solo:1 },           // 花太多錢 → 也是 DIY 動機
      B: { defender:1,   planner:3 },                    // 東西放不下
      C: { researcher:1, intuitive:3 },                  // 看起來廉價
      D: { intuitive:2,  defender:2, planner:1 }         // 一直拖
    },
    timeline: {
      A: { intuitive:2 },                                // 超急 → 不可能 DIY
      C: { researcher:2, defender:1, planner:2, solo:3 } // 不急 → 強烈自包派訊號
    },
    budget: {
      A: { researcher:1, intuitive:1, solo:2 },          // 標準 → 自包派省錢路線
      B: { researcher:1, defender:1, planner:1 },
      C: { intuitive:1, planner:2 }
    },
    cleaning: {
      A: { researcher:1, defender:2, planner:1, solo:2 },// 勤勞 → hands-on
      B: { intuitive:2 }
    },
    layout: {
      A: { researcher:1, intuitive:2, defender:1 },
      B: { planner:1, solo:1 },
      C: { researcher:1, planner:2, solo:2 }             // 大改 → 自包派全程操盤
    }
  };
  Object.entries(W).forEach(([q, map]) => {
    const a = ans[q]; if (!a || !map[a]) return;
    Object.entries(map[a]).forEach(([k,v]) => s[k] += v);
  });
  // family checkbox 加權
  if (Array.isArray(ans.family)) {
    if (ans.family.includes('B')) { s.defender += 2; s.planner += 2; }
    if (ans.family.includes('D')) { s.defender += 2; s.planner += 1; }
    if (ans.family.includes('E')) { s.defender += 1; s.planner += 1; }
  }
  // 排序找主 + 次
  const sorted = Object.entries(s).sort((a,b) => b[1] - a[1]);
  const total = sorted.reduce((sum,[,v]) => sum + v, 0) || 1;
  return {
    primary: sorted[0][0],
    secondary: sorted[1][0],
    scores: s,
    primaryPct: Math.round(sorted[0][1] / total * 100),
    secondaryPct: Math.round(sorted[1][1] / total * 100)
  };
}

function renderArchetypeCard(arch) {
  const t = ARCHETYPE_TYPES[arch.primary];
  const sec = ARCHETYPE_TYPES[arch.secondary];
  const tagsHtml = t.tags.map(x => `<span class="arch-tag">${x.replace(/^#\s*/,'')}</span>`).join('');
  const pairsHtml = t.pairs.map(p =>
