        </div>` : ''}

      </div>
    </div>

    <!-- ═══ 收納規劃建議 ═══ -->
    <div class="glass-card anim-in" data-chapter="收納規劃">
      <div class="card-label">你的收納規劃</div>
      <div style="display:flex;flex-direction:column;gap:12px;margin-top:10px">

        <div class="personal-tip">
          <div class="tip-ref">鞋櫃 — 你有 ${shoes === 'A' ? '20 雙以內' : shoes === 'B' ? '20-50 雙' : '50 雙以上'}</div>
          <div class="tip-content">${shoes === 'A'
            ? '迷你鞋櫃即可（寬 90cm / 3 尺），建議做懸空式，下方可放常穿的拖鞋。'
