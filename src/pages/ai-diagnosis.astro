---
// 自動生成 — 來源：文欣交付 2026-05-19 / 懂屋_診斷書_v11-1.html
// 重新生成請跑：python scripts/build_diagnosis_page.py
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="免費 AI 裝修診斷書"
  description="回答 18 個問題，5 分鐘獲得專屬裝修診斷書。預算拆解、風格建議、工期規劃、避坑清單，一次搞定。"
  image="/ai-diagnosis/assets/og-diagnosis.jpg"
  imageAlt="免費 AI 裝修診斷書｜懂屋 Know Your Home"
>
<style is:inline>
:root {
  --bg: #1C1815;
  --card: rgba(255,252,248,0.06);
  --accent: #B8977E;
  --accent2: #D4886A;
  --text: #F5F0E8;
  --muted: rgba(245,240,232,0.5);
  --border: rgba(184,151,126,0.15);
  --glow1: rgba(184,151,126,0.3);
  --glow2: rgba(212,136,106,0.2);
  --radius: 16px;
  --transition: 0.35s cubic-bezier(.4,0,.2,1);
  --spring: cubic-bezier(.34,1.56,.64,1);
}

/* SVG icon base */
.icon{width:1em;height:1em;stroke:currentColor;stroke-width:1.75;stroke-linecap:round;stroke-linejoin:round;fill:none;display:inline-block;vertical-align:-0.15em;flex-shrink:0}
.icon-lg{width:1.25em;height:1.25em}

/* ═══ Sticky site header — scroll 後變浮動白 pill ═══ */
.site-header{position:fixed;top:0;left:0;right:0;z-index:200;padding:10px 24px;transition:padding .4s var(--spring),top .4s var(--spring)}
.header-inner{max-width:1080px;margin:0 auto;display:flex;align-items:center;gap:20px;background:rgba(28,24,21,0.72);backdrop-filter:blur(24px) saturate(140%);-webkit-backdrop-filter:blur(24px) saturate(140%);border:1px solid transparent;border-radius:0;padding:10px 18px;transition:all .45s var(--spring)}
.site-header.scrolled{padding-top:14px}
.site-header.scrolled .header-inner{
  max-width:760px;
  background:rgba(255,252,248,0.88);
  border-radius:50px;
  padding:6px 8px 6px 18px;
  border:1px solid rgba(28,24,21,0.08);
  box-shadow:0 12px 36px rgba(0,0,0,0.18),0 2px 8px rgba(28,24,21,0.05);
  gap:14px;
}
.header-brand{display:flex;align-items:center;gap:10px;font-size:14px;font-weight:800;letter-spacing:2px;color:var(--text);cursor:pointer;flex-shrink:0;transition:color .35s ease}
.header-brand .header-logo{width:32px;height:32px;object-fit:contain;transition:transform .4s var(--spring),width .4s var(--spring),height .4s var(--spring)}
.site-header.scrolled .header-brand{color:#1C1815}
.site-header.scrolled .header-brand .header-logo{width:28px;height:28px}
.header-brand:hover .header-logo{transform:rotate(45deg)}
.header-brand-text{font-size:14px;letter-spacing:3px;transition:color .35s ease}
.header-brand-text .en{font-size:9px;letter-spacing:2px;color:var(--accent);font-weight:700;display:block;margin-top:1px;transition:color .35s ease}
.site-header.scrolled .header-brand-text .en{color:#A68768}
.header-nav{flex:1;display:flex;gap:4px;justify-content:center}
.header-nav a{font-size:13px;padding:8px 14px;border-radius:18px;color:var(--muted);transition:color .25s,background .25s;cursor:pointer;font-weight:600;letter-spacing:.5px}
.header-nav a:hover{color:var(--accent);background:rgba(184,151,126,0.08)}
.site-header.scrolled .header-nav a{color:#6B5A4B}
.site-header.scrolled .header-nav a:hover{color:#A68768;background:rgba(28,24,21,0.06)}
/* Scroll spy active state */
.header-nav a.active{color:var(--accent);background:rgba(184,151,126,0.15);box-shadow:inset 0 0 0 1px rgba(184,151,126,0.25)}
.site-header.scrolled .header-nav a.active{color:#A68768;background:rgba(166,135,104,0.12);box-shadow:inset 0 0 0 1px rgba(166,135,104,0.3)}
.header-cta{padding:9px 18px;border-radius:18px;background:linear-gradient(135deg,var(--accent),var(--accent2));color:#fff;font-size:13px;font-weight:700;cursor:pointer;border:none;display:inline-flex;align-items:center;gap:6px;letter-spacing:.5px;transition:transform .2s,box-shadow .2s;flex-shrink:0}
.header-cta:hover{transform:translateY(-1px);box-shadow:0 6px 20px rgba(184,151,126,0.35)}
.site-header.scrolled .header-cta{padding:8px 16px}
body.has-header .hero{padding-top:80px}
@media(max-width:760px){
  .site-header{padding:8px 12px}
  .header-inner{padding:8px 14px;gap:10px}
  .header-nav{display:none}
  .header-brand-text{display:none}
  .header-cta{padding:8px 14px;font-size:12px}
  .site-header.scrolled .header-inner{max-width:none;border-radius:50px}
}

/* ═══ Color Rhythm System — 3 色 scene 節奏 ═══ */
:root{
  --bg-light:#F5F0E8;
  --bg-cream:#E8DCC8;
  --ink-light:#1C1815;
  --ink-cream:#2A2118;
  --muted-light:#6B5A4B;
  --muted-cream:#5A4A3D;
  --accent-light:#A68768;
  --accent-cream:#8C6F50;
  --border-light:rgba(28,24,21,0.08);
  --border-cream:rgba(28,24,21,0.10);
}
.scene-light,.scene-cream{width:100vw;margin-left:calc(-50vw + 50%);position:relative;z-index:2;padding:140px 24px 150px;overflow:hidden}
.scene-light .scene-inner,.scene-cream .scene-inner{max-width:820px;margin:0 auto}
.scene-light .scene-title,.scene-cream .scene-title{margin-bottom:22px}
.scene-light .section-label,.scene-cream .section-label{margin-bottom:22px}
/* 變數作用域覆蓋 — 所有 var(--xxx) 子元件自動變深色 */
.scene-light{
  --text:#1C1815; --muted:#6B5A4B; --accent:#A68768; --accent2:#B0734A;
  --border:rgba(28,24,21,0.10); --card:rgba(255,255,255,0.6); --glow1:rgba(140,111,80,0.18); --glow2:rgba(140,111,80,0.12);
  background:radial-gradient(ellipse 100% 80% at 50% 0%,#FAF6EE 0%,#EDE4D4 60%,#E3D7C0 100%) !important; color:#1C1815;
}
.scene-cream{
  --text:#2A2118; --muted:#5A4A3D; --accent:#8C6F50; --accent2:#A85F37;
  --border:rgba(28,24,21,0.12); --card:rgba(255,255,255,0.55); --glow1:rgba(140,111,80,0.18); --glow2:rgba(140,111,80,0.12);
  background:radial-gradient(ellipse 100% 80% at 50% 0%,#F0E4D0 0%,#E5D6BC 55%,#D0BE9C 100%) !important; color:#2A2118;
}
/* Paper-like texture — 讓淺底有紙張的細緻質感（opacity 從 .08 提高到 .18） */
.scene-light::before,.scene-cream::before{
  content:'';position:absolute;inset:0;pointer-events:none;
  background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='320' height='320'><filter id='p'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 0.30 0 0 0 0 0.22 0 0 0 0 0.14 0 0 0 0.55 0'/></filter><rect width='100%' height='100%' filter='url(%23p)'/></svg>");
  opacity:.18;mix-blend-mode:multiply;z-index:0;
}
/* 頂部 accent 光帶 — 像打光板，強化章節切換感 */
.scene-light::after,.scene-cream::after{
  content:'';position:absolute;top:0;left:50%;transform:translateX(-50%);
  width:60%;height:2px;
  background:linear-gradient(90deg,transparent,rgba(184,151,126,0.5),transparent);
  pointer-events:none;z-index:1;
}
.scene-light>*,.scene-cream>*{position:relative;z-index:1}
/* 底部柔陰影 — 分段章節 */
.scene-light,.scene-cream{box-shadow:inset 0 -40px 60px -40px rgba(28,24,21,0.12)}
/* 卡片改純白底（不半透明）+ 更深 shadow，讓卡片真的「浮起來」*/
.scene-light .creator-card,.scene-cream .creator-card,
.scene-light .faq-item,.scene-cream .faq-item,
.scene-light .testi,.scene-cream .testi,
.scene-light .outcome-item,.scene-cream .outcome-item{
  background:#FFFFFF !important;
  backdrop-filter:none;-webkit-backdrop-filter:none;
  border:1px solid rgba(28,24,21,0.06);
  box-shadow:0 20px 48px rgba(28,24,21,0.10),0 4px 12px rgba(28,24,21,0.05);
}
.scene-light .creator-card:hover,.scene-cream .creator-card:hover{
  box-shadow:0 30px 64px rgba(28,24,21,0.16),0 6px 16px rgba(28,24,21,0.08);
  transform:translateY(-6px);
}
.scene-light .scene-title,.scene-cream .scene-title{color:inherit;background:none;-webkit-text-fill-color:inherit}
.scene-light p, .scene-cream p { color: inherit; }

/* Light/Cream 內部組件改色 */
.scene-light .creator-card, .scene-cream .creator-card {
  background: #fff; backdrop-filter: none;
  border: 1.5px solid rgba(28,24,21,.08);
  box-shadow: 0 12px 32px rgba(28,24,21,.05);
}
.scene-light .creator-card:hover, .scene-cream .creator-card:hover {
  border-color: rgba(184,151,126,.5);
  box-shadow: 0 20px 48px rgba(28,24,21,.1);
}
.scene-light .creator-avatar, .scene-cream .creator-avatar {
  background: linear-gradient(135deg, rgba(184,151,126,.18), rgba(212,136,106,.08));
  border-color: var(--accent-light);
  -webkit-text-stroke-color: var(--accent-light);
}
.scene-light .creator-role, .scene-cream .creator-role { color: var(--accent-light); }
.scene-light .creator-name, .scene-cream .creator-name { color: var(--ink-light); }
.scene-light .creator-credential, .scene-cream .creator-credential { color: var(--muted-light); }
.scene-light .creator-quote, .scene-cream .creator-quote {
  color: rgba(28,24,21,.78);
  border-top-color: rgba(28,24,21,.1);
}

.scene-cream .faq-item {
  background: #fff; backdrop-filter: none;
  border: 1.5px solid var(--border-cream);
  box-shadow: 0 6px 18px rgba(28,24,21,.04);
}
.scene-cream .faq-item.open { border-color: rgba(184,151,126,.5); box-shadow: 0 12px 32px rgba(28,24,21,.08); }
.scene-cream .faq-q { color: var(--ink-cream); }
.scene-cream .faq-q:hover { color: var(--accent-cream); }
.scene-cream .faq-q-chevron { color: var(--accent-cream); }
.scene-cream .faq-a { color: rgba(28,24,21,.72); }
.scene-cream .faq-a strong { color: var(--accent-cream); }

.scene-cream .testi {
  background: #fff; backdrop-filter: none;
  border: 1.5px solid var(--border-cream);
  box-shadow: 0 8px 20px rgba(28,24,21,.04);
}
.scene-cream .testi-name { color: var(--ink-cream); }
.scene-cream .testi-meta { color: var(--muted-cream); }
.scene-cream .testi-quote { color: rgba(28,24,21,.85); }
.scene-cream .testi-avatar { border-color: rgba(28,24,21,.15); }

.scene-cream .outcome-item {
  background: #fff; border: 1.5px solid var(--border-cream);
}
.scene-cream .outcome-item:hover { border-color: rgba(184,151,126,.5); }
.scene-cream .outcome-item-title { color: var(--ink-cream); }
.scene-cream .outcome-item-desc { color: var(--muted-cream); }

/* Noise grain — 攝影棚質感 */
.grain{position:fixed;inset:0;z-index:1;pointer-events:none;opacity:.035;mix-blend-mode:overlay;background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='240' height='240'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='3' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 0.95 0 0 0 0 0.88 0 0 0 0 0.78 0 0 0 0.55 0'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>")}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

html { scroll-behavior: smooth; }

body {
  background: var(--bg) url('/ai-diagnosis/assets/footer_whale.png') center top / cover no-repeat fixed;
  color: var(--text);
  font-family: -apple-system, 'Noto Sans TC', 'PingFang TC', 'Microsoft JhengHei', sans-serif;
  min-height: 100vh;
  overflow-x: hidden;
  position: relative;
}
body::before {
  content: '';
  position: fixed; inset: 0; pointer-events: none; z-index: 0;
  background: linear-gradient(180deg, rgba(28,24,21,.35) 0%, rgba(28,24,21,.62) 50%, rgba(28,24,21,.85) 100%);
}
body > * { position: relative; z-index: 1; }

/* ─── Animated Gradient Mesh ─── */
.mesh-bg {
  position: fixed; inset: 0; z-index: 0; pointer-events: none; overflow: hidden;
}
.mesh-bg::before, .mesh-bg::after, .mesh-orb {
  position: absolute; border-radius: 50%; filter: blur(80px); opacity: 0.18;
  animation: drift 18s ease-in-out infinite alternate;
}
.mesh-bg::before {
  width: 60vw; height: 60vw;
  background: radial-gradient(circle, #B8977E 0%, transparent 70%);
  top: -15%; left: -10%;
  animation-duration: 22s;
}
.mesh-bg::after {
  width: 50vw; height: 50vw;
  background: radial-gradient(circle, #D4886A 0%, transparent 70%);
  bottom: -10%; right: -10%;
  animation-duration: 28s; animation-delay: -8s;
}
.mesh-orb {
  width: 40vw; height: 40vw;
  background: radial-gradient(circle, #7a5c48 0%, transparent 70%);
  top: 40%; left: 50%; transform: translate(-50%,-50%);
  animation-duration: 16s; animation-delay: -4s;
}
@keyframes drift {
  0% { transform: translate(0,0) scale(1); }
  33% { transform: translate(3%,5%) scale(1.05); }
  66% { transform: translate(-3%,2%) scale(0.97); }
  100% { transform: translate(2%,-4%) scale(1.03); }
}

/* ─── Progress Bar with 階段刻度 ─── */
#progress-track {
  position: fixed; top: 0; left: 0; right: 0; height: 4px; z-index: 1000;
  background: rgba(184,151,126,0.08);
  pointer-events: none;
}
#progress-bar {
  position: absolute; top: 0; left: 0; height: 100%;
  background: linear-gradient(90deg, var(--accent), var(--accent2));
  transition: width 0.6s cubic-bezier(.4,0,.2,1);
  box-shadow: 0 0 12px var(--glow1);
  width: 0%;
}
#progress-ticks {
  position: absolute; inset: 0;
  display: flex; justify-content: space-between;
  padding: 0 2px; pointer-events: none;
}
.progress-tick {
  width: 2px; height: 100%;
  background: rgba(245,240,232,0.18);
  position: relative;
  transition: background 0.4s ease;
}
.progress-tick::after {
  content: ''; position: absolute; top: -3px; left: -2px;
  width: 6px; height: 10px; border-radius: 3px;
  background: transparent;
  transition: background 0.4s ease, box-shadow 0.4s ease, transform 0.4s var(--spring);
}
.progress-tick.active::after {
  background: var(--accent2);
  box-shadow: 0 0 10px var(--accent2);
  transform: scale(1.15);
}
.progress-tick.passed::after {
  background: var(--accent);
}

/* ─── Layout Containers ─── */
.page { position: relative; z-index: 1; }

/* ─── Landing Page ─── */
#landing {
  display: flex; flex-direction: column; align-items: center;
  padding: 0 24px; text-align: center;
}

/* Hero — full viewport, big breathing room */
.hero {
  min-height: 100vh; min-height: 100dvh;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  padding: 80px 0;
}

.brand-label {
  font-size: 11px; letter-spacing: 5px; color: var(--accent);
  text-transform: uppercase; font-weight: 600;
  margin-bottom: 32px;
  opacity: 0; animation: fadeUp 0.8s 0.2s ease forwards;
}

.landing-title {
  font-size: clamp(32px, 6vw, 56px);
  font-weight: 900; line-height: 1.15;
  letter-spacing: -0.03em; margin-bottom: 20px;
  max-width: 600px;
  background: linear-gradient(135deg, var(--text) 30%, var(--accent) 100%);
  -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
}
.landing-title .ch { display: inline-block; opacity: 0; transform: translateY(24px) rotate(6deg); animation: chIn .7s var(--spring) forwards; background: linear-gradient(135deg, var(--text) 30%, var(--accent) 100%); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
.landing-title .ch.br { display: block; height: 0; }
@keyframes chIn { to { opacity: 1; transform: translateY(0) rotate(0); } }

.landing-sub {
  font-size: 17px; color: var(--muted); line-height: 1.8;
  max-width: 420px; margin-bottom: 48px;
  opacity: 0; animation: fadeUp 0.8s 0.6s ease forwards;
}

.cta-btn {
  position: relative; overflow: hidden;
  background: linear-gradient(135deg, var(--accent), var(--accent2));
  color: #fff; font-size: 17px; font-weight: 700;
  border: none; border-radius: 50px; padding: 18px 48px;
  cursor: pointer; letter-spacing: 0.03em;
  box-shadow: 0 0 40px var(--glow1), 0 4px 20px rgba(0,0,0,0.3);
  transition: var(--transition);
  opacity: 0; animation: fadeUp 0.8s 0.8s ease forwards;
}
.cta-btn::after {
  content: '';
  position: absolute; inset: 0;
  background: linear-gradient(90deg, transparent 0%, rgba(255,255,255,0.25) 50%, transparent 100%);
  transform: translateX(-100%);
  animation: shimmer 2.8s 1.5s infinite;
}
@keyframes shimmer {
  0% { transform: translateX(-100%); }
  60%, 100% { transform: translateX(100%); }
}
.cta-btn:hover {
  transform: translateY(-3px) scale(1.03);
  box-shadow: 0 0 60px var(--glow1), 0 8px 32px rgba(0,0,0,0.4);
}
.cta-btn:active { transform: scale(0.98); }

.hero-note {
  margin-top: 20px; font-size: 12px; color: rgba(245,240,232,0.3);
  opacity: 0; animation: fadeUp 0.8s 1s ease forwards;
}

.scroll-hint {
  margin-top: 40px; font-size: 12px; color: rgba(245,240,232,0.25);
  animation: bounce 2s 2s ease-in-out infinite;
  opacity: 0; animation: fadeUp 0.8s 1.2s ease forwards, bounce 2s 3s ease-in-out infinite;
}
@keyframes bounce {
  0%,100% { transform: translateY(0); }
  50% { transform: translateY(8px); }
}
@keyframes fadeUp {
  from { opacity: 0; transform: translateY(20px); }
  to { opacity: 1; transform: translateY(0); }
}

/* Breathe + shine hover sweep (cc.lifehacker inspired) */
.btn-breathe { animation: waitlist-breathe 2.4s ease-in-out infinite; }
/* .cta-btn 本身有 opacity:0 + fadeUp，.btn-breathe 會覆蓋 animation → 合併兩條 */
.cta-btn.btn-breathe { animation: fadeUp 0.8s 0.8s ease forwards, waitlist-breathe 2.4s 2s ease-in-out infinite; }
@keyframes waitlist-breathe { 0%,100% { transform: scale(1); box-shadow: 0 4px 16px rgba(212,136,106,.28), 0 0 40px var(--glow1); } 50% { transform: scale(1.035); box-shadow: 0 8px 28px rgba(212,136,106,.55), 0 0 50px var(--glow1); } }
.shine-btn { position: relative; overflow: hidden; isolation: isolate; }
.shine-btn::before { content: ''; position: absolute; inset: 0; background: linear-gradient(105deg, transparent 40%, rgba(255,255,255,.22) 50%, transparent 60%); transform: translateX(-150%); transition: transform .85s ease; pointer-events: none; z-index: 2; }
.shine-btn:hover::before { transform: translateX(150%); }
@media (prefers-reduced-motion: reduce) { .btn-breathe { animation: none; } }

/* Landing sections — each one a "scene" */
.land-section {
  width: 100%; max-width: 560px;
  padding: 80px 0;
  opacity: 0; transform: translateY(40px);
  transition: all 0.8s cubic-bezier(0.4,0,0.2,1);
}
.land-section.in-view {
  opacity: 1; transform: translateY(0);
}

.section-label {
  font-size: 12px; letter-spacing: 3px; color: var(--accent);
  text-transform: uppercase; font-weight: 600;
  margin-bottom: 16px;
}

.section-title {
  font-size: clamp(22px, 4vw, 32px);
  font-weight: 800; line-height: 1.3;
  margin-bottom: 12px; letter-spacing: -0.01em;
}

.section-desc {
  font-size: 15px; color: var(--muted); line-height: 1.7;
  margin-bottom: 32px;
}

.value-grid {
  display: grid; grid-template-columns: 1fr 1fr;
  gap: 14px; width: 100%; margin-bottom: 0;
}

.value-card {
  background: var(--card); border: 1px solid var(--border);
  border-radius: var(--radius); padding: 24px 20px;
  backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
  text-align: left; transition: var(--transition);
}
.value-card:hover {
  border-color: rgba(184,151,126,0.4);
  transform: translateY(-4px);
  box-shadow: 0 12px 40px var(--glow2);
}
.value-card .emoji { font-size: 24px; margin-bottom: 12px; display: block; }
.value-card .vc-title { font-size: 14px; font-weight: 700; color: var(--text); margin-bottom: 6px; }
.value-card .vc-desc { font-size: 12px; color: var(--muted); line-height: 1.6; }

/* Testimonials */
.testimonials { display: flex; flex-direction: column; gap: 14px; width: 100%; }
.testimonial {
  background: var(--card); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
  border: 1px solid var(--border); border-radius: 14px;
  padding: 18px 20px; text-align: left; transition: var(--transition);
  position: relative; isolation: isolate;
}
.testimonial::after {
  content: ''; position: absolute; inset: -20%;
  background: radial-gradient(circle at center, rgba(184,151,126,.3), transparent 60%);
  opacity: 0; transition: opacity .5s; z-index: -1; filter: blur(30px); pointer-events: none;
}
.testimonial:hover::after { opacity: 1; }
.testimonial:hover { border-color: rgba(184,151,126,0.3); transform: translateY(-3px); }
.testimonial q { font-size: 14px; color: var(--text); line-height: 1.7; font-style: normal; }
.testimonial cite { display: block; font-size: 11px; color: var(--muted); margin-top: 8px; font-style: normal; }

/* Trust row */
.trust-row {
  display: flex; gap: 20px; justify-content: center; flex-wrap: wrap;
  padding: 20px 0; font-size: 12px; color: var(--muted);
}
.trust-item { display: flex; align-items: center; gap: 6px; }

/* Bottom CTA section */
.cta-section {
  width: 100%; max-width: 560px;
  padding: 60px 0 80px;
  text-align: center;
  opacity: 0; transform: translateY(40px);
  transition: all 0.8s cubic-bezier(0.4,0,0.2,1);
}
.cta-section.in-view { opacity: 1; transform: translateY(0); }

.cta-section .cta-title {
  font-size: clamp(24px, 4vw, 36px);
  font-weight: 900; margin-bottom: 12px;
  background: linear-gradient(135deg, var(--text) 30%, var(--accent) 100%);
  -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
}
.cta-section .cta-sub {
  font-size: 15px; color: var(--muted); margin-bottom: 32px; line-height: 1.7;
}

.footer-note {
  margin-top: 40px; font-size: 11px; color: rgba(245,240,232,0.2);
  letter-spacing: 0.08em; line-height: 1.8;
}

/* Social proof badges */
/* Ghost button (secondary) */
.cta-btn-ghost {
  background: transparent;
  color: var(--text); font-size: 17px; font-weight: 700;
  border: 1.5px solid var(--border); border-radius: 50px;
  padding: 18px 40px; cursor: pointer;
  transition: var(--transition); letter-spacing: 0.03em;
}
.cta-btn-ghost:hover {
  border-color: var(--accent); color: var(--accent);
  transform: translateY(-3px);
  box-shadow: 0 0 30px rgba(184,151,126,0.15);
}

/* ─── Landing Scenes ─── */
.land-scene {
  min-height: 100vh; min-height: 100dvh;
  display: flex; align-items: center; justify-content: center;
  padding: 80px 24px;
}
.scene-inner {
  width: 100%; max-width: 640px;
}
.scene-title {
  font-size: clamp(28px, 5vw, 48px);
  font-weight: 900; line-height: 1.2;
  letter-spacing: -0.02em; margin-bottom: 48px;
}

/* Pain items — numbered list, editorial style, CENTERED */
.pain-list { display: flex; flex-direction: column; gap: 0; text-align: center; }
.pain-item {
  display: flex; flex-direction: column; align-items: center;
  padding: 32px 0;
  border-bottom: 1px solid var(--border);
}
.pain-item:first-child { border-top: 1px solid var(--border); }
.pain-num {
  font-size: 12px; font-weight: 700; color: var(--accent);
  margin-bottom: 10px; letter-spacing: 2px;
}
.pain-headline {
  font-size: 18px; font-weight: 700; color: var(--text);
  margin-bottom: 8px; line-height: 1.4;
}
.pain-desc {
  font-size: 14px; color: var(--muted); line-height: 1.6; max-width: 440px;
}

/* ═══ Compare scene — 反白底（月光白）提供視覺節奏換氣 ═══ */
.compare-scene {
  background: #F5F0E8; color: #1C1815;
  width: 100vw; margin-left: calc(-50vw + 50%);
  padding: 100px 24px; min-height: auto;
  position: relative; z-index: 2;
}
.compare-scene .scene-inner { max-width: 960px; margin: 0 auto; }
.compare-scene .section-label { color: #A68768; }
.compare-scene .scene-title {
  color: #1C1815;
  background: none; -webkit-text-fill-color: #1C1815;
  margin-bottom: 40px;
}
.compare-grid {
  display: grid; grid-template-columns: repeat(3, 1fr);
  gap: 16px; margin-bottom: 28px; text-align: left;
}
.compare-card {
  background: #FFFFFF;
  border: 1.5px solid rgba(28,24,21,0.08);
  border-radius: 18px; padding: 28px 22px;
  display: flex; flex-direction: column;
  transition: all .35s cubic-bezier(.4,0,.2,1);
  position: relative; isolation: isolate;
}
.compare-card::after {
  content: ''; position: absolute; inset: -20%;
  background: radial-gradient(circle at center, rgba(218,123,74,.25), transparent 60%);
  opacity: 0; transition: opacity .55s;
  z-index: -1; filter: blur(30px); pointer-events: none;
}
.compare-card:hover { transform: translateY(-6px); box-shadow: 0 16px 50px rgba(28,24,21,.12); }
.compare-card:hover::after { opacity: 1; }
.compare-level {
  font-size: 11px; letter-spacing: 3px; font-weight: 700;
  color: #A68768; text-transform: uppercase; margin-bottom: 8px;
}
.compare-name { font-size: 19px; font-weight: 900; color: #1C1815; margin-bottom: 4px; }
.compare-who { font-size: 12px; color: #8A6F5A; margin-bottom: 16px; }
.compare-list { list-style: none; padding: 0; margin: 0 0 18px 0; flex: 1; }
.compare-list li {
  font-size: 13px; line-height: 1.7; color: #3D2E1F;
  padding: 7px 0; border-bottom: 1px dashed rgba(28,24,21,0.08);
}
.compare-list li:last-child { border-bottom: none; }
.compare-result {
  font-size: 13px; font-weight: 700;
  padding: 12px 14px; border-radius: 10px;
  background: rgba(28,24,21,0.05); color: #3D2E1F;
  text-align: center; margin-top: auto;
}
.compare-card--featured {
  background: linear-gradient(135deg, #1C1815 0%, #2A2420 100%);
  color: #F5F0E8;
  box-shadow: 0 0 0 1.5px rgba(184,151,126,.5), 0 20px 50px rgba(28,24,21,.25);
  transform: scale(1.04);
  animation: featured-pulse 3.2s ease-in-out infinite;
}
@keyframes featured-pulse {
  0%, 100% { box-shadow: 0 0 0 1.5px rgba(184,151,126,.5), 0 20px 50px rgba(28,24,21,.25), 0 0 40px rgba(212,136,106,.15); }
  50% { box-shadow: 0 0 0 1.5px rgba(212,136,106,.7), 0 24px 60px rgba(28,24,21,.35), 0 0 70px rgba(212,136,106,.35); }
}
@media (prefers-reduced-motion: reduce) {
  .compare-card--featured { animation: none; }
}
.compare-card--featured .compare-level { color: #D4886A; }
.compare-card--featured .compare-name { color: #F5F0E8; }
.compare-card--featured .compare-who { color: rgba(245,240,232,0.55); }
.compare-card--featured .compare-list li { color: rgba(245,240,232,0.92); border-bottom-color: rgba(245,240,232,0.12); }
.compare-card--featured .compare-result { background: linear-gradient(135deg, #B8977E, #D4886A); color: #1C1815; }
.compare-card--featured::after {
  background: radial-gradient(circle at center, rgba(212,136,106,.45), transparent 60%);
  opacity: .35;
}
.compare-card--featured:hover { transform: scale(1.04) translateY(-6px); }
.compare-card--featured:hover::after { opacity: .75; }
.compare-note {
  font-size: 16px; font-weight: 600; color: #3D2E1F;
  text-align: center; margin-top: 24px;
}
@media (max-width: 720px) {
  .compare-grid { grid-template-columns: 1fr; }
  .compare-card--featured { transform: scale(1); }
  .compare-card--featured:hover { transform: translateY(-6px); }
}

/* ═══ With / Without 戲劇化對比 ═══ */
.vs-scene {
  width: 100vw; margin-left: calc(-50vw + 50%);
  padding: 100px 24px 110px;
  background: linear-gradient(180deg, rgba(28,24,21,0) 0%, rgba(28,24,21,0.35) 50%, rgba(28,24,21,0) 100%);
  position: relative; z-index: 2;
}
.vs-inner { max-width: 1040px; margin: 0 auto; text-align: center; }
.vs-grid {
  display: grid; grid-template-columns: 1fr auto 1fr;
  gap: 20px; margin-top: 48px; align-items: stretch;
  text-align: left;
}
.vs-card {
  position: relative; padding: 32px 28px 28px;
  border-radius: 20px;
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  display: flex; flex-direction: column;
  transition: transform .4s var(--spring);
}
.vs-card--bad {
  background: linear-gradient(180deg, rgba(184,90,58,0.08), rgba(184,90,58,0.03));
  border: 1px solid rgba(184,90,58,0.2);
}
.vs-card--good {
  background: linear-gradient(180deg, rgba(184,151,126,0.15), rgba(212,136,106,0.06));
  border: 1.5px solid rgba(184,151,126,0.45);
  box-shadow: 0 0 40px rgba(184,151,126,0.15);
}
.vs-card--good::before {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: 20px;
  background: radial-gradient(ellipse 80% 40% at 50% 0%, rgba(212,136,106,0.18), transparent 70%);
  pointer-events: none;
}
.vs-card:hover { transform: translateY(-4px); }
.vs-label {
  font-size: 10px; letter-spacing: 4px; font-weight: 700;
  text-transform: uppercase; margin-bottom: 14px;
  display: inline-flex; align-items: center; gap: 8px;
  position: relative;
}
.vs-label::after {
  content: ''; width: 24px; height: 1px;
  background: currentColor; opacity: 0.5;
}
.vs-card--bad .vs-label { color: #E07B6A; }
.vs-card--good .vs-label { color: var(--accent); }
.vs-headline {
  font-size: 19px; font-weight: 900;
  line-height: 1.4; margin-bottom: 20px;
  letter-spacing: -0.01em;
}
.vs-card--bad .vs-headline { color: rgba(245,240,232,0.92); }
.vs-card--good .vs-headline {
  color: var(--text);
  position: relative;
}
.vs-quote {
  font-style: italic;
  font-size: 14.5px; line-height: 1.8;
  padding: 14px 16px;
  border-radius: 12px;
  margin-bottom: 20px;
  position: relative;
}
.vs-card--bad .vs-quote {
  background: rgba(184,90,58,0.08);
  color: rgba(245,240,232,0.75);
  border-left: 2px solid rgba(184,90,58,0.4);
}
.vs-card--good .vs-quote {
  background: rgba(184,151,126,0.1);
  color: var(--text);
  border-left: 2px solid var(--accent);
}
.vs-quote::before {
  content: '“';
  position: absolute;
  top: -8px; left: 8px;
  font-size: 36px;
  font-family: Georgia, serif;
  line-height: 1;
  opacity: 0.4;
}
.vs-card--good .vs-quote::before { color: var(--accent); }
.vs-card--bad .vs-quote::before { color: #E07B6A; }
.vs-flow {
  display: flex; flex-direction: column;
  gap: 8px; margin-bottom: 20px;
  position: relative;
}
.vs-step {
  display: flex; align-items: flex-start; gap: 10px;
  font-size: 13px; line-height: 1.6;
}
.vs-step-num {
  flex-shrink: 0;
  width: 20px; height: 20px;
  border-radius: 50%;
  display: inline-flex; align-items: center; justify-content: center;
  font-size: 10px; font-weight: 900;
  font-variant-numeric: tabular-nums;
  margin-top: 2px;
}
.vs-card--bad .vs-step-num {
  background: rgba(184,90,58,0.15);
  color: #E07B6A;
  border: 1px solid rgba(184,90,58,0.3);
}
.vs-card--good .vs-step-num {
  background: var(--accent);
  color: #1C1815;
}
.vs-card--bad .vs-step { color: rgba(245,240,232,0.72); }
.vs-card--good .vs-step { color: rgba(245,240,232,0.92); }
.vs-outcome {
  margin-top: auto;
  padding: 14px 16px;
  border-radius: 12px;
  font-size: 14px; font-weight: 700;
  text-align: center;
  position: relative;
}
.vs-card--bad .vs-outcome {
  background: rgba(184,90,58,0.15);
  color: #E07B6A;
  border: 1px dashed rgba(184,90,58,0.35);
}
.vs-card--good .vs-outcome {
  background: linear-gradient(135deg, var(--accent), var(--accent2));
  color: #1C1815;
  box-shadow: 0 8px 24px rgba(184,151,126,0.3);
}
.vs-divider {
  display: flex; align-items: center; justify-content: center;
  position: relative;
  font-size: 11px; letter-spacing: 3px; font-weight: 700;
  color: var(--accent); text-transform: uppercase;
  min-width: 56px;
}
.vs-divider::before,
.vs-divider::after {
  content: '';
  position: absolute;
  left: 50%;
  width: 1px;
  background: linear-gradient(180deg, transparent, rgba(184,151,126,0.4), transparent);
}
.vs-divider::before { top: 0; bottom: 50%; transform: translate(-50%, -12px); }
.vs-divider::after { top: 50%; bottom: 0; transform: translate(-50%, 12px); }
.vs-footer {
  margin-top: 40px;
  font-size: 17px; font-weight: 700;
  line-height: 1.7;
  color: rgba(245,240,232,0.82);
}
.vs-footer strong {
  background: linear-gradient(135deg, var(--accent), var(--accent2));
  -webkit-background-clip: text; background-clip: text;
  -webkit-text-fill-color: transparent;
  font-weight: 900;
}
@media (max-width: 760px) {
  .vs-grid { grid-template-columns: 1fr; gap: 16px; }
  .vs-divider {
    flex-direction: row;
    min-width: auto; padding: 12px 0;
  }
  .vs-divider::before,
  .vs-divider::after {
    top: 50%; bottom: auto;
    width: auto; height: 1px;
    background: linear-gradient(90deg, transparent, rgba(184,151,126,0.4), transparent);
  }
  .vs-divider::before { left: 0; right: 50%; transform: translate(-12px, -50%); }
  .vs-divider::after { left: 50%; right: 0; transform: translate(12px, -50%); }
}

/* ═══ Outcome Preview — 你會拿到什麼 ═══ */
.outcome-scene {
  width: 100vw; margin-left: calc(-50vw + 50%);
  padding: 100px 24px;
}
.outcome-inner { max-width: 1040px; margin: 0 auto; text-align: center; }
.outcome-grid {
  display: grid;
  grid-template-columns: 1.1fr 1fr;
  gap: 40px;
  align-items: center;
  margin-top: 48px;
  text-align: left;
}
.outcome-preview {
  /* 暗色診斷書 mockup — 重新設定變數 scope，不受 scene-cream 影響 */
  --text: #F5F0E8;
  --muted: rgba(245,240,232,0.55);
  --accent: #B8977E;
  --accent2: #D4886A;
  --border: rgba(184,151,126,0.2);
  color: #F5F0E8;
  position: relative;
  border-radius: 22px;
  overflow: hidden;
  background: linear-gradient(180deg, #1C1815, #2A2420);
  border: 1px solid rgba(184,151,126,0.3);
  padding: 24px;
  box-shadow: 0 24px 60px rgba(28,24,21,0.35), 0 0 40px rgba(184,151,126,0.12);
  aspect-ratio: 4 / 5;
  display: flex;
  flex-direction: column;
  animation: outcome-glow 4s ease-in-out infinite;
}
@keyframes outcome-glow {
  0%, 100% { box-shadow: 0 24px 60px rgba(28,24,21,0.35), 0 0 40px rgba(184,151,126,0.12), inset 0 0 0 1px rgba(184,151,126,0.2); }
  50% { box-shadow: 0 28px 70px rgba(28,24,21,0.4), 0 0 70px rgba(212,136,106,0.28), inset 0 0 0 1px rgba(212,136,106,0.35); }
}
.outcome-preview *, .outcome-preview-title, .outcome-preview-brand { color: inherit; }
.outcome-preview-title { color: #F5F0E8; }
.outcome-preview-brand { color: #B8977E; }
.outcome-mini-label { color: #B8977E; }
.outcome-mini-content { color: rgba(245,240,232,0.75); }
.outcome-preview-watermark {
  background: linear-gradient(180deg, transparent, rgba(28,24,21,0.95));
  color: rgba(245,240,232,0.5);
}
.outcome-preview-head {
  padding: 22px 6px 14px;
  text-align: center;
}
.outcome-preview-brand {
  font-size: 8px;
  letter-spacing: 4px;
  color: var(--accent);
  opacity: 0.7;
  font-weight: 700;
}
.outcome-preview-title {
  font-size: 13px;
  font-weight: 900;
  margin-top: 4px;
  letter-spacing: -0.01em;
}
.outcome-preview-body {
  padding: 14px 4px;
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  position: relative;
  -webkit-mask-image: linear-gradient(180deg, transparent 0%, black 10%, black 90%, transparent 100%);
  mask-image: linear-gradient(180deg, transparent 0%, black 10%, black 90%, transparent 100%);
}
.outcome-preview-scroll {
  display: flex; flex-direction: column; gap: 10px;
  animation: outcome-scroll 32s linear infinite;
  will-change: transform;
}
.outcome-preview:hover .outcome-preview-scroll { animation-play-state: paused; }
@keyframes outcome-scroll {
  0% { transform: translateY(0); }
  100% { transform: translateY(-50%); }
}
@media (prefers-reduced-motion: reduce) {
  .outcome-preview-scroll { animation: none; }
  .outcome-preview { animation: none; }
}
.outcome-mini-block {
  background: rgba(184,151,126,0.06);
  border-radius: 8px;
  padding: 8px 10px;
  position: relative;
}
.outcome-mini-block::before {
  content: '';
  position: absolute;
  left: 0; top: 10px; bottom: 10px; width: 2px;
  background: var(--accent);
  opacity: 0.6;
}
.outcome-mini-label {
  font-size: 7px;
  letter-spacing: 2px;
  color: var(--accent);
  font-weight: 700;
  text-transform: uppercase;
  margin-bottom: 3px;
}
.outcome-mini-content {
  font-size: 9px;
  color: rgba(245,240,232,0.7);
  line-height: 1.4;
}
.outcome-mini-bar {
  height: 4px;
  background: rgba(184,151,126,0.1);
  border-radius: 2px;
  margin-top: 4px;
  overflow: hidden;
}
.outcome-mini-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--accent), var(--accent2));
  border-radius: 2px;
}
.outcome-preview-watermark {
  position: absolute;
  bottom: 0; left: 0; right: 0;
  height: 80px;
  background: linear-gradient(180deg, transparent, rgba(28,24,21,0.95));
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding-bottom: 14px;
  font-size: 10px;
  color: var(--muted);
  letter-spacing: 1px;
}
.outcome-items {
  display: flex;
  flex-direction: column;
  gap: 14px;
}
.outcome-item {
  display: flex;
  align-items: flex-start;
  gap: 14px;
  padding: 14px 16px;
  background: rgba(255,252,248,0.04);
  border: 1px solid var(--border);
  border-radius: 12px;
  transition: all 0.3s var(--spring);
}
.outcome-item:hover {
  border-color: rgba(184,151,126,0.3);
  transform: translateX(3px);
}
.outcome-check {
  flex-shrink: 0;
  width: 24px; height: 24px;
  border-radius: 50%;
  background: linear-gradient(135deg, #E5A06A, #F0BE85);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-weight: 900;
  margin-top: 1px;
  box-shadow: 0 2px 8px rgba(229,160,106,.35);
}
.outcome-check svg { width: 13px; height: 13px; stroke-width: 2.5; }
.outcome-item-body { flex: 1; }
.outcome-item-title {
  font-size: 14.5px;
  font-weight: 700;
  margin-bottom: 3px;
}
.outcome-item-desc {
  font-size: 12px;
  color: var(--muted);
  line-height: 1.65;
}
@media (max-width: 760px) {
  .outcome-grid { grid-template-columns: 1fr; gap: 28px; }
  .outcome-preview { aspect-ratio: 4 / 3; }
}

/* ═══ Creators — 畢波 + 文欣 ═══ */
.creators-scene {
  width: 100vw; margin-left: calc(-50vw + 50%);
  padding: 100px 24px;
  background: linear-gradient(180deg, rgba(184,151,126,0.04), transparent 80%);
}
.creators-inner { max-width: 880px; margin: 0 auto; text-align: center; }
.creators-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18px;
  margin-top: 44px;
  text-align: left;
}
.creator-card {
  background: linear-gradient(180deg, rgba(255,252,248,0.06), rgba(255,252,248,0.02));
  border: 1px solid var(--border);
  border-radius: 18px;
  padding: 30px 26px;
  backdrop-filter: blur(20px);
  transition: all 0.35s var(--spring);
  position: relative;
}
.creator-card:hover {
  transform: translateY(-4px);
  border-color: rgba(184,151,126,0.4);
  box-shadow: 0 16px 40px rgba(184,151,126,0.12);
}
.creator-avatar {
  width: 110px; height: 110px;
  border-radius: 50%;
  border: 2px solid var(--accent);
  overflow: hidden; position: relative;
  margin: 0 auto 16px; display: block;
  box-shadow: 0 8px 24px rgba(28,24,21,.18);
  background: #FBF6EE;
}
.creator-avatar img {
  width: 100%; height: 100%;
  object-fit: cover; object-position: 50% 18%;
  display: block;
}
.creator-role {
  font-size: 10px;
  letter-spacing: 3px;
  color: var(--accent);
  font-weight: 700;
  text-transform: uppercase;
  margin-bottom: 6px;
}
.creator-name {
  font-size: 20px; font-weight: 900;
  margin-bottom: 4px;
  letter-spacing: -0.01em;
}
.creator-credential {
  font-size: 12.5px;
  color: var(--muted);
  line-height: 1.6;
  margin-bottom: 16px;
}
.creator-quote {
  font-size: 13.5px;
  line-height: 1.85;
  color: rgba(245,240,232,0.85);
  padding-top: 16px;
  border-top: 1px dashed var(--border);
  font-style: italic;
}
@media (max-width: 640px) {
  .creators-grid { grid-template-columns: 1fr; gap: 14px; }
}

/* ═══ FAQ — 手風琴 ═══ */
.faq-scene {
  padding: 100px 24px;
  width: 100vw; margin-left: calc(-50vw + 50%);
}
.faq-inner { max-width: 680px; margin: 0 auto; text-align: center; }
.faq-list {
  max-width: 640px;
  margin: 40px auto 0;
  display: flex;
  flex-direction: column;
  gap: 10px;
  text-align: left;
}
.faq-item {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 14px;
  overflow: hidden;
  backdrop-filter: blur(20px);
  transition: border-color 0.3s;
}
.faq-item.open { border-color: rgba(184,151,126,0.4); }
.faq-q {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  padding: 20px 24px;
  cursor: pointer;
  font-size: 15px;
  font-weight: 700;
  color: var(--text);
  line-height: 1.5;
  user-select: none;
  transition: color 0.25s;
}
.faq-q:hover { color: var(--accent); }
.faq-q-chevron {
  flex-shrink: 0;
  width: 18px; height: 18px;
  transition: transform 0.4s var(--spring);
  color: var(--accent);
}
.faq-item.open .faq-q-chevron { transform: rotate(180deg); }
.faq-a {
  max-height: 0;
  overflow: hidden;
  padding: 0 24px;
  transition: max-height 0.45s cubic-bezier(.4,0,.2,1), padding 0.3s ease, opacity 0.3s ease;
  font-size: 13.5px;
  line-height: 1.85;
  color: rgba(245,240,232,0.8);
  opacity: 0;
}
.faq-item.open .faq-a {
  max-height: 360px;
  padding: 0 24px 20px;
  opacity: 1;
}
.faq-a strong { color: var(--accent); }

/* ═══ Pricing Manifesto — 為什麼免費（重做：大引言 + 上下線條框住）═══ */
.pricing-scene {
  padding: 130px 24px 140px;
  text-align: center;
  max-width: 820px;
  margin: 0 auto;
}
.pricing-line {
  width: 56px;
  height: 2px;
  background: linear-gradient(90deg, transparent, var(--accent), transparent);
  margin: 0 auto 40px;
  opacity: 0.7;
}
.pricing-line.bottom { margin: 40px auto 0; }
.pricing-label {
  font-size: 11px;
  letter-spacing: 6px;
  color: var(--accent);
  font-weight: 700;
  text-transform: uppercase;
  margin-bottom: 40px;
  opacity: 0.9;
}
.pricing-quote {
  font-size: clamp(28px, 5vw, 48px);
  font-weight: 900;
  line-height: 1.6;
  max-width: 680px;
  margin: 0 auto;
  letter-spacing: -0.02em;
  color: var(--text);
}
.pricing-quote strong {
  background: linear-gradient(135deg, var(--accent), var(--accent2));
  -webkit-background-clip: text; background-clip: text;
  -webkit-text-fill-color: transparent;
  font-weight: 900;
  white-space: nowrap;
}
.pricing-byline {
  margin-top: 28px;
  font-size: 13px;
  letter-spacing: 4px;
  color: var(--muted);
  text-transform: uppercase;
  font-weight: 600;
}

/* ═══ Scarcity badge — 放在 CTA 上方 ═══ */
.scarcity-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 7px 16px;
  border-radius: 20px;
  border: 1px solid rgba(184,151,126,0.4);
  background: rgba(184,151,126,0.08);
  font-size: 11px;
  letter-spacing: 2px;
  color: var(--accent);
  font-weight: 700;
  margin-bottom: 24px;
  text-transform: uppercase;
  box-shadow: 0 0 20px rgba(184,151,126,0.12);
}
.scarcity-dot {
  width: 6px; height: 6px; border-radius: 50%;
  background: var(--accent2);
  box-shadow: 0 0 10px var(--accent2);
  animation: scarcity-pulse 2s ease-in-out infinite;
}
@keyframes scarcity-pulse {
  0%, 100% { opacity: 0.5; transform: scale(1); }
  50% { opacity: 1; transform: scale(1.2); }
}

/* Value scene — FULL WIDTH gradient background */
.value-scene {
  background: linear-gradient(180deg, rgba(184,151,126,0.1) 0%, rgba(184,151,126,0.03) 50%, transparent 100%);
  width: 100vw;
  margin-left: calc(-50vw + 50%);
  padding-left: 24px;
  padding-right: 24px;
}
.value-row {
  display: grid; grid-template-columns: 1fr 1fr;
  gap: 16px;
}
.val-card {
  background: var(--card); border: 1px solid var(--border);
  border-radius: 20px; padding: 28px 24px;
  backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
  transition: var(--transition);
  position: relative; isolation: isolate;
}
.val-card::after {
  content: ''; position: absolute; inset: -20%;
  background: radial-gradient(circle at center, rgba(184,151,126,.35), transparent 60%);
  opacity: 0; transition: opacity .5s; z-index: -1; filter: blur(30px); pointer-events: none;
}
.val-card:hover::after { opacity: 1; }
.val-card:hover {
  border-color: rgba(184,151,126,0.4);
  transform: translateY(-4px);
  box-shadow: 0 16px 48px rgba(184,151,126,0.15);
}
.val-icon { font-size: 28px; margin-bottom: 14px; }
.val-title { font-size: 16px; font-weight: 700; color: var(--text); margin-bottom: 8px; }
.val-desc { font-size: 13px; color: var(--muted); line-height: 1.6; }

/* Testimonials — horizontal scroll carousel */
.testi-track-wrap {
  width: 100vw; margin-left: calc(-50vw + 50%);
  overflow: hidden; margin-bottom: 32px;
  -webkit-mask-image: linear-gradient(90deg, transparent, black 10%, black 90%, transparent);
  mask-image: linear-gradient(90deg, transparent, black 10%, black 90%, transparent);
}
.testi-track {
  display: flex; gap: 20px;
  animation: scrollTesti 20s linear infinite;
  width: max-content;
}
.testi-track-wrap:hover .testi-track { animation-play-state: paused; }
@keyframes scrollTesti {
  0% { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}
.testi {
  background: var(--card); border: 1px solid var(--border);
  border-radius: 16px; padding: 24px; min-width: 320px; max-width: 360px;
  backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
  flex-shrink: 0;
}
.testi-header { display: flex; align-items: center; gap: 12px; margin-bottom: 14px; }
.testi-avatar {
  width: 40px; height: 40px; border-radius: 50%; object-fit: cover;
  border: 2px solid var(--border);
}
.testi-name { font-size: 13px; font-weight: 600; color: var(--text); text-align: left; }
.testi-meta { font-size: 11px; color: var(--muted); text-align: left; }
.testi-quote {
  font-size: 14px; color: var(--text); line-height: 1.7;
  font-style: normal; text-align: left;
}

/* CTA scene */
.cta-scene {
  background: radial-gradient(ellipse at center, rgba(184,151,126,0.08) 0%, transparent 70%);
}

/* Landing animations */
.land-anim {
  opacity: 0; transform: translateY(24px);
  transition: opacity 0.7s cubic-bezier(0.4,0,0.2,1), transform 0.7s var(--spring);
}
.land-anim.vis { opacity: 1; transform: none; }

/* Pain / compare cards stagger */
.pain-list .pain-item.land-anim,
.compare-grid .compare-card.land-anim,
.value-row .val-card.land-anim {
  transition-delay: 0s;
}
.pain-list .pain-item.land-anim:nth-child(1){ transition-delay: .05s; }
.pain-list .pain-item.land-anim:nth-child(2){ transition-delay: .18s; }
.pain-list .pain-item.land-anim:nth-child(3){ transition-delay: .31s; }
.pain-list .pain-item.land-anim:nth-child(4){ transition-delay: .44s; }
.compare-grid .compare-card.land-anim:nth-child(1){ transition-delay: .08s; }
.compare-grid .compare-card.land-anim:nth-child(2){ transition-delay: .22s; }
.compare-grid .compare-card.land-anim:nth-child(3){ transition-delay: .36s; }
.value-row .val-card.land-anim:nth-child(1){ transition-delay: .05s; }
.value-row .val-card.land-anim:nth-child(2){ transition-delay: .16s; }
.value-row .val-card.land-anim:nth-child(3){ transition-delay: .27s; }
.value-row .val-card.land-anim:nth-child(4){ transition-delay: .38s; }

/* Responsive */
@media (max-width: 520px) {
  .value-row { grid-template-columns: 1fr; }
  .pain-item { gap: 14px; }
}

.social-proof {
  font-size: 12px; color: var(--muted); margin-bottom: 36px;
  letter-spacing: 0.05em;
}

/* ─── Phase Screens (Change 1) ─── */
#quiz-container { display: none; }

.phase-screen {
  min-height: 100vh;
  display: flex; flex-direction: column; align-items: center; justify-content: flex-start;
  padding: 80px 20px 80px;
  text-align: center;
  animation: phase-in .45s var(--spring);
}
.phase-screen.leaving { animation: phase-out .3s cubic-bezier(.4,0,.2,1) forwards; }
@keyframes phase-in {
  from { opacity: 0; transform: translateX(24px); }
  to { opacity: 1; transform: translateX(0); }
}
@keyframes phase-out {
  to { opacity: 0; transform: translateX(-16px); }
}

.phase-header {
  margin-bottom: 32px; width: 100%; max-width: 520px;
}
.q-phase {
  font-size: 11px; letter-spacing: 3px; color: var(--accent);
  text-transform: uppercase; margin-bottom: 8px; font-weight: 600;
}
.phase-title-big {
  font-size: clamp(18px, 3.5vw, 28px); font-weight: 900; margin-bottom: 4px; line-height: 1.3;
}
.phase-progress-label {
  font-size: 12px; color: var(--muted); letter-spacing: 2px;
}

/* Individual question block within a phase */
.q-block {
  width: 100%; max-width: 520px; margin-bottom: 36px; text-align: center;
}
.q-block-title { font-size: clamp(18px, 3.5vw, 28px); font-weight: 900; margin-bottom: 8px; line-height: 1.3; }
.q-block-hint { font-size: 13px; color: var(--muted); margin-bottom: 20px; line-height: 1.6; }

/* ─── Options ─── */
.options-list { display: flex; flex-direction: column; gap: 10px; width: 100%; max-width: 520px; }

.opt-item { position: relative; }

.opt-label {
  display: flex; align-items: center; gap: 14px;
  background: var(--card); border: 1px solid var(--border);
  border-radius: var(--radius); padding: 16px 20px;
  cursor: pointer; backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
  transition: var(--transition); text-align: left;
}
.opt-label:hover {
  border-color: rgba(184,151,126,0.4);
  transform: scale(1.01);
  background: rgba(255,252,248,0.09);
}
.opt-label input { display: none; }
.opt-radio-dot {
  width: 18px; height: 18px; border-radius: 50%;
  border: 2px solid var(--border); flex-shrink: 0;
  transition: var(--transition); display: flex; align-items: center; justify-content: center;
}
.opt-check-box {
  width: 18px; height: 18px; border-radius: 5px;
  border: 2px solid var(--border); flex-shrink: 0;
  transition: var(--transition); display: flex; align-items: center; justify-content: center;
}
.opt-label.selected {
  border-color: var(--accent);
  background: rgba(184,151,126,0.12);
  box-shadow: 0 0 20px var(--glow1), inset 0 0 8px var(--glow2);
}
.opt-label.selected .opt-radio-dot {
  background: var(--accent); border-color: var(--accent);
  box-shadow: 0 0 8px var(--glow1);
}
.opt-label.selected .opt-check-box {
  background: var(--accent); border-color: var(--accent);
  box-shadow: 0 0 8px var(--glow1);
}
.opt-label.selected .opt-check-box::after { content: ''; width:8px; height:8px; border-radius:50%; background:#fff; }
.opt-text { font-size: 14px; font-weight: 500; flex: 1; }

/* Feedback */
.opt-feedback {
  font-size: 12.5px; color: rgba(245,240,232,0.75);
  background: rgba(184,151,126,0.08); border-left: 2px solid var(--accent);
  padding: 0 14px; border-radius: 0 0 var(--radius) var(--radius);
  line-height: 1.6; text-align: left;
  max-height: 0; overflow: hidden;
  transition: max-height 0.4s cubic-bezier(.4,0,.2,1), padding 0.3s ease, opacity 0.3s ease;
  opacity: 0; margin: 0;
}
.opt-feedback.show {
  max-height: 150px; opacity: 1; padding: 10px 14px; margin-bottom: 4px;
}
.opt-feedback strong { color: var(--accent2); }

/* Number Input */
.num-input-wrap {
  display: flex; align-items: center; gap: 12px;
  max-width: 220px; margin: 0 auto 24px;
}
.num-input {
  background: var(--card); border: 1px solid var(--border);
  border-radius: var(--radius); padding: 16px 20px;
  font-size: 32px; font-weight: 700; color: var(--text);
  width: 140px; text-align: center;
  backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
  outline: none; transition: var(--transition);
}
.num-input:focus { border-color: var(--accent); box-shadow: 0 0 16px var(--glow1); }
.num-unit {
  font-size: 18px; font-weight: 700; color: var(--accent);
  background: rgba(184,151,126,0.15); padding: 8px 16px; border-radius: 10px;
}
.num-feedback {
  font-size: 13px; color: rgba(245,240,232,0.7);
  margin-bottom: 20px; min-height: 24px; transition: opacity 0.4s;
}

/* Style grid */
.style-grid {
  display: grid; grid-template-columns: repeat(2,1fr);
  gap: 12px; max-width: 520px; width: 100%;
}
.style-card {
  background: var(--card); border: 1px solid var(--border);
  border-radius: var(--radius); overflow: hidden; cursor: pointer;
  transition: var(--transition); position: relative;
  backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
}
.style-card:hover { transform: scale(1.02); border-color: rgba(184,151,126,0.4); }
.style-card.selected {
  border-color: var(--accent);
  box-shadow: 0 0 24px var(--glow1);
}
.style-img {
  width: 100%; height: 110px; object-fit: cover;
  display: block; background: var(--card);
}
.style-img-placeholder {
  width: 100%; height: 110px;
  display: flex; align-items: center; justify-content: center;
  font-size: 28px; background: linear-gradient(135deg, rgba(184,151,126,0.15), rgba(212,136,106,0.1));
}
.style-label {
  padding: 10px 12px; font-size: 12px; font-weight: 600; color: var(--text);
}
.style-sub { font-size: 10px; color: var(--muted); }
.style-fb-box {
  font-size: 12px; color: rgba(245,240,232,0.75);
  background: rgba(184,151,126,0.08); border-top: 1px solid var(--border);
  padding: 0 12px; max-height: 0; overflow: hidden;
  transition: max-height 0.4s ease, padding 0.3s ease, opacity 0.3s ease; opacity: 0;
}
.style-fb-box.show { max-height: 80px; padding: 8px 12px; opacity: 1; }
.style-fb-box strong { color: var(--accent2); }
.style-check {
  position: absolute; top: 8px; right: 8px; width: 24px; height: 24px;
  border-radius: 50%; background: var(--accent); color: #fff;
  display: flex; align-items: center; justify-content: center;
  font-size: 12px; opacity: 0; transition: opacity 0.3s;
}
.style-card.selected .style-check { opacity: 1; }

/* Next Button */
.next-btn {
  margin-top: 24px;
  background: linear-gradient(135deg, var(--accent), var(--accent2));
  color: #fff; font-size: 14px; font-weight: 700;
  border: none; border-radius: 50px; padding: 13px 36px;
  cursor: pointer; transition: var(--transition);
  box-shadow: 0 0 20px var(--glow2);
}
.next-btn:hover { transform: translateY(-2px); box-shadow: 0 0 32px var(--glow1); }

/* Phase divider */
.q-divider {
  width: 100%; max-width: 520px; height: 1px;
  background: var(--border); margin: 8px 0 32px 0;
}

/* ─── Loading ─── */
#loading {
  display: none; min-height: 100vh;
  align-items: center; justify-content: center; flex-direction: column;
  gap: 32px;
}
.loading-screen-inner{
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  gap:24px;text-align:center;width:100%;max-width:420px;margin:0 auto;
}
.loading-eyebrow{
  font-size:11px;letter-spacing:6px;color:var(--accent);font-weight:800;
  text-transform:uppercase;text-align:center;
}
.loading-title {
  font-size: clamp(24px,4.5vw,32px); font-weight: 900;
  letter-spacing: 0.08em; text-align: center;
  background: linear-gradient(135deg, var(--text) 25%, var(--accent));
  -webkit-background-clip: text; -webkit-text-fill-color: transparent;
  margin: 0 auto 8px; line-height:1.3;
}
.loading-sub{
  font-size:13px;letter-spacing:2px;color:var(--muted);
  text-align:center;line-height:1.7;
}
.loading-bar{
  width:100%;height:3px;border-radius:30px;
  background:rgba(184,151,126,.15);overflow:hidden;margin:8px 0 16px;
}
.loading-bar-fill{
  height:100%;width:0;
  background:linear-gradient(90deg,var(--accent),var(--accent2));
  border-radius:30px;transition:width .8s ease;
}
.loading-steps {
  display: flex; flex-direction: column; gap: 10px;
  width: 100%; max-width: 360px; margin: 0 auto;
}
.loading-step {
  display: flex; align-items: center; gap: 14px;
  font-size: 14px; color: var(--muted);
  padding: 12px 18px; border-radius: 14px;
  background: rgba(184,151,126,.04);
  border: 1px solid transparent;
  transition: all .5s ease;
  text-align:left;letter-spacing:1.5px;
}
.loading-step.active {
  color: var(--text);
  background: rgba(184,151,126,.10);
  border-color: rgba(184,151,126,.22);
}
.loading-step.done {
  color: var(--accent);
  background: rgba(184,151,126,.06);
}
.step-icon {
  width: 26px; height: 26px; border-radius: 50%;
  border: 2px solid var(--border); flex-shrink: 0;
  display: flex; align-items: center; justify-content: center; font-size: 12px;
  transition: all 0.4s;
}
.loading-step.active .step-icon {
  border-color: var(--accent); animation: spin 1s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
.loading-step.done .step-icon {
  background: var(--accent); border-color: var(--accent); color: #fff;
  animation: none;
}

/* ══════════ ARCHETYPE CARD (5 型屋主) ══════════ */
.arch-card{
  background:#E8DCC8;
  border-radius:32px;
  position:relative;overflow:hidden;
  box-shadow:0 30px 80px rgba(0,0,0,.55),0 60px 120px rgba(212,136,106,.18),0 0 0 1px rgba(184,151,126,.22);
  isolation:isolate;
}
.arch-card::before{
  content:'';position:absolute;inset:0;pointer-events:none;z-index:0;
  background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='320' height='320'><filter id='p'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 0.30 0 0 0 0 0.22 0 0 0 0 0.14 0 0 0 0.06 0'/></filter><rect width='100%' height='100%' filter='url(%23p)'/></svg>");
  opacity:.55;mix-blend-mode:multiply;
}
.arch-card > *{position:relative;z-index:1}
.arch-card *{color:#2A2118}
.arch-hero{
  display:grid;grid-template-columns:1fr 1fr;gap:32px;
  padding:48px 48px 24px;align-items:start;
}
.arch-hero-left{display:flex;flex-direction:column;gap:18px;padding-top:8px}
.arch-hero-left .arch-tags{margin-top:auto;padding-top:12px}
.arch-owner-badge{
  display:inline-flex;align-items:center;align-self:flex-start;
  font-size:10px;letter-spacing:4px;font-weight:700;
  color:#5A4A3D;background:rgba(255,255,255,.5);
  border:1px solid rgba(28,24,21,.10);
  padding:7px 16px;border-radius:30px;
  text-transform:uppercase;
}
.arch-role-name{
  font-family:"Noto Serif TC",serif;
  font-size:46px;font-weight:900;letter-spacing:2px;line-height:1.05;
  color:#2A2118 !important;margin:4px 0 0;
}
.arch-spell-block{display:flex;flex-direction:column;gap:6px;margin-top:8px}
.arch-spell-en{
  font-size:11px;letter-spacing:6px;color:#B8977E !important;
  font-weight:800;text-transform:uppercase;
  font-family:"Archivo Black","Inter",sans-serif;
}
.arch-spell-zh{
  font-family:"Noto Serif TC",serif;
  font-size:28px;font-weight:900;letter-spacing:6px;
  color:#2A2118 !important;line-height:1.1;
}
.arch-spell-quote{
  font-family:"Noto Serif TC",serif;
  font-size:13.5px;color:#5A4A3D !important;
  font-style:italic;letter-spacing:1px;line-height:1.7;
  margin-top:10px;display:flex;align-items:flex-start;gap:6px;
  position:relative;
}
.arch-spell-quote::before{
  content:'\201C';font-size:32px;line-height:.6;color:#B8977E;
  font-style:normal;font-weight:900;font-family:"Noto Serif TC",serif;
  flex-shrink:0;margin-top:8px;
}
.arch-spell-quote::after{
  content:'\201D';font-size:32px;line-height:0;color:#B8977E;
  font-style:normal;font-weight:900;font-family:"Noto Serif TC",serif;
  flex-shrink:0;align-self:flex-end;margin-bottom:-8px;
}
.arch-tags{display:flex;flex-wrap:nowrap;gap:6px;margin-top:8px;white-space:nowrap}
.arch-tag{
  display:inline-flex;align-items:center;gap:5px;
  font-size:11px;letter-spacing:.5px;
  color:#5A4A3D !important;font-weight:700;
  background:rgba(255,255,255,.5);
  border:1px solid rgba(28,24,21,.08);
  padding:6px 11px;border-radius:30px;
  flex-shrink:0;
}
.arch-tag::before{content:'# '}
.arch-dual-report{
  margin-top:16px;background:rgba(255,255,255,.5);
  border:1px solid rgba(28,24,21,.08);border-radius:12px;
  padding:10px 14px;display:flex;flex-direction:column;gap:6px;
}
.arch-dual-row{
  display:grid;grid-template-columns:auto 1fr auto;gap:10px;
  font-size:12px;align-items:center;
}
.arch-dual-label{
  color:#5A4A3D !important;letter-spacing:2px;font-weight:700;font-size:10px;
}
.arch-dual-name{
  color:#2A2118 !important;font-weight:800;font-family:"Noto Serif TC",serif;font-size:13px;
}
.arch-dual-pct{
  color:#D4886A !important;font-weight:900;
  font-variant-numeric:tabular-nums;font-size:13px;
}
.arch-character-frame{
  border-radius:24px;aspect-ratio:1/1.05;
  position:relative;overflow:hidden;
  background:#FBF6EE;border:1px solid rgba(184,151,126,.18);
  box-shadow:0 12px 30px rgba(28,24,21,.08);
}
.arch-char-image-area{
  position:relative;height:100%;width:100%;overflow:hidden;border-radius:24px;
}
.arch-char-image-area img{
  width:100%;height:100%;display:block;
  object-fit:cover;object-position:center center;
}
.arch-character-fallback{
  position:absolute;inset:0;display:flex;flex-direction:column;
  align-items:center;justify-content:center;gap:8px;
  color:rgba(28,24,21,.55) !important;
  font-size:13px;letter-spacing:2px;text-align:center;line-height:1.6;
  padding:24px;
}
.arch-fb-icon{font-size:48px;opacity:.5}
.arch-section-stack{
  margin:24px 48px 0;display:flex;flex-direction:column;gap:18px;
}
.arch-section-card{
  background:#FFFEFC;
  border:1px solid rgba(28,24,21,.10);
  border-radius:22px;
  padding:28px 28px 28px 100px;
  position:relative;overflow:hidden;
  box-shadow:0 8px 24px rgba(28,24,21,.06);
  min-height:140px;
  display:flex;flex-direction:column;justify-content:center;gap:10px;
}
.arch-section-card.arch-warn{
  background:#FFF5EE;
  border-color:rgba(184,90,58,.18);
}
.arch-big-icon{
  position:absolute;left:28px;top:28px;
  width:54px;height:54px;border-radius:50%;
  background:linear-gradient(135deg,#B8977E,#D4886A);
  display:flex;align-items:center;justify-content:center;
  color:#fff !important;font-size:24px;font-weight:900;
  box-shadow:0 6px 16px rgba(184,151,126,.4);
}
.arch-section-card.arch-warn .arch-big-icon{
  background:linear-gradient(135deg,#B85A3A,#D8704E);
  box-shadow:0 6px 16px rgba(184,90,58,.35);
}
.arch-section-title{
  font-family:"Noto Serif TC",serif;
  font-size:22px;font-weight:900;letter-spacing:2px;
  color:#2A2118 !important;
}
.arch-section-text{
  font-size:17px;line-height:1.9;
  color:#2A2118 !important;letter-spacing:.5px;
}
.arch-section-text strong{color:#D4886A !important;font-weight:700}
.arch-section-card.arch-warn .arch-section-text strong{color:#B85A3A !important}
.arch-pairing{
  margin:18px 48px 32px;
  background:#F4EAD8;
  border:1px solid rgba(184,151,126,.22);
  border-radius:22px;padding:22px 28px;
  display:grid;grid-template-columns:auto 1fr;align-items:center;gap:28px;
  box-shadow:0 8px 24px rgba(28,24,21,.06);
}
.arch-pair-label{display:flex;flex-direction:column;gap:2px;flex-shrink:0}
.arch-pair-label-title{
  font-size:15px;letter-spacing:2px;color:#2A2118 !important;font-weight:800;
}
.arch-pair-label-sub{
  font-size:11px;letter-spacing:2px;color:#5A4A3D !important;font-weight:600;
}
.arch-pair-list{display:flex;gap:16px;flex-wrap:wrap;justify-content:center}
.arch-pair-chip{
  display:flex;align-items:center;gap:13px;
  background:#fff;
  border:1px solid rgba(28,24,21,.10);
  border-radius:48px;padding:8px 22px 8px 8px;
}
.arch-pair-avatar{
  width:64px;height:64px;border-radius:50%;
  overflow:hidden;flex-shrink:0;
  background:linear-gradient(135deg,#FFFFFF 0%,#FBF6EE 100%);
  border:2px solid #fff;
  box-shadow:0 2px 8px rgba(28,24,21,.12);
  position:relative;
}
.arch-pair-avatar img{
  width:100%;height:100%;
  object-fit:cover;object-position:center 28%;
  display:block;
}
.arch-pair-name{
  font-size:16px;font-weight:700;color:#2A2118 !important;
  letter-spacing:1px;line-height:1.25;
  display:flex;flex-direction:column;gap:2px;
}
.arch-pair-name small{
  font-size:12px;color:#5A4A3D !important;
  font-weight:600;letter-spacing:1.5px;
}

/* Archetype share button + footer */
.arch-share-btn{
  display:flex;align-items:center;gap:14px;
  margin:0 48px 4px;width:calc(100% - 96px);
  padding:18px 24px;
  border:none;cursor:pointer;
  border-radius:18px;
  background:linear-gradient(135deg,#B8977E,#D4886A);
  color:#fff !important;text-align:left;
  font-family:inherit;
  box-shadow:0 10px 28px rgba(184,151,126,.4);
  transition:transform .2s ease,box-shadow .2s ease;
}
.arch-share-btn:hover{
  transform:translateY(-2px);
  box-shadow:0 14px 36px rgba(184,151,126,.5);
}
.arch-share-btn:active{transform:translateY(0)}
.arch-share-icon{
  width:42px;height:42px;border-radius:50%;
  background:rgba(255,255,255,.18);
  display:flex;align-items:center;justify-content:center;
  flex-shrink:0;color:#fff !important;
}
.arch-share-icon svg{width:20px;height:20px}
.arch-share-text{display:flex;flex-direction:column;gap:2px;flex:1;color:#fff !important}
.arch-share-title{font-size:15px;font-weight:800;letter-spacing:2px;color:#fff !important}
.arch-share-sub{font-size:11px;letter-spacing:1px;opacity:.9;color:#fff !important}
.arch-share-arrow{font-size:18px;font-weight:900;color:#fff !important}

.arch-card-footer{
  margin:24px 48px 32px;padding-top:18px;
  display:flex;justify-content:space-between;align-items:center;
  border-top:1px solid rgba(28,24,21,.10);
  font-size:10.5px;letter-spacing:3px;font-weight:700;
  text-transform:uppercase;
}
.arch-card-footer-brand{
  display:flex;align-items:center;gap:8px;
  color:#5A4A3D !important;
}
.arch-card-footer-type{color:#5A4A3D !important}

/* ── ARCHETYPE CARD 手機版（保留桌機版面結構、等比縮小所有尺寸） ── */
@media (max-width: 640px) {
  .arch-card{ border-radius:22px; }

  /* hero：標題左 + 角色右（grid 兩欄維持） */
  .arch-hero{ padding:22px 18px 14px; gap:12px; }
  .arch-hero-left{ gap:8px; padding-top:2px; }
  .arch-owner-badge{ font-size:8px; letter-spacing:2.5px; padding:5px 11px; }
  .arch-role-name{ font-size:28px; letter-spacing:1px; margin:2px 0 0; }
  .arch-spell-block{ gap:4px; margin-top:4px; }
  .arch-spell-en{ font-size:9px; letter-spacing:4px; }
  .arch-spell-zh{ font-size:18px; letter-spacing:3px; }
  .arch-spell-quote{ font-size:10.5px; letter-spacing:.3px; line-height:1.6; margin-top:4px; gap:4px; }
  .arch-spell-quote::before{ font-size:20px; margin-top:5px; }
  .arch-spell-quote::after{ font-size:20px; margin-bottom:-5px; }
  .arch-tags{ gap:4px; flex-wrap:wrap; white-space:normal; padding-top:6px; }
  .arch-tag{ font-size:9px; padding:4px 8px; letter-spacing:.3px; gap:3px; }

  /* 絕招特徵 / 容易卡關：水平等寬卡片（維持桌機版面） */
  .arch-section-stack{ margin:14px 18px 0; gap:10px; }
  .arch-section-card{ padding:16px 16px 16px 58px; min-height:80px; border-radius:16px; gap:5px; }
  .arch-big-icon{ left:14px; top:14px; width:32px; height:32px; }
  .arch-big-icon svg{ width:14px; height:14px; }
  .arch-section-title{ font-size:14.5px; letter-spacing:1px; }
  .arch-section-text{ font-size:12.5px; line-height:1.75; letter-spacing:.2px; }

  /* 黃金搭檔：水平兩個 chip（維持桌機版面） */
  .arch-pairing{ margin:12px 18px 18px; padding:14px 14px; gap:10px; border-radius:16px;
    grid-template-columns:auto 1fr; }
  .arch-pair-label-title{ font-size:11px; letter-spacing:1px; }
  .arch-pair-label-sub{ font-size:8.5px; letter-spacing:1px; }
  .arch-pair-list{ gap:6px; }
  .arch-pair-chip{ padding:4px 11px 4px 4px; gap:7px; border-radius:30px; }
  .arch-pair-avatar{ width:32px; height:32px; border-width:1.5px; }
  .arch-pair-name{ font-size:10.5px; letter-spacing:.3px; gap:1px; }
  .arch-pair-name small{ font-size:8.5px; letter-spacing:.4px; }

  /* 分享按鈕 */
  .arch-share-btn{ margin:0 18px 4px; width:calc(100% - 36px); padding:13px 14px; gap:10px; border-radius:13px; }
  .arch-share-icon{ width:30px; height:30px; }
  .arch-share-icon svg{ width:15px; height:15px; }
  .arch-share-title{ font-size:11.5px; letter-spacing:1px; }
  .arch-share-sub{ font-size:9px; letter-spacing:.3px; }
  .arch-share-arrow{ font-size:15px; }

  /* footer */
  .arch-card-footer{ margin:14px 18px 18px; padding-top:12px; font-size:8.5px; letter-spacing:2px; }
}

/* ── 超窄螢幕（iPhone SE / 360px 以下）：再瘦一階，避免黃金搭檔擠不下 ── */
@media (max-width: 380px) {
  .arch-role-name{ font-size:25px; }
  .arch-spell-zh{ font-size:16px; letter-spacing:2.5px; }
  .arch-pairing{ padding:12px 12px; gap:8px; }
  .arch-pair-list{ gap:4px; flex-wrap:wrap; }
  .arch-pair-chip{ padding:3px 9px 3px 3px; gap:6px; }
  .arch-pair-avatar{ width:28px; height:28px; }
  .arch-pair-name{ font-size:10px; }
  .arch-pair-name small{ font-size:8px; }
}

/* ─── Results ─── */
#results { display: none; padding: 60px 20px 80px; }
.results-inner { max-width: 680px; margin: 0 auto; }

/* Scroll fade-in */
.fade-in { opacity: 0; transform: translateY(30px); transition: opacity 0.7s ease, transform 0.7s ease; }
.fade-in.visible { opacity: 1; transform: none; }

.section-gap { margin-bottom: 24px; }

/* Personality Banner */
.personality-banner {
  background: linear-gradient(135deg, rgba(184,151,126,0.25), rgba(212,136,106,0.15));
  border: 1px solid var(--accent);
  border-radius: 24px; padding: 36px 28px; text-align: center; margin-bottom: 24px;
  backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
  box-shadow: 0 0 40px var(--glow2);
}
.personality-emoji {
  display: inline-flex;
  align-items: center; justify-content: center;
  width: 72px; height: 72px;
  margin: 0 auto 16px;
  font-size: 40px; font-weight: 900;
  color: transparent;
  -webkit-text-stroke: 1.5px var(--accent);
  border: 1.5px solid var(--accent);
  border-radius: 50%;
  background: rgba(184,151,126,0.06);
  letter-spacing: 0;
  line-height: 1;
  font-variant-numeric: tabular-nums;
}
.personality-type { font-size: 24px; font-weight: 900; color: var(--accent); margin-bottom: 8px; }
.personality-tagline { font-size: 15px; color: var(--muted); line-height: 1.6; margin-bottom: 16px; }
/* Change 5: long personality paragraph */
.personality-desc {
  font-size: 14px; color: rgba(245,240,232,0.8); line-height: 1.8;
  text-align: left; padding: 16px 20px;
  background: rgba(184,151,126,0.08); border-radius: 12px;
  border-left: 3px solid var(--accent);
}

/* Glass cards */
.glass-card {
  background: var(--card); border: 1px solid var(--border);
  border-radius: var(--radius); padding: 24px;
  backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
  margin-bottom: 16px;
}
.card-label {
  font-size: 10px; letter-spacing: 3px; color: var(--accent);
  text-transform: uppercase; font-weight: 600; margin-bottom: 12px;
}
.card-title { font-size: 18px; font-weight: 700; margin-bottom: 8px; }
.card-body { font-size: 14px; color: var(--muted); line-height: 1.7; }

/* Overview grid */
.overview-grid {
  display: grid; grid-template-columns: repeat(2,1fr); gap: 12px; margin-bottom: 16px;
}
.overview-tile {
  background: var(--card); border: 1px solid var(--border);
  border-radius: var(--radius); padding: 18px 16px; text-align: center;
  backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
}
.ov-val { font-size: 26px; font-weight: 900; color: var(--accent); }
.ov-key { font-size: 11px; color: var(--muted); margin-top: 4px; letter-spacing: 0.05em; }

/* Budget bars */
.budget-item { margin-bottom: 16px; }
.budget-row { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 6px; }
.budget-name { font-size: 13px; font-weight: 600; }
.budget-amount { font-size: 13px; color: var(--accent); font-weight: 700; }
.budget-bar-bg { height: 8px; background: rgba(184,151,126,0.1); border-radius: 4px; overflow: hidden; }
.budget-bar {
  height: 100%; border-radius: 4px;
  background: linear-gradient(90deg, var(--accent), var(--accent2));
  width: 0%; transition: width 1.1s cubic-bezier(.34,1.42,.64,1);
  box-shadow: 0 0 8px var(--glow2);
}

/* Timeline */
.timeline { display: flex; gap: 0; margin-bottom: 8px; }
.tl-phase {
  flex: 1; text-align: center; position: relative; padding: 16px 8px;
  background: var(--card); border: 1px solid var(--border);
  backdrop-filter: blur(20px);
}
.tl-phase:first-child { border-radius: var(--radius) 0 0 var(--radius); }
.tl-phase:last-child { border-radius: 0 var(--radius) var(--radius) 0; }
.tl-num { font-size: 10px; color: var(--accent); font-weight: 700; letter-spacing: 1px; }
.tl-name { font-size: 12px; font-weight: 700; margin: 4px 0; }
.tl-dur { font-size: 12px; color: var(--accent); font-weight: 600; margin-bottom: 6px; }
.tl-detail { font-size: 12px; color: var(--text); line-height: 1.6; margin-bottom: 4px; }
.tl-note { font-size: 11px; color: var(--accent2); line-height: 1.5; font-style: italic; }

/* Modules - Change 3: detailed module cards */
.module-tag {
  display: inline-flex; align-items: center; gap: 6px;
  background: rgba(184,151,126,0.15); border: 1px solid var(--border);
  border-radius: 20px; padding: 6px 14px; font-size: 12px;
  margin: 4px; color: var(--accent);
}
.module-detail-card {
  background: rgba(184,151,126,0.07); border: 1px solid rgba(184,151,126,0.2);
  border-radius: var(--radius); padding: 18px 20px; margin-bottom: 12px;
}
.module-detail-card .mod-title {
  font-size: 15px; font-weight: 700; color: var(--accent); margin-bottom: 10px;
}
.module-detail-card .mod-item {
  font-size: 13px; color: rgba(245,240,232,0.82); line-height: 1.8; margin-bottom: 4px;
}
.module-detail-card .mod-item strong { color: var(--accent2); }

/* ─── Change 4: Flip Cards ─── */
.flip-hint {
  font-size: 12px; color: var(--muted); margin-bottom: 12px; text-align: center;
}
.save-cols { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
.save-col { background: var(--card); border: 1px solid var(--border); border-radius: var(--radius); padding: 18px; backdrop-filter: blur(20px); }
.save-col.save { border-color: rgba(100,180,100,0.3); }
.save-col.nosave { border-color: rgba(220,100,80,0.3); }
.save-col-title { font-size: 12px; font-weight: 700; margin-bottom: 12px; }
.save-col.save .save-col-title { color: #7dcb7d; }
.save-col.nosave .save-col-title { color: #e07b6a; }

/* Flip cards — expand/collapse with chevron rotation */
.flip-card {
  cursor: pointer;
  margin-bottom: 8px;
}
.flip-inner {
  border-radius: 12px;
  overflow: hidden;
  transition: all 0.4s var(--spring);
}
.flip-front {
  padding: 12px 14px;
  font-size: 12px;
  font-weight: 600;
  color: #fff;
  line-height: 1.5;
  display: flex;
  align-items: center;
  justify-content: space-between;
  transition: background .3s ease;
}
.flip-front::after {
  content: '';
  width: 14px; height: 14px;
  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='white' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><polyline points='6 9 12 15 18 9'/></svg>");
  background-size: contain;
  background-repeat: no-repeat;
  opacity: 0.7;
  transition: transform 0.4s var(--spring), opacity .3s ease;
}
.flip-card.flipped .flip-front::after {
  transform: rotate(180deg);
  opacity: 1;
}
.flip-back {
  max-height: 0;
  overflow: hidden;
  padding: 0 14px;
  font-size: 12px;
  line-height: 1.7;
  color: var(--text);
  transition: max-height 0.45s cubic-bezier(.4,0,.2,1), padding 0.35s ease, opacity .3s ease;
  opacity: 0;
}
.flip-card.flipped .flip-back {
  max-height: 220px;
  padding: 10px 14px 12px;
  opacity: 1;
}
.save-col.save .flip-front {
  background: rgba(100,180,100,0.25);
  border: 1px solid rgba(100,180,100,0.3);
  border-radius: 12px 12px 12px 12px;
}
.save-col.save .flip-card.flipped .flip-front {
  border-radius: 12px 12px 0 0;
}
.save-col.nosave .flip-front {
  background: rgba(220,100,80,0.25);
  border: 1px solid rgba(220,100,80,0.3);
  border-radius: 12px;
}
.save-col.nosave .flip-card.flipped .flip-front {
  border-radius: 12px 12px 0 0;
}
.save-col.save .flip-back {
  background: rgba(100,180,100,0.1);
  border: 1px solid rgba(100,180,100,0.2);
  border-top: none;
  border-radius: 0 0 12px 12px;
}
.save-col.nosave .flip-back {
  background: rgba(220,100,80,0.1);
  border: 1px solid rgba(220,100,80,0.2);
  border-top: none;
  border-radius: 0 0 12px 12px;
}

/* Special notice card (no flip) */
.save-item-special {
  font-size: 12px; color: var(--accent2); margin-bottom: 6px;
  padding: 10px 14px; border-radius: 12px;
  background: rgba(212,136,106,0.12); border: 1px solid rgba(212,136,106,0.25);
  line-height: 1.5;
}

/* ─── Change 2: Style result image ─── */
.style-result-card {
  margin-bottom: 16px; overflow: hidden;
  background: var(--card); border: 1px solid var(--border);
  border-radius: var(--radius);
  backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
}
.style-result-img-wrap { position: relative; }
.style-result-img {
  width: 100%; height: 200px; object-fit: cover; display: block;
}
.style-result-img-placeholder {
  width: 100%; height: 200px;
  display: flex; align-items: center; justify-content: center;
  font-size: 88px; font-weight: 900;
  color: transparent;
  -webkit-text-stroke: 1.5px var(--accent);
  letter-spacing: -0.02em;
}
.style-result-caption {
  padding: 16px 20px 6px; font-size: 13px; font-weight: 700; color: var(--accent);
  letter-spacing: 0.05em;
}
.style-result-body { padding: 20px 24px 24px; display:flex; flex-direction:column; gap:12px; }
.style-result-body .card-body { font-size: 14px; color: var(--muted); line-height: 1.7; }
/* Style result — 新排版 */
.style-result-img { height: 280px !important; }
.style-result-overlay {
  position:absolute; left:24px; right:24px; bottom:20px; z-index:2;
  display:flex; flex-direction:column; gap:4px;
  text-shadow: 0 2px 12px rgba(0,0,0,.6);
}
.style-result-img-wrap::after {
  content:''; position:absolute; inset:0; pointer-events:none; z-index:1;
  background: linear-gradient(180deg, rgba(28,24,21,0) 40%, rgba(28,24,21,0.7) 100%);
}
.style-result-eyebrow {
  font-size:10px; letter-spacing:5px; font-weight:800;
  color: rgba(245,240,232,.8); text-transform:uppercase;
}
.style-result-headline {
  font-family: "Noto Serif TC", serif;
  font-size: 30px; font-weight: 900; letter-spacing: 4px;
  color: #fff;
}
.style-result-row {
  display:grid; grid-template-columns: 84px 1fr; gap:14px; align-items:flex-start;
  padding: 10px 0; border-top: 1px dashed rgba(184,151,126,.18);
}
.style-result-row:first-child { border-top:none; padding-top:0; }
.style-result-label {
  font-size:11px; letter-spacing:3px; color: var(--accent);
  font-weight:800; padding-top: 3px; text-transform:uppercase;
}
.style-result-value {
  font-size:14px; line-height:1.75; color: var(--text);
}
.style-result-warn {
  margin-top: 4px; padding: 12px 14px; border-radius: 12px;
  background: rgba(184,90,58,.10); border: 1px solid rgba(184,90,58,.25);
  color: var(--accent2); font-size: 13px; line-height: 1.7;
}

/* ══════════ EMAIL GATE + LOCKED ZONE ══════════ */
.email-gate-banner {
  margin: 32px 0 24px;
  border-radius: 22px;
  background: linear-gradient(135deg, rgba(184,151,126,.18), rgba(212,136,106,.14));
  border: 1px solid rgba(184,151,126,.32);
  padding: 28px 28px 24px;
  position: relative; overflow: hidden;
