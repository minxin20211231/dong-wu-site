}
.email-reminder-title {
  font-family: "Noto Serif TC", serif;
  font-size: 22px; font-weight: 900; letter-spacing: 2px;
  color: var(--text); margin-bottom: 10px;
}
.email-reminder-sub {
  font-size: 13px; color: var(--muted); line-height: 1.85; letter-spacing: .5px;
  margin-bottom: 18px;
}
.email-reminder-form {
  display: grid; grid-template-columns: 1fr; gap: 10px;
  max-width: 440px; margin: 0 auto;
}
.email-reminder-form input {
  height: 46px; padding: 0 18px; border-radius: 12px;
  background: rgba(28,24,21,.55);
  border: 1px solid rgba(184,151,126,.32);
  color: var(--text); font-size: 14px; outline: none;
  font-family: inherit;
}
.email-reminder-form input:focus {
  border-color: var(--accent);
  background: rgba(28,24,21,.7);
}
.email-reminder-form input::placeholder { color: rgba(245,240,232,.4); }
.email-reminder-form button {
  width: 100%; height: 50px; padding: 0 20px;
  border: none; cursor: pointer; border-radius: 12px;
  background: linear-gradient(135deg, var(--accent), var(--accent2));
  color: #fff; font-size: 15px; font-weight: 800;
  letter-spacing: 1.5px;
  display: inline-flex; align-items: center; justify-content: center; gap: 8px;
  box-shadow: 0 8px 20px rgba(184,151,126,.45);
  transition: transform .15s ease;
  font-family: inherit; white-space: nowrap;
}
.email-reminder-form button:hover { transform: translateY(-1px); }
.email-reminder-form button span { font-size: 18px; }
.email-reminder-tiny {
  font-size: 11px; color: rgba(245,240,232,.45);
  letter-spacing: 1px; margin-top: 14px;
}
.email-reminder-bottom.sent {
  background: linear-gradient(135deg, rgba(107,143,90,.18), rgba(107,143,90,.10));
  border-color: rgba(107,143,90,.4);
}

.email-gate-banner.sent {
  background: linear-gradient(135deg, rgba(107,143,90,.18), rgba(107,143,90,.10));
  border-color: rgba(107,143,90,.4);
}
.email-gate-banner.sent .email-gate-icon {
  background: linear-gradient(135deg, #6B8F5A, #8FA677);
}

/* ══════════ Locked zone — 章節編號 + 第一段可見 + 後面 blur + 鎖頭 ══════════ */
.locked-zone.locked { counter-reset: locked-chapter; }
.locked-zone.locked > [data-chapter]:not(.card-label) {
  position: relative;
  counter-increment: locked-chapter;
  padding-top: 64px !important;
}
/* card-label 是小標題 row，不要套鎖頭+編號 */
.locked-zone.locked > .card-label[data-chapter] {
  padding-top: 0;
}
.locked-zone.locked > .card-label[data-chapter]::before,
.locked-zone.locked > .card-label[data-chapter]::after {
  display: none;
}
/* 章節編號圓圈 (左上) */
.locked-zone.locked > [data-chapter]:not(.card-label)::before {
  content: counter(locked-chapter);
  position: absolute;
  top: 22px; left: 22px;
  width: 34px; height: 34px;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--accent), var(--accent2));
  color: #fff;
  display: flex; align-items: center; justify-content: center;
  font-weight: 900; font-size: 15px;
  font-family: "Noto Serif TC", serif;
  box-shadow: 0 4px 10px rgba(184,151,126,.4);
  z-index: 3;
}
/* 鎖頭 SVG (右上) */
.locked-zone.locked > [data-chapter]:not(.card-label)::after {
  content: '';
  position: absolute;
  top: 24px; right: 24px;
  width: 28px; height: 28px;
  background-color: rgba(245,240,232,.55);
  -webkit-mask: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='white' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><rect x='5' y='11' width='14' height='10' rx='2'/><path d='M8 11V7a4 4 0 0 1 8 0v4'/></svg>") center/contain no-repeat;
  mask: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='white' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><rect x='5' y='11' width='14' height='10' rx='2'/><path d='M8 11V7a4 4 0 0 1 8 0v4'/></svg>") center/contain no-repeat;
  z-index: 3;
}
/* 第 1 個 child（標題 / card-label）— 可見 */
/* 第 2 個 child（第一段內容）— 可見 */
/* 從第 3 個 child 起 — blur（含包裹層內的後續子元素）*/
.locked-zone.locked > [data-chapter] > *:nth-child(n+3),
.locked-zone.locked > [data-chapter] > *:nth-child(2) > *:nth-child(n+2),
.locked-zone.locked > [data-chapter] > *:nth-child(2) > *:nth-child(1) > *:nth-child(n+2),
.locked-zone.locked > [data-chapter] > .personal-tip:nth-of-type(n+2),
.locked-zone.locked > [data-chapter] > .budget-item:nth-of-type(n+2),
.locked-zone.locked > [data-chapter] > .phase-col:nth-of-type(n+2),
.locked-zone.locked > [data-chapter] > .module-detail-card:nth-of-type(n+2),
.locked-zone.locked > [data-chapter] > .action-step:nth-of-type(n+2),
.locked-zone.locked > [data-chapter] > .save-item:nth-of-type(n+2),
.locked-zone.locked > [data-chapter] > .tl-phase:nth-of-type(n+2),
.locked-zone.locked > [data-chapter] [class*="card-body"]:not(:first-of-type),
.locked-zone.locked > [data-chapter] .budget-item:not(:first-of-type),
.locked-zone.locked > [data-chapter] .personal-tip:not(:first-of-type),
.locked-zone.locked > [data-chapter] .phase-col:not(:first-of-type),
.locked-zone.locked > [data-chapter] .module-detail-card:not(:first-of-type),
.locked-zone.locked > [data-chapter] .storage-item:not(:first-of-type),
.locked-zone.locked > [data-chapter] .tl-phase:not(:first-of-type) {
  filter: blur(7px);
  -webkit-filter: blur(7px);
  user-select: none;
  pointer-events: none;
  transition: filter .6s ease;
}
/* 解鎖後恢復 */
.locked-zone:not(.locked) > [data-chapter] > *:nth-child(n+3),
.locked-zone:not(.locked) > [data-chapter] > *:nth-child(2) > *:nth-child(n+2),
.locked-zone:not(.locked) > [data-chapter] > *:nth-child(2) > *:nth-child(1) > *:nth-child(n+2),
.locked-zone:not(.locked) > [data-chapter] [class*="card-body"]:not(:first-of-type),
.locked-zone:not(.locked) > [data-chapter] .budget-item:not(:first-of-type),
.locked-zone:not(.locked) > [data-chapter] .personal-tip:not(:first-of-type),
.locked-zone:not(.locked) > [data-chapter] .phase-col:not(:first-of-type),
.locked-zone:not(.locked) > [data-chapter] .module-detail-card:not(:first-of-type),
.locked-zone:not(.locked) > [data-chapter] .storage-item:not(:first-of-type),
.locked-zone:not(.locked) > [data-chapter] .tl-phase:not(:first-of-type) {
  filter: none;
  user-select: auto;
  pointer-events: auto;
}
.locked-zone:not(.locked) > [data-chapter]::before,
.locked-zone:not(.locked) > [data-chapter]::after {
  display: none;
}
.unlock-anim > [data-chapter] {
  animation: unlockReveal .8s ease forwards;
}
@keyframes unlockReveal {
  0% { opacity: .6; }
  100% { opacity: 1; }
}

/* ─── Render Gallery ─── */
.render-slot { position: relative; border-radius: 16px; overflow: hidden; }
.render-img-wrap { position: relative; }
.render-overlay {
  position: absolute; bottom: 0; left: 0; right: 0;
  padding: 16px; background: linear-gradient(transparent, rgba(28,24,21,0.8));
  display: flex; justify-content: space-between; align-items: flex-end;
}
.render-badge {
  background: var(--accent); color: #fff; font-size: 10px; font-weight: 700;
  padding: 4px 10px; border-radius: 10px; letter-spacing: 0.5px;
}
.render-caption { font-size: 13px; font-weight: 600; color: #fff; }
.render-meta {
  display: flex; justify-content: space-between; align-items: center;
  padding: 10px 4px; font-size: 11px;
}
.render-empty {
  border: 2px dashed var(--border); border-radius: 16px;
  cursor: pointer; transition: all 0.3s;
}
.render-empty:hover {
  border-color: var(--accent);
  background: rgba(184,151,126,0.05);
  transform: translateY(-2px);
}
.render-placeholder {
  padding: 40px 20px; text-align: center;
}
.render-generating {
  padding: 40px 20px; text-align: center;
  background: rgba(184,151,126,0.05);
}

/* Render dots */
.rdot {
  width: 8px; height: 8px; border-radius: 50%;
  border: 1.5px solid var(--border); transition: all 0.3s;
}
.rdot.used { background: var(--accent); border-color: var(--accent); }

/* Personal tips — referencing user's answers */
.personal-tip {
  background: rgba(184,151,126,0.06);
  border-left: 3px solid var(--accent);
  border-radius: 0 12px 12px 0;
  padding: 14px 16px;
}
.tip-ref {
  font-size: 12px; font-weight: 600; color: var(--accent);
  margin-bottom: 6px; letter-spacing: 0.03em;
}
.tip-content {
  font-size: 13px; color: rgba(245,240,232,0.8);
  line-height: 1.7;
}
.tip-content strong { color: var(--text); }

/* Action steps */
.action-step {
  display: flex; align-items: flex-start; gap: 14px;
  background: var(--card); border: 1px solid var(--border);
  border-radius: var(--radius); padding: 18px; margin-bottom: 12px;
  backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
}
.action-num {
  width: 32px; height: 32px; border-radius: 50%; flex-shrink: 0;
  background: linear-gradient(135deg, var(--accent), var(--accent2));
  display: flex; align-items: center; justify-content: center;
  font-size: 13px; font-weight: 900; color: #fff;
}
.action-text { font-size: 14px; line-height: 1.6; color: var(--text); }

/* Pro blur */
.pro-blur {
  position: relative; overflow: hidden;
  background: var(--card); border: 1px solid var(--border);
  border-radius: var(--radius); padding: 24px;
  backdrop-filter: blur(20px);
}
.pro-blur-overlay {
  position: absolute; inset: 0; backdrop-filter: blur(6px);
  background: rgba(28,24,21,0.5); border-radius: var(--radius);
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px;
  z-index: 2;
}
.pro-label { font-size: 18px; font-weight: 900; color: var(--accent); }
.pro-sub { font-size: 13px; color: var(--muted); }
.pro-cta {
  background: linear-gradient(135deg, var(--accent), var(--accent2));
  color: #fff; border: none; border-radius: 50px; padding: 12px 28px;
  font-size: 14px; font-weight: 700; cursor: pointer; margin-top: 4px;
  box-shadow: 0 0 20px var(--glow1);
}
.pro-blur-content { filter: blur(4px); user-select: none; pointer-events: none; }

/* Scroll Animations via JS */
.anim-in {
  opacity: 0; transform: translateY(28px);
  transition: opacity 0.65s ease, transform 0.65s ease;
}
.anim-in.visible { opacity: 1; transform: none; }

/* Responsive */
@media (max-width: 500px) {
  .value-grid { grid-template-columns: 1fr 1fr; }
  .style-grid { grid-template-columns: 1fr 1fr; }
  .overview-grid { grid-template-columns: 1fr 1fr; }
  .save-cols { grid-template-columns: 1fr; }
  .timeline { flex-direction: column; gap: 8px; }
  .tl-phase { border-radius: var(--radius) !important; }
  .q-block-title { font-size: 20px; }
  .phase-title-big { font-size: 18px; }
}

/* Results branding */
.results-brand {
  text-align: center; margin-bottom: 32px;
}
.results-brand-label {
  font-size: 11px; letter-spacing: 4px; color: var(--accent); font-weight: 600;
}
.results-brand-title { font-size: 22px; font-weight: 900; margin-top: 6px; }

/* Back button in quiz */
.phase-back {
  background: none; border: 1px solid var(--border); border-radius: 50px;
  color: var(--muted); font-size: 13px; padding: 8px 20px; cursor: pointer;
  transition: var(--transition); margin-right: 10px;
}
.phase-back:hover { border-color: var(--accent); color: var(--accent); }

.phase-nav { display: flex; justify-content: center; align-items: center; gap: 10px; margin-top: 24px; }

/* Share / Download buttons */
.result-actions {
  display: flex; gap: 10px; justify-content: center; flex-wrap: wrap;
  margin: 24px 0;
}
.result-action-btn {
  display: flex; align-items: center; gap: 6px;
  padding: 12px 20px; border-radius: 12px; font-size: 13px; font-weight: 600;
  cursor: pointer; transition: var(--transition); border: none;
}
.result-action-btn.primary {
  background: linear-gradient(135deg, var(--accent), var(--accent2));
  color: #fff; box-shadow: 0 0 16px var(--glow1);
}
.result-action-btn.primary:hover { transform: translateY(-2px); box-shadow: 0 0 28px var(--glow1); }
.result-action-btn.secondary {
  background: var(--card); border: 1px solid var(--border);
  color: var(--text); backdrop-filter: blur(20px);
}
.result-action-btn.secondary:hover { border-color: var(--accent); color: var(--accent); }

/* Lead capture card */
.lead-card {
  background: linear-gradient(135deg, rgba(184,151,126,0.2), rgba(212,136,106,0.1));
  border: 1.5px solid var(--accent); border-radius: 20px;
  padding: 32px 24px; text-align: center; margin: 24px 0;
}
.lead-card h3 { font-size: 20px; font-weight: 900; margin-bottom: 8px; }
.lead-card p { font-size: 14px; color: var(--muted); line-height: 1.7; margin-bottom: 20px; }
.lead-input-row {
  display: flex; gap: 8px; max-width: 400px; margin: 0 auto 12px;
}
.lead-input {
  flex: 1; padding: 12px 16px; border-radius: 12px; border: 1px solid var(--border);
  background: rgba(28,24,21,0.6); color: var(--text); font-size: 14px; outline: none;
}
.lead-input:focus { border-color: var(--accent); }
.lead-input::placeholder { color: var(--muted); }
.lead-submit {
  padding: 12px 24px; border-radius: 12px; border: none;
  background: linear-gradient(135deg, var(--accent), var(--accent2));
  color: #fff; font-size: 14px; font-weight: 700; cursor: pointer;
  transition: var(--transition); white-space: nowrap;
}
.lead-submit:hover { transform: translateY(-2px); box-shadow: 0 0 20px var(--glow1); }
.lead-success {
  display: none; padding: 16px; border-radius: 12px;
  background: rgba(100,180,100,0.1); border: 1px solid rgba(100,180,100,0.3);
  color: #7dcb7d; font-size: 14px; font-weight: 600;
}
.lead-or { font-size: 12px; color: var(--muted); margin: 12px 0; }
.line-btn {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 14px 28px; border-radius: 12px; border: none;
  background: #06C755; color: #fff; font-size: 15px; font-weight: 700;
  cursor: pointer; transition: var(--transition);
}
.line-btn:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(6,199,85,0.3); }

/* ═══════════════════════════════════════════════════════════
   RESULTS · 編輯雜誌風格質感升級（不動內容，重整視覺組織）
   ═══════════════════════════════════════════════════════════ */

/* — Container 呼吸 — */
#results { padding-top: 72px; padding-bottom: 120px; }
.results-inner { max-width: 680px; counter-reset: chapter; }

/* — Brand editorial title — */
.results-brand {
  margin-bottom: 56px;
  padding-bottom: 32px;
  border-bottom: 1px solid var(--border);
  position: relative;
}
.results-brand::after {
  content: '';
  position: absolute; bottom: -1px; left: 50%;
  transform: translateX(-50%);
  width: 48px; height: 2px;
  background: linear-gradient(90deg, transparent, var(--accent), transparent);
}
.results-brand-label {
  font-size: 10px;
  letter-spacing: 6px;
  opacity: 0.85;
}
.results-brand-title {
  font-size: 28px;
  font-weight: 900;
  margin-top: 12px;
  letter-spacing: -0.015em;
  background: linear-gradient(135deg, var(--text) 20%, var(--accent) 90%);
  -webkit-background-clip: text; background-clip: text;
  -webkit-text-fill-color: transparent;
}

/* — Chapter counter — 對 3 個主要章節容器自動編號 — */
.results-inner > .personality-banner,
.results-inner > .style-result-card,
.results-inner > .glass-card {
  counter-increment: chapter;
  position: relative;
}
.results-inner > .personality-banner::before,
.results-inner > .style-result-card::before,
.results-inner > .glass-card::before {
  content: counter(chapter, decimal-leading-zero);
  position: absolute;
  top: 20px; right: 24px;
  font-size: 10px;
  letter-spacing: 3px;
  font-weight: 700;
  color: var(--accent);
  opacity: 0.45;
  font-variant-numeric: tabular-nums;
  pointer-events: none;
  z-index: 2;
}

/* — Glass card refined: 更乾淨（拿掉 spine，靠章節編號 + gradient 層次） — */
.glass-card {
  padding: 30px 26px 28px;
  margin-bottom: 20px;
  border-radius: 18px;
  background: linear-gradient(180deg, rgba(255,252,248,0.055), rgba(255,252,248,0.025));
  position: relative;
  overflow: hidden;
}

/* — Card label 雜誌小標款：寬 tracking（拿掉後綴小橫線，減少視覺雜訊） — */
.card-label {
  display: inline-block;
  font-size: 10px;
  letter-spacing: 4px;
  font-weight: 700;
  color: var(--accent);
  text-transform: uppercase;
  margin-bottom: 14px;
}

/* — Card title 更大更有份量 — */
.card-title {
  font-size: 21px;
  font-weight: 800;
  letter-spacing: -0.01em;
  line-height: 1.35;
  margin-bottom: 12px;
}
.card-body {
  font-size: 14.5px;
  line-height: 1.85;
  color: rgba(245,240,232,0.78);
}

/* — Personality banner refined — */
.personality-banner {
  margin-bottom: 32px;
  border-radius: 20px;
  padding: 40px 28px 32px;
  background: linear-gradient(135deg, rgba(184,151,126,0.22), rgba(212,136,106,0.1));
}
.personality-type {
  font-size: 26px;
  letter-spacing: -0.01em;
}

/* — Style result card: 頂部圖 + 章節編號改到內容區 — */
.results-inner > .style-result-card {
  padding-top: 0;
  margin-bottom: 24px;
  border-radius: 18px;
  overflow: hidden;
  background: linear-gradient(180deg, rgba(255,252,248,0.055), rgba(255,252,248,0.025));
}
.results-inner > .style-result-card::before {
  top: auto; bottom: 14px; right: 22px;
  background: rgba(28,24,21,0.7);
  color: var(--accent);
  padding: 4px 10px;
  border-radius: 20px;
  opacity: 1;
}
.style-result-card::after { display: none; } /* 不要 spine，因為圖片已有視覺重量 */

/* — Overview grid: 改分格 table 款 — */
.overview-grid {
  grid-template-columns: repeat(3, 1fr);
  gap: 1px;
  background: var(--border);
  border: 1px solid var(--border);
  border-radius: 14px;
  overflow: hidden;
  margin-bottom: 28px;
}
.overview-tile {
  border: none; border-radius: 0;
  background: rgba(28,24,21,0.55);
  padding: 22px 10px;
  transition: background 0.3s ease;
}
.overview-tile:hover { background: rgba(184,151,126,0.08); }
.ov-val {
  font-size: 22px;
  font-weight: 900;
  background: linear-gradient(135deg, var(--accent), var(--accent2));
  -webkit-background-clip: text; background-clip: text;
  -webkit-text-fill-color: transparent;
  line-height: 1.15;
  letter-spacing: -0.01em;
}
.ov-key {
  font-size: 10px;
  letter-spacing: 2px;
  margin-top: 8px;
  opacity: 0.55;
  text-transform: uppercase;
}
@media (max-width: 500px) {
  .overview-grid { grid-template-columns: repeat(2, 1fr); }
}

/* — Personal tip 改引文款：拿掉背景、留 accent spine — */
.personal-tip {
  background: transparent;
  border-left: 2px solid var(--accent);
  border-radius: 0;
  padding: 2px 0 2px 20px;
  margin-bottom: 16px;
}
.personal-tip:last-child { margin-bottom: 0; }
.tip-ref {
  font-size: 11px;
  letter-spacing: 1.2px;
  color: var(--accent);
  opacity: 0.9;
  margin-bottom: 6px;
  font-weight: 600;
}
.tip-content {
  font-size: 13.5px;
  line-height: 1.85;
  color: rgba(245,240,232,0.82);
}

/* — Timeline refined: 表格化、邊線統一 — */
.timeline {
  border-radius: 12px;
  overflow: hidden;
  border: 1px solid var(--border);
  margin-top: 6px;
}
.tl-phase {
  border-radius: 0 !important;
  padding: 20px 14px;
  background: rgba(28,24,21,0.45);
  border: none;
  border-right: 1px solid var(--border);
  backdrop-filter: none;
}
.tl-phase:last-child { border-right: none; }
.tl-num {
  font-size: 9px;
  letter-spacing: 2.5px;
  opacity: 0.7;
}
.tl-name {
  font-size: 13px;
  margin: 6px 0 4px;
}
.tl-dur {
  font-size: 12px;
  font-variant-numeric: tabular-nums;
}

/* — Modules card: 拿掉盒子感、改 spine 款 — */
.module-detail-card {
  background: transparent;
  border: none;
  border-left: 2px solid var(--accent);
  border-radius: 0;
  padding: 4px 0 12px 20px;
  margin-bottom: 18px;
}
.module-detail-card .mod-title {
  font-size: 13px;
  letter-spacing: 1px;
  margin-bottom: 8px;
  text-transform: uppercase;
}
.module-detail-card .mod-item {
  font-size: 13px;
  line-height: 1.85;
}

/* — Budget bar refined — */
.budget-item { margin-bottom: 18px; }
.budget-name { font-size: 14px; }
.budget-amount {
  font-size: 13.5px;
  font-variant-numeric: tabular-nums;
}
.budget-bar-bg {
  height: 6px;
  background: rgba(184,151,126,0.08);
}

/* — Save/Nosave cols refined — */
.save-col {
  padding: 20px 18px;
  background: transparent;
  backdrop-filter: none;
  border-radius: 14px;
}
.save-col-title {
  font-size: 11px;
  letter-spacing: 3px;
  text-transform: uppercase;
  padding-bottom: 12px;
  margin-bottom: 14px;
  border-bottom: 1px dashed var(--border);
}
.flip-hint {
  margin-bottom: 16px;
  font-size: 11px;
  letter-spacing: 1px;
  opacity: 0.7;
}

/* — Action step 改大數字 editorial 款（最後一條不加線，避免連續橫線堆積） — */
.action-step {
  background: transparent;
  backdrop-filter: none;
  border: none;
  border-bottom: 1px solid var(--border);
  border-radius: 0;
  padding: 22px 0 22px 72px;
  margin-bottom: 0;
  position: relative;
  align-items: center;
}
.action-step:last-of-type { border-bottom: none; }
.action-num {
  position: absolute;
  left: 0; top: 50%;
  transform: translateY(-50%);
  width: auto; height: auto;
  border-radius: 0;
  background: transparent;
  font-size: 36px;
  font-weight: 900;
  color: transparent;
  -webkit-text-stroke: 1px var(--accent);
  font-variant-numeric: tabular-nums;
  letter-spacing: -0.02em;
  box-shadow: none;
  opacity: 0.7;
}
.action-text {
  font-size: 14.5px;
  line-height: 1.75;
}

/* — Section heading spacing（章節之間的呼吸 + 細線） — */
.results-inner > .glass-card + .card-label,
.results-inner > div + .card-label,
.results-inner > .style-result-card + .card-label {
  margin-top: 48px !important;
  padding-top: 28px;
  border-top: 1px solid var(--border);
}

/* — Result actions（拿掉上下 border，讓按鈕組自己當視覺錨點） — */
.result-actions {
  gap: 10px;
  padding: 8px 0;
  margin: 40px 0 32px;
  justify-content: center;
}
.result-action-btn {
  padding: 10px 18px;
  border-radius: 10px;
  font-size: 12.5px;
}

/* — Lead card refined: 更高雅 — */
.lead-card {
  background: linear-gradient(180deg, rgba(28,24,21,0.65), rgba(28,24,21,0.35));
  border: 1px solid rgba(184,151,126,0.4);
  border-radius: 20px;
  padding: 44px 28px 36px;
  margin: 28px 0 20px;
  position: relative;
  overflow: hidden;
  backdrop-filter: blur(20px);
}
.lead-card::before {
  content: '';
  position: absolute;
  inset: 0;
  background: radial-gradient(ellipse 120% 50% at 50% 0%, rgba(184,151,126,0.18), transparent 70%);
  pointer-events: none;
}
.lead-card h3 {
  font-size: 22px;
  letter-spacing: -0.01em;
  position: relative;
  margin-bottom: 10px;
}
.lead-card p {
  position: relative;
  font-size: 14px;
  opacity: 0.72;
  line-height: 1.85;
  margin-bottom: 24px;
}
.lead-input-row { position: relative; }
.lead-input {
  border-radius: 12px;
  padding: 14px 16px;
}
.lead-card #lead-form > button { position: relative; }
.lead-or {
  position: relative;
  opacity: 0.5;
  letter-spacing: 2px;
  font-size: 10px;
  margin: 20px 0 14px;
}

/* — Footer 復盤 — */
.results-inner > div:last-child {
  margin-top: 56px;
}

/* — CTA card（想看你的家）refined — */
.results-inner > .anim-in > div[style*="linear-gradient"]:first-child {
  border-radius: 20px !important;
  padding: 44px 28px !important;
  position: relative;
}

/* — Sticky TOC：章節目錄 — */
.results-toc {
  position: sticky;
  top: 4px;
  z-index: 500;
  margin: 0 auto 28px;
  max-width: 720px;
  background: rgba(28,24,21,0.78);
  backdrop-filter: blur(24px) saturate(140%);
  -webkit-backdrop-filter: blur(24px) saturate(140%);
  border: 1px solid var(--border);
  border-radius: 16px;
  box-shadow: 0 12px 32px rgba(0,0,0,0.35);
  overflow: hidden;
}
.results-toc .toc-inner {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 10px 14px 10px 16px;
}
.results-toc .toc-label {
  font-size: 10px;
  letter-spacing: 3px;
  color: var(--accent);
  font-weight: 700;
  text-transform: uppercase;
  flex-shrink: 0;
  white-space: nowrap;
}
.results-toc .toc-scroll {
  flex: 1;
  display: flex;
  gap: 4px;
  overflow-x: auto;
  scrollbar-width: none;
  -ms-overflow-style: none;
  scroll-behavior: smooth;
  -webkit-mask-image: linear-gradient(90deg, transparent, black 4%, black 96%, transparent);
  mask-image: linear-gradient(90deg, transparent, black 4%, black 96%, transparent);
}
.results-toc .toc-scroll::-webkit-scrollbar { display: none; }
.toc-item {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 6px 12px;
  border-radius: 16px;
  font-size: 12px;
  font-weight: 600;
  color: var(--muted);
  background: transparent;
  border: 1px solid transparent;
  cursor: pointer;
  transition: all 0.3s var(--spring);
  white-space: nowrap;
  flex-shrink: 0;
}
.toc-item:hover {
  color: var(--text);
  background: rgba(184,151,126,0.08);
}
.toc-item.active {
  color: var(--accent);
  background: rgba(184,151,126,0.15);
  border-color: rgba(184,151,126,0.35);
  box-shadow: 0 0 12px rgba(184,151,126,0.15);
}
.toc-item .toc-num {
  font-size: 10px;
  letter-spacing: 1px;
  opacity: 0.7;
  font-variant-numeric: tabular-nums;
}
.results-toc .toc-meta {
  font-size: 11px;
  color: var(--muted);
  letter-spacing: 2px;
  font-variant-numeric: tabular-nums;
  flex-shrink: 0;
  opacity: 0.7;
}
.toc-progress-track {
  height: 2px;
  background: rgba(184,151,126,0.08);
  position: relative;
}
.toc-progress-fill {
  position: absolute;
  top: 0; left: 0; bottom: 0;
  background: linear-gradient(90deg, var(--accent), var(--accent2));
  width: 0%;
  transition: width 0.5s cubic-bezier(.4,0,.2,1);
  box-shadow: 0 0 8px var(--glow1);
}
@media (max-width: 520px) {
  .results-toc .toc-label { display: none; }
  .results-toc .toc-meta { font-size: 10px; }
}

/* Toast notification */
.toast {
  position: fixed; bottom: 24px; left: 50%; transform: translateX(-50%) translateY(100px);
  background: var(--accent); color: #fff; padding: 12px 24px; border-radius: 12px;
  font-size: 14px; font-weight: 600; z-index: 9999;
  transition: transform 0.4s cubic-bezier(.4,0,.2,1); pointer-events: none;
}
.toast.show { transform: translateX(-50%) translateY(0); }

/* Print styles */
@media print {
  body { background: #fff !important; color: #222 !important; }
  .mesh-bg, #progress-bar, .lead-card, .result-actions, .pro-blur-overlay,
  .phase-back, .next-btn, .cta-btn, .cta-btn-ghost, .line-btn, .lead-submit,
  .toast, .scroll-hint { display: none !important; }
  .glass-card, .overview-tile, .module-detail-card, .personality-banner,
  .style-result-card, .personal-tip, .action-step, .tl-phase,
  .save-col, .flip-card {
    background: #f8f6f3 !important; border-color: #ddd !important;
    backdrop-filter: none !important; -webkit-backdrop-filter: none !important;
    break-inside: avoid;
  }
  .card-label, .section-label, .results-brand-label { color: #B8977E !important; }
  .card-title, .ov-val, .personality-type { color: #8B6F5A !important; }
  .card-body, .tip-content, .mod-item, .val-desc { color: #444 !important; }
  .budget-bar { print-color-adjust: exact; -webkit-print-color-adjust: exact; }
  .anim-in { opacity: 1 !important; transform: none !important; }
  .flip-back { max-height: 200px !important; padding: 10px 14px !important; opacity: 1 !important; }
  #results { padding: 20px !important; }
  .results-inner { max-width: 100% !important; }
}
</style>


