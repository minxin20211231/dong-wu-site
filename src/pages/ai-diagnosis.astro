// ══════════ MAILERLITE 訂閱（前端骨架）══════════
// 為避免 API token 在前端暴露，提交一律走 Cloudflare Worker proxy（設定見 docs/MailerLite_Email_Routing_SOP.md）。
// Worker 部署前 endpoint 留空 → 優雅降級：照常解鎖 + 暫存 email，但不實際送出。
// Bibo 設好 MailerLite + Worker 後，把下方 endpoint 填上即可全線接通。
const MAILERLITE_CONFIG = {
  endpoint: 'https://dongwu-subscribe.minxin20211231.workers.dev', // Worker 已部署 2026-05-24
};

// ══════════ 漏斗事件追蹤（diagnosis_events @ D1）══════════
// session_id 串「進入頁面 → 完成 18 題 → 解鎖 email → 訂閱成功」四段
// 永不存 email / 答案明細（Phase 1 範圍），失敗不阻塞使用者流程
function getOrCreateSessionId() {
  try {
    let sid = localStorage.getItem('dongwu_diag_session');
    if (!sid && typeof crypto !== 'undefined' && crypto.randomUUID) {
      sid = crypto.randomUUID();
      localStorage.setItem('dongwu_diag_session', sid);
    }
    return sid || '';
  } catch (err) {
    return '';
  }
}

function trackEvent(event_type, source) {
  if (!MAILERLITE_CONFIG.endpoint) return;
  const session_id = getOrCreateSessionId();
  if (!session_id) return;
  try {
    fetch(MAILERLITE_CONFIG.endpoint + '/track', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ session_id, event_type, source: source || '' }),
      keepalive: true,
    }).catch(() => {});
  } catch (err) {}
}

async function subscribeEmail(email, source, name) {
  if (!MAILERLITE_CONFIG.endpoint) {
    console.info('[MailerLite] endpoint 尚未設定，略過實際送出（email 已暫存本地）');
    return { ok: false, pending: true };
  }
  try {
    const res = await fetch(MAILERLITE_CONFIG.endpoint, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        email: email,
        name: name || '',
        source: source || 'ai-diagnosis',
        session_id: getOrCreateSessionId(),
      }),
    });
    return { ok: res.ok };
  } catch (err) {
    console.warn('[MailerLite] 送出失敗', err);
    return { ok: false, error: true };
  }
}

