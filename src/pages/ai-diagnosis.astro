      <div class="overview-tile"><div class="ov-val">${people} 人</div><div class="ov-key">居住人數</div></div>
      <div class="overview-tile"><div class="ov-val">${getLayoutLabel(layout)}</div><div class="ov-key">格局調整</div></div>
