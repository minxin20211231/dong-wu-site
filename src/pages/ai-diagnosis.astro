let currentPhase = 0;

// Track which questions in the current phase have been answered (for enabling next btn)
const phaseAnswered = {};

// ══════════ BUILD QUIZ (Change 1: phase groups) ══════════
function buildQuiz() {
  const container = document.getElementById('quiz-container');
  container.innerHTML = '';

  PHASE_GROUPS.forEach((group, phaseIdx) => {
    const div = document.createElement('div');
    div.id = 'phase-screen-' + phaseIdx;
    div.className = 'phase-screen page';
    div.style.display = 'none';

    let innerHtml = `
      <div class="phase-header">
        <div class="q-phase">${group.emoji} ${group.label}</div>
        <div class="phase-progress-label">第 ${group.phaseNum} 部分，共 5 部分</div>
      </div>
    `;

    group.qIdxs.forEach((qIdx, i) => {
      const q = QUESTIONS[qIdx];
      if (i > 0) {
        innerHtml += `<div class="q-divider"></div>`;
      }
      innerHtml += `<div class="q-block" id="qblock-${phaseIdx}-${qIdx}">`;
      innerHtml += buildQBlockHTML(q, qIdx, phaseIdx);
      innerHtml += `</div>`;
    });

    // Phase navigation buttons (back + next)
    const isLastPhase = phaseIdx === PHASE_GROUPS.length - 1;
    const btnLabel = isLastPhase ? '查看我的診斷結果<svg class="icon" style="margin-left:6px"><use href="#i-arrow-right"/></svg>' : '下一步<svg class="icon" style="margin-left:6px"><use href="#i-arrow-right"/></svg>';
    innerHtml += `<div class="phase-nav">`;
    if (phaseIdx > 0) {
      innerHtml += `<button class="phase-back" onclick="goBackPhase(${phaseIdx})"><svg class="icon" style="margin-right:4px"><use href="#i-arrow-left"/></svg>上一步</button>`;
    }
    innerHtml += `<button class="next-btn" id="phase-next-${phaseIdx}" onclick="goNextPhase(${phaseIdx})" style="opacity:0.45;pointer-events:none;margin-top:0">${btnLabel}</button>`;
    innerHtml += `</div>`;

    div.innerHTML = innerHtml;
    container.appendChild(div);
  });
}

function buildQBlockHTML(q, idx, phaseIdx) {
  let body = '';

  if (q.type === 'number') {
    body = `
      <div class="num-input-wrap">
        <input class="num-input" type="number" id="num-${q.id}" min="1" max="999"
          inputmode="numeric" placeholder="0"
          oninput="onNumInput(${idx}, ${phaseIdx}, this.value)">
        <span class="num-unit">${q.unit}</span>
      </div>
      <div class="num-feedback" id="numfb-${q.id}"></div>
    `;
  } else if (q.type === 'radio') {
    const opts = q.options.map((o, oi) => `
      <div class="opt-item">
        <label class="opt-label" id="opt-${q.id}-${oi}" onclick="selectRadio(${idx},${phaseIdx},'${q.id}',${oi},'${o.val}')">
          <span class="opt-radio-dot"></span>
          <span class="opt-text">${o.text}</span>
        </label>
        ${o.fb ? `<div class="opt-feedback" id="fb-${q.id}-${oi}">${o.fb}</div>` : ''}
      </div>
    `).join('');
    body = `<div class="options-list">${opts}</div>`;
  } else if (q.type === 'checkbox') {
    const opts = q.options.map((o, oi) => `
      <div class="opt-item">
        <label class="opt-label" id="opt-${q.id}-${oi}" onclick="toggleCheck(${idx},${phaseIdx},'${q.id}',${oi},'${o.val}',this)">
          <span class="opt-check-box"></span>
          <span class="opt-text">${o.text}</span>
        </label>
        ${o.fb ? `<div class="opt-feedback" id="fb-${q.id}-${oi}">${o.fb}</div>` : ''}
      </div>
    `).join('');
    body = `<div class="options-list">${opts}</div>`;
  } else if (q.type === 'style') {
    const cards = q.options.map((o, oi) => `
      <div class="style-card" id="sc-${q.id}-${oi}" onclick="selectStyle(${idx},${phaseIdx},'${q.id}',${oi},'${o.val}')">
        <div class="style-check"></div>
        <img class="style-img" src="${o.img}" alt="${o.text}"
          onerror="this.style.display='none';this.nextElementSibling.style.display='flex'">
        <div class="style-img-placeholder" style="display:none">${o.emoji}</div>
        <div class="style-label">${o.text}<div class="style-sub">${o.sub}</div></div>
        <div class="style-fb-box" id="sfb-${q.id}-${oi}">${o.fb}</div>
      </div>
    `).join('');
    body = `<div class="style-grid">${cards}</div>`;
  }

  return `
    <h2 class="q-block-title">${q.title}</h2>
    ${q.hint ? `<p class="q-block-hint">${q.hint}</p>` : ''}
    ${body}
  `;
}

// ══════════ INTERACTIONS (updated for phase model) ══════════
function onNumInput(idx, phaseIdx, val) {
  const q = QUESTIONS[idx];
  const v = parseInt(val) || 0;
  answers[q.id] = v;
  const fb = document.getElementById('numfb-' + q.id);
  if (fb && v > 0) {
    fb.textContent = q.getFeedback(v);
    fb.style.opacity = '1';
    markAnswered(phaseIdx, idx);
  } else if (fb) {
    fb.style.opacity = '0';
    unmarkAnswered(phaseIdx, idx);
  }
  checkPhaseComplete(phaseIdx);
}

function selectRadio(idx, phaseIdx, qid, oi, val) {
  const q = QUESTIONS[idx];
  // deselect all
  q.options.forEach((_, i) => {
    const lbl = document.getElementById(`opt-${qid}-${i}`);
    if (lbl) lbl.classList.remove('selected');
    const fb = document.getElementById(`fb-${qid}-${i}`);
    if (fb) fb.classList.remove('show');
  });
  // select
  const lbl = document.getElementById(`opt-${qid}-${oi}`);
  if (lbl) lbl.classList.add('selected');
  const fb = document.getElementById(`fb-${qid}-${oi}`);
  if (fb && q.options[oi].fb) { fb.classList.add('show'); }
  answers[qid] = val;
  markAnswered(phaseIdx, idx);
  checkPhaseComplete(phaseIdx);
}

const checkedSets = {};
// 題目互斥規則：選 A 自動取消 B、選 B 自動取消 A
const EXCLUSIVE_PAIRS = {
  kitchen: [['A','B']]  // 廚房：很少煮 vs 天天開伙 互斥
};
function toggleCheck(idx, phaseIdx, qid, oi, val, labelEl) {
  if (!checkedSets[qid]) checkedSets[qid] = new Set();
  const set = checkedSets[qid];
  const lbl = document.getElementById(`opt-${qid}-${oi}`);
  const fb = document.getElementById(`fb-${qid}-${oi}`);
  if (set.has(val)) {
    set.delete(val);
    lbl.classList.remove('selected');
    if (fb) fb.classList.remove('show');
  } else {
    // 互斥處理：選了新值前先取消互斥的對方
    const pairs = EXCLUSIVE_PAIRS[qid];
    if (pairs) {
      pairs.forEach(pair => {
        if (pair.includes(val)) {
          const opposite = pair.find(v => v !== val);
          if (set.has(opposite)) {
            set.delete(opposite);
            // 找對方的 oi 索引並更新 UI
            const q = QUESTIONS[idx];
            const oppIdx = q.options.findIndex(o => o.val === opposite);
            if (oppIdx >= 0) {
              const oppLbl = document.getElementById(`opt-${qid}-${oppIdx}`);
              const oppFb = document.getElementById(`fb-${qid}-${oppIdx}`);
              if (oppLbl) oppLbl.classList.remove('selected');
              if (oppFb) oppFb.classList.remove('show');
            }
          }
        }
      });
    }
    set.add(val);
    lbl.classList.add('selected');
    if (fb) fb.classList.add('show');
  }
  answers[qid] = Array.from(set);
  if (set.size > 0) {
    markAnswered(phaseIdx, idx);
  } else {
    unmarkAnswered(phaseIdx, idx);
  }
  checkPhaseComplete(phaseIdx);
}

function selectStyle(idx, phaseIdx, qid, oi, val) {
  const q = QUESTIONS[idx];
  q.options.forEach((_, i) => {
    const sc = document.getElementById(`sc-${qid}-${i}`);
    if (sc) sc.classList.remove('selected');
    const sfb = document.getElementById(`sfb-${qid}-${i}`);
    if (sfb) sfb.classList.remove('show');
  });
  const sc = document.getElementById(`sc-${qid}-${oi}`);
  if (sc) sc.classList.add('selected');
  const sfb = document.getElementById(`sfb-${qid}-${oi}`);
  if (sfb && q.options[oi].fb) sfb.classList.add('show');
  answers[qid] = val;
  markAnswered(phaseIdx, idx);
  checkPhaseComplete(phaseIdx);
}

// Track which questions in each phase are answered
function markAnswered(phaseIdx, qIdx) {
  if (!phaseAnswered[phaseIdx]) phaseAnswered[phaseIdx] = new Set();
  phaseAnswered[phaseIdx].add(qIdx);
}
function unmarkAnswered(phaseIdx, qIdx) {
  if (phaseAnswered[phaseIdx]) phaseAnswered[phaseIdx].delete(qIdx);
}

function checkPhaseComplete(phaseIdx) {
  const group = PHASE_GROUPS[phaseIdx];
  const answered = phaseAnswered[phaseIdx] || new Set();
  // Phase is "ready" when at least one answer given per required question
  // For UX: enable next button when all radio/style/checkbox/number q's answered
  const allAnswered = group.qIdxs.every(qIdx => answered.has(qIdx));
  const btn = document.getElementById('phase-next-' + phaseIdx);
  if (btn) {
    if (allAnswered) {
      btn.style.opacity = '1';
      btn.style.pointerEvents = 'auto';
    } else {
      btn.style.opacity = '0.45';
      btn.style.pointerEvents = 'none';
    }
  }
}

function goNextPhase(phaseIdx) {
  saveToLocal();
  const next = phaseIdx + 1;
  if (next >= PHASE_GROUPS.length) {
    showLoading();
    return;
  }
  showPhase(next);
}

function goBackPhase(phaseIdx) {
  if (phaseIdx > 0) showPhase(phaseIdx - 1);
}

// ══════════ LOCAL STORAGE PERSISTENCE ══════════
function saveToLocal() {
  try {
    localStorage.setItem('dongwu_answers', JSON.stringify(answers));
    localStorage.setItem('dongwu_checkedSets', JSON.stringify(
      Object.fromEntries(Object.entries(checkedSets).map(([k,v]) => [k, Array.from(v)]))
    ));
    localStorage.setItem('dongwu_phase', currentPhase.toString());
  } catch(e) {}
}

function loadFromLocal() {
  try {
    const saved = localStorage.getItem('dongwu_answers');
    if (!saved) return false;
    const parsed = JSON.parse(saved);
    Object.assign(answers, parsed);
    const savedSets = localStorage.getItem('dongwu_checkedSets');
    if (savedSets) {
      const parsedSets = JSON.parse(savedSets);
      for (const [k,v] of Object.entries(parsedSets)) {
        checkedSets[k] = new Set(v);
      }
    }
    return true;
  } catch(e) { return false; }
}

function clearLocal() {
  try {
    localStorage.removeItem('dongwu_answers');
    localStorage.removeItem('dongwu_checkedSets');
    localStorage.removeItem('dongwu_phase');
  } catch(e) {}
}

// ══════════ LANDING PAGE SCROLL ANIMATIONS ══════════
function smoothTo(sel) {
  const el = document.querySelector(sel);
  if (el) el.scrollIntoView({ behavior: 'smooth' });
}

function toggleFaq(q) {
  const item = q.closest('.faq-item');
  item.classList.toggle('open');
}

// Sticky header — scroll 加深背景；quiz/results 模式自動隱藏
document.body.classList.add('has-header');
const _siteHdr = document.getElementById('siteHeader');
window.addEventListener('scroll', () => {
  if (!_siteHdr) return;
  if (window.scrollY > 40) _siteHdr.classList.add('scrolled');
  else _siteHdr.classList.remove('scrolled');
}, { passive: true });

function _toggleSiteHeader(show) {
  if (_siteHdr) _siteHdr.style.display = show ? '' : 'none';
}

// Nav 點擊 smooth scroll
function navTo(sel) {
  const el = sel.startsWith('.') || sel.startsWith('#') ? document.querySelector(sel) : document.getElementById(sel);
  if (el) {
    const y = el.getBoundingClientRect().top + window.scrollY - 80;
    window.scrollTo({ top: y, behavior: 'smooth' });
  }
}

// Scroll spy — 當前章節 highlight
function initScrollSpy() {
  const links = Array.from(document.querySelectorAll('.header-nav a[data-target]'));
  const pairs = links.map(l => {
    const sel = l.dataset.target;
    const el = sel.startsWith('.') || sel.startsWith('#') ? document.querySelector(sel) : document.getElementById(sel);
    return { el, link: l };
  }).filter(p => p.el);
  if (!pairs.length) return;
  const io = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        const p = pairs.find(x => x.el === e.target);
        if (p) {
          links.forEach(l => l.classList.remove('active'));
          p.link.classList.add('active');
        }
      }
    });
  }, { rootMargin: '-40% 0px -50% 0px' });
  pairs.forEach(p => io.observe(p.el));
}
setTimeout(initScrollSpy, 200);

// IntersectionObserver for landing sections
const landObs = new IntersectionObserver((entries) => {
  entries.forEach(e => {
    if (e.isIntersecting) { e.target.classList.add('in-view'); e.target.classList.add('vis'); }
  });
}, { threshold: 0.1 });
document.querySelectorAll('.land-scene, .cta-scene, .land-anim').forEach(el => landObs.observe(el));

// ══════════ NAVIGATION ══════════
function startQuiz() {
  document.getElementById('landing').style.display = 'none';
  document.getElementById('quiz-container').style.display = 'block';
  _toggleSiteHeader(false);
  buildQuiz();

  // 每次進入都是全新空白問卷：清掉上次的記憶與選取，從第 1 部分開始
  Object.keys(answers).forEach(k => delete answers[k]);
  Object.keys(checkedSets).forEach(k => delete checkedSets[k]);
  clearLocal();
  currentPhase = 0;
  showPhase(0);
}

function restoreUIState() {
  // Restore UI selections from answers object
  QUESTIONS.forEach((q, idx) => {
    const val = answers[q.id];
    if (!val) return;
    // Find which phase this question belongs to
    let phaseIdx = 0;
    PHASE_GROUPS.forEach((g, pi) => { if (g.qIdxs.includes(idx)) phaseIdx = pi; });

    if (q.type === 'number' && val > 0) {
      const input = document.getElementById('num-' + q.id);
      if (input) { input.value = val; onNumInput(idx, phaseIdx, val); }
    } else if (q.type === 'radio') {
      const oi = q.options.findIndex(o => o.val === val);
      if (oi >= 0) selectRadio(idx, phaseIdx, q.id, oi, val);
    } else if (q.type === 'checkbox' && Array.isArray(val)) {
      val.forEach(v => {
        const oi = q.options.findIndex(o => o.val === v);
        if (oi >= 0) {
          if (!checkedSets[q.id]) checkedSets[q.id] = new Set();
          if (!checkedSets[q.id].has(v)) {
            toggleCheck(idx, phaseIdx, q.id, oi, v, null);
          }
        }
      });
    } else if (q.type === 'style') {
      const oi = q.options.findIndex(o => o.val === val);
      if (oi >= 0) selectStyle(idx, phaseIdx, q.id, oi, val);
    }
  });
}

function buildProgressTicks() {
  const ticks = document.getElementById('progress-ticks');
  if (!ticks || ticks.children.length) return;
  const total = PHASE_GROUPS.length;
  for (let i = 0; i < total; i++) {
    const t = document.createElement('div');
    t.className = 'progress-tick';
    t.dataset.i = i;
    ticks.appendChild(t);
  }
}

function showPhase(idx) {
  buildProgressTicks();
  const current = document.querySelector('.phase-screen[style*="display: flex"], .phase-screen[style*="display:flex"]');
  const next = document.getElementById('phase-screen-' + idx);
  if (!next) return;

  const swap = () => {
    document.querySelectorAll('.phase-screen').forEach(s => { s.style.display = 'none'; s.classList.remove('leaving'); });
    next.style.display = 'flex';
    next.style.animation = 'none';
    void next.offsetWidth;
    next.style.animation = '';
    window.scrollTo({ top: 0, behavior: 'smooth' });
    currentPhase = idx;
    updateProgress();
  };
  if (current && current !== next) {
    current.classList.add('leaving');
    setTimeout(swap, 280);
  } else {
    swap();
  }
}

function updateProgress() {
  const pct = ((currentPhase + 1) / PHASE_GROUPS.length) * 100;
  document.getElementById('progress-bar').style.width = pct + '%';
  document.querySelectorAll('.progress-tick').forEach((t, i) => {
    t.classList.remove('active', 'passed');
    if (i < currentPhase) t.classList.add('passed');
    else if (i === currentPhase) t.classList.add('active');
  });
}

// ══════════ LOADING ══════════
function showLoading() {
  document.getElementById('quiz-container').style.display = 'none';
  const ls = document.getElementById('loading');
  ls.style.display = 'flex';
  document.getElementById('progress-bar').style.width = '95%';

  const steps = ['ls0','ls1','ls2','ls3','ls4'];
  const bar = document.getElementById('loadingBarFill');
  if (bar) bar.style.width = '0%';
  let si = 0;

  function nextStep() {
    if (si < steps.length) {
      const el = document.getElementById(steps[si]);
      el.classList.add('active');
      el.querySelector('.step-icon').textContent = '◌';
      setTimeout(() => {
        el.classList.remove('active');
        el.classList.add('done');
        el.querySelector('.step-icon').classList.add('done-mark');
        si++;
        if (bar) bar.style.width = (si / steps.length * 100) + '%';
        setTimeout(nextStep, 500);
      }, 900);
    } else {
      setTimeout(showResults, 400);
    }
  }
  nextStep();
}

// ══════════ RESULTS ══════════
function showResults() {
  document.getElementById('loading').style.display = 'none';
  document.getElementById('results').style.display = 'block';
  document.getElementById('progress-bar').style.width = '100%';
  window.scrollTo(0,0);
  saveToLocal();
  trackEvent('quiz_complete', 'ai-diagnosis');

  const content = generateResults();
  document.getElementById('results-content').innerHTML = content;

  // Build TOC
  setTimeout(buildResultsTOC, 60);

  // Trigger scroll animations
  setTimeout(initScrollAnimations, 100);
  // Trigger budget bars
  setTimeout(animateBudgetBars, 600);

  // Set up flip card tap on mobile
  setTimeout(() => {
    document.querySelectorAll('.flip-card').forEach(card => {
      card.addEventListener('click', () => card.classList.toggle('flipped'));
    });
  }, 200);

  // 背景預先抓好對應類型的分享卡片圖（給分享按鈕用）
  setTimeout(() => {
    const k = document.querySelector('.arch-card')?.dataset.archKey;
    if (k) precacheShareImage(k);
  }, 400);
}

// ══════════ TOC ══════════
function buildResultsTOC() {
  const scroll = document.getElementById('tocScroll');
  const meta = document.getElementById('tocMeta');
  const fill = document.getElementById('tocProgressFill');
  if (!scroll || !meta) return;

  const sections = Array.from(document.querySelectorAll('.results-inner [data-chapter]'));
  if (!sections.length) return;

  // Assign ids & build items
  const items = sections.map((s, i) => {
    const id = 'ch-' + (i + 1);
    s.id = id;
    const num = String(i + 1).padStart(2, '0');
    const title = s.getAttribute('data-chapter') || ('章節 ' + num);
    return { id, num, title, el: s };
  });

  scroll.innerHTML = items.map(it => `
    <a class="toc-item" data-target="${it.id}">
      <span class="toc-num">${it.num}</span>
      <span class="toc-title">${it.title}</span>
    </a>
  `).join('');

  const total = items.length;
  meta.textContent = '01 / ' + String(total).padStart(2, '0');

  // Click → smooth scroll
  scroll.querySelectorAll('.toc-item').forEach(item => {
    item.addEventListener('click', () => {
      const target = document.getElementById(item.dataset.target);
      if (!target) return;
      const y = target.getBoundingClientRect().top + window.scrollY - 90;
      window.scrollTo({ top: y, behavior: 'smooth' });
    });
  });

  // Scroll spy
  let currentIdx = 0;
  const io = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        const idx = items.findIndex(it => it.el === e.target);
        if (idx < 0) return;
        currentIdx = idx;
        scroll.querySelectorAll('.toc-item').forEach(el => el.classList.remove('active'));
        const activeItem = scroll.querySelector(`[data-target="${items[idx].id}"]`);
        if (activeItem) {
          activeItem.classList.add('active');
          // Auto-scroll the TOC so active item is visible
          const scrollRect = scroll.getBoundingClientRect();
          const itemRect = activeItem.getBoundingClientRect();
          if (itemRect.left < scrollRect.left + 40 || itemRect.right > scrollRect.right - 40) {
            scroll.scrollTo({
              left: activeItem.offsetLeft - scrollRect.width / 2 + itemRect.width / 2,
              behavior: 'smooth'
            });
          }
        }
        meta.textContent = String(idx + 1).padStart(2, '0') + ' / ' + String(total).padStart(2, '0');
        fill.style.width = ((idx + 1) / total * 100) + '%';
      }
    });
  }, { rootMargin: '-35% 0px -55% 0px', threshold: 0 });
  items.forEach(it => io.observe(it.el));

  // Init
  scroll.querySelector('.toc-item')?.classList.add('active');
  fill.style.width = (1 / total * 100) + '%';
}

// ══════════ ARCHETYPE SHARE ══════════
// 分享「預先渲染好的靜態卡片圖」(/ai-diagnosis/share/{key}.jpg)。
// 不用 html2canvas 即時截圖——它在手機上會把卡片渲染變形；靜態圖是 Playwright
// 截真實渲染、像素級正確、5 型各一張。
let _cardImageFile = null;   // 快取的卡片圖 File
let _cardImageKey = null;

// 結果頁顯示後背景先抓好對應類型的卡片圖快取（iOS Safari 分享需在手勢當下、避免非同步延遲）
async function precacheShareImage(key) {
  if (!key || (_cardImageKey === key && _cardImageFile)) return;
  try {
    const resp = await fetch(`/ai-diagnosis/share/${key}.jpg`);
    const blob = await resp.blob();
    _cardImageFile = new File([blob], '懂屋_屋主類型.jpg', { type: 'image/jpeg' });
    _cardImageKey = key;
  } catch (e) { /* 失敗則分享時再抓 */ }
}

async function shareArchetype(key, name, imgSrc) {
  const url = window.location.href.split('#')[0] + '#arch-' + key;
  const text = `我是「${name}」— 來測測你的裝修屋主類型，看看我們是不是黃金組合 ↓`;
  const title = '懂屋・5 型屋主診斷';

  // 用預先渲染好的靜態卡片圖（優先快取，否則現抓）
  let file = (_cardImageKey === key && _cardImageFile) ? _cardImageFile : null;
  if (!file) {
    try {
      const resp = await fetch(`/ai-diagnosis/share/${key}.jpg`);
      const blob = await resp.blob();
      file = new File([blob], `懂屋_${name}.jpg`, { type: 'image/jpeg' });
    } catch (e) { /* 抓不到則退回純文字+連結 */ }
  }

  // 行動裝置：Web Share API 分享卡片圖 + 文字 + 連結
  if (navigator.share) {
    try {
      const data = { title, text, url };
      if (file && navigator.canShare && navigator.canShare({ files: [file] })) {
        data.files = [file];
      }
      await navigator.share(data);
      return;
    } catch (e) { /* 使用者取消 */ return; }
  }

  // 桌機 fallback：下載卡片圖 + 複製連結
  if (file) {
    const a = document.createElement('a');
    a.href = URL.createObjectURL(file);
    a.download = file.name;
    document.body.appendChild(a); a.click(); a.remove();
    setTimeout(() => URL.revokeObjectURL(a.href), 4000);
  }
  try {
    await navigator.clipboard.writeText(`${text}\n${url}`);
    showShareToast(file ? '卡片圖已下載、連結已複製！可貼到 IG 限動 / LINE' : '連結已複製！可貼到 IG 限動 / LINE / Threads 分享');
  } catch (e) {
    prompt('複製這段傳給朋友：', `${text}\n${url}`);
  }
}

function showShareToast(msg) {
  let t = document.getElementById('share-toast');
  if (!t) {
    t = document.createElement('div');
    t.id = 'share-toast';
    t.style.cssText = 'position:fixed;bottom:32px;left:50%;transform:translateX(-50%);background:rgba(28,24,21,.95);color:#F5F0E8;padding:14px 24px;border-radius:30px;font-size:13px;letter-spacing:1.5px;font-weight:600;z-index:9999;box-shadow:0 12px 32px rgba(0,0,0,.4);transition:opacity .3s;border:1px solid rgba(184,151,126,.3);';
    document.body.appendChild(t);
  }
  t.textContent = '✓ ' + msg;
  t.style.opacity = '1';
  clearTimeout(t._timer);
  t._timer = setTimeout(() => { t.style.opacity = '0'; }, 3200);
}

