  if (fear === 'B') return types.storage;
  if (fear === 'D') return types.speed;
  if (fear === 'A' && budget === 'A') return types.saver;
  if (fear === 'A' && (budget === 'B' || budget === 'C')) return types.all;
  if (fear === 'C' && (budget === 'B' || budget === 'C')) return types.beauty;
