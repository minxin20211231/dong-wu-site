---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="懂屋 Know Your Home">
  <header class="home-topbar">
    <div class="home-topbar-inner">
      <a href="/" class="home-brand">懂屋 · Know Your Home</a>
      <nav class="home-nav" aria-label="主導覽">
        <a href="/about/" class="home-nav-link">關於懂屋</a>
        <a href="/posts/" class="home-nav-link">所有文章</a>
        <a href="#" class="home-nav-cta" aria-disabled="true" tabindex="-1">訂閱電子報</a>
      </nav>
    </div>
  </header>

  <main class="hero glow-bg">
    <div class="container hero-inner">
      <p class="brand-eyebrow">懂屋 · Know Your Home</p>

      <h1 class="brand-headline">
        你必須要知道的<br />
        所有裝修知識<br />
        <span class="accent">都在這裡</span>
      </h1>

      <p class="brand-sub">
        從預算規劃、風格選擇到驗收避雷，<br />
        新手屋主的裝修導航。
      </p>

      <div class="hero-actions">
        <a href="/ai-diagnosis/" class="hero-cta">開始免費診斷 →</a>
        <a href="/posts/" class="hero-link">先看文章 →</a>
        <div class="status-pill">
          <span class="dot"></span>
          AI 裝修診斷書 · 免費
        </div>
      </div>

      <p class="brand-foot">
        2026 / AI 診斷書上線
      </p>
    </div>
  </main>
</BaseLayout>

<style>
  /* 首頁 header — 深底毛玻璃，cinematic 風格 */
  .home-topbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    background: rgba(28, 24, 21, 0.72);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid rgba(184, 151, 126, 0.18);
  }

  .home-topbar-inner {
    max-width: 1180px;
    margin: 0 auto;
    padding: 16px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .home-brand {
    font-size: 0.9rem;
    letter-spacing: 0.18em;
    color: #F5F0E8 !important;
    font-weight: 700;
    text-decoration: none;
    flex-shrink: 0;
  }

  .home-brand:hover {
    color: #B8977E !important;
  }

  .home-nav {
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .home-nav-link {
    font-size: 0.9rem;
    color: #F5F0E8 !important;
    letter-spacing: 0.06em;
    font-weight: 600;
    text-decoration: none;
    transition: color 0.18s ease;
  }

  .home-nav-link:hover {
    color: #B8977E !important;
  }

  .home-nav-cta {
    display: inline-flex;
    align-items: center;
    padding: 9px 22px;
    border: 1px solid rgba(184, 151, 126, 0.45);
    border-radius: 999px;
    font-size: 0.85rem;
    color: rgba(245, 240, 232, 0.55) !important;
    letter-spacing: 0.06em;
    font-weight: 600;
    cursor: not-allowed;
    pointer-events: none;
    background: transparent;
    text-decoration: none;
  }

  .home-nav-cta::after {
    content: "（即將上線）";
    font-size: 0.78em;
    opacity: 0.7;
    margin-left: 4px;
  }

  @media (max-width: 720px) {
    .home-topbar-inner {
      gap: 12px;
    }
    .home-nav {
      gap: 14px;
    }
    .home-nav-link {
      font-size: 0.8rem;
    }
    .home-nav-cta {
      padding: 7px 14px;
      font-size: 0.78rem;
    }
    .home-nav-cta::after {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .home-brand {
      font-size: 0.78rem;
      letter-spacing: 0.1em;
    }
    .home-nav-link[href="/about/"] {
      display: none;
    }
  }

  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 80px 24px;
  }

  .hero-inner {
    text-align: center;
    position: relative;
    z-index: 1;
  }

  .brand-eyebrow {
    color: var(--accent);
    letter-spacing: 0.3em;
    font-size: 0.85rem;
    font-weight: 500;
    margin-bottom: 32px;
    text-transform: uppercase;
  }

  .brand-headline {
    font-size: clamp(2.4rem, 6vw, 4.2rem);
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0.04em;
    margin-bottom: 32px;
  }

  .brand-headline .accent {
    color: var(--accent);
    background: linear-gradient(135deg, var(--accent) 0%, var(--accent2) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .brand-sub {
    color: var(--muted);
    font-size: clamp(1rem, 2vw, 1.2rem);
    line-height: 1.8;
    margin-bottom: 56px;
  }

  .hero-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }

  .hero-cta {
    display: inline-block;
    padding: 14px 36px;
    background: linear-gradient(135deg, var(--accent) 0%, var(--accent2) 100%);
    color: #1C1815;
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: 0.08em;
    border-radius: 999px;
    text-decoration: none;
    transition: transform var(--transition), box-shadow var(--transition);
    box-shadow: 0 6px 20px rgba(184, 151, 126, 0.25);
  }

  .hero-cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 28px rgba(212, 136, 106, 0.40);
    color: #1C1815;
  }

  .hero-link {
    color: var(--muted);
    font-size: 0.95rem;
    letter-spacing: 0.06em;
    text-decoration: none;
    transition: color var(--transition);
  }

  .hero-link:hover {
    color: var(--text);
  }

  .status-pill {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 22px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: rgba(255, 252, 248, 0.04);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    color: var(--text);
    font-size: 0.9rem;
    letter-spacing: 0.1em;
  }

  .status-pill .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent2);
    box-shadow: 0 0 12px var(--accent2);
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 0.6; transform: scale(1); }
    50% { opacity: 1; transform: scale(1.2); }
  }

  .brand-foot {
    color: var(--muted);
    font-size: 0.8rem;
    letter-spacing: 0.2em;
    margin-top: 64px;
  }
</style>
