---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
---

<BaseLayout title="懂屋 Know Your Home">
  <SiteHeader variant="home" />

  <main class="hero glow-bg">
    <div class="container hero-inner">
      <p class="brand-eyebrow">懂屋 · Know Your Home</p>

      <h1 class="brand-headline">
        你必須要知道的<br />
        所有裝修知識<br />
        <span class="accent">都在這裡</span>
      </h1>

      <p class="brand-sub">
        從預算規劃、風格選擇到驗收避雷，<br />
        新手屋主的裝修導航。
      </p>

      <div class="hero-actions">
        <a href="/ai-diagnosis/" class="hero-cta">開始免費診斷 →</a>
        <div class="status-pill">
          <span class="dot"></span>
          AI 裝修診斷書 · 免費
        </div>
        <a href="/posts/" class="hero-link">先看文章 →</a>
      </div>

      <p class="brand-foot">
        2026 / AI 診斷書上線
      </p>
    </div>
  </main>
</BaseLayout>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 80px 24px;
  }

  .hero-inner {
    text-align: center;
    position: relative;
    z-index: 1;
  }

  .brand-eyebrow {
    color: var(--accent);
    letter-spacing: 0.3em;
    font-size: 0.85rem;
    font-weight: 500;
    margin-bottom: 32px;
    text-transform: uppercase;
  }

  .brand-headline {
    font-size: clamp(2.4rem, 6vw, 4.2rem);
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0.04em;
    margin-bottom: 32px;
  }

  .brand-headline .accent {
    color: var(--accent);
    background: linear-gradient(135deg, var(--accent) 0%, var(--accent2) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .brand-sub {
    color: var(--muted);
    font-size: clamp(1rem, 2vw, 1.2rem);
    line-height: 1.8;
    margin-bottom: 56px;
  }

  .hero-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }

  .hero-cta {
    display: inline-block;
    padding: 14px 36px;
    background: linear-gradient(135deg, var(--accent) 0%, var(--accent2) 100%);
    color: #1C1815;
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: 0.08em;
    border-radius: 999px;
    text-decoration: none;
    transition: transform var(--transition), box-shadow var(--transition);
    box-shadow: 0 6px 20px rgba(184, 151, 126, 0.25);
  }

  .hero-cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 28px rgba(212, 136, 106, 0.40);
    color: #1C1815;
  }

  .hero-link {
    color: var(--muted);
    font-size: 0.95rem;
    letter-spacing: 0.06em;
    text-decoration: none;
    transition: color var(--transition);
  }

  .hero-link:hover {
    color: var(--text);
  }

  .status-pill {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 22px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: rgba(255, 252, 248, 0.04);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    color: var(--text);
    font-size: 0.9rem;
    letter-spacing: 0.1em;
  }

  .status-pill .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent2);
    box-shadow: 0 0 12px var(--accent2);
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 0.6; transform: scale(1); }
    50% { opacity: 1; transform: scale(1.2); }
  }

  .brand-foot {
    color: var(--muted);
    font-size: 0.8rem;
    letter-spacing: 0.2em;
    margin-top: 64px;
  }
</style>
