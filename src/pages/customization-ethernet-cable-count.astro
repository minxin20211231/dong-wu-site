---
/*
 * D003 — 客變網路線規劃
 * URL slug = customization-ethernet-cable-count
 * 詳見 _archive 的設計註記（避開 Astro 5 + Windows 中括號 bug，每篇獨立 .astro）
 */
import { getCollection } from 'astro:content';
import PostLayout from '../layouts/PostLayout.astro';

export const prerender = true;

const posts = await getCollection('posts');
const post = posts.find((p) => p.data.id === 'D003');
if (!post) throw new Error('Post D003 not found in collection');

const { Content, headings } = await post.render();
const tocHeadings = headings.filter((h) => h.depth === 2);
---

<PostLayout
  title={post.data.title}
  description={post.data.description}
  publishDate={post.data.publishDate}
  updateDate={post.data.updateDate}
  dim={post.data.dim}
  tags={post.data.tags}
  heroImage={post.data.heroImage}
  heroAlt={post.data.heroAlt}
  headings={tocHeadings}
  body={post.body}
>
  <Content />
</PostLayout>
