---
import BaseLayout from '../layouts/BaseLayout.astro';

const description = '懂屋 Know Your Home 由旻欣室內裝修設計工作室（統一編號 92493311）創辦人鄭晏旻（Bibo）打造，是給新手屋主的裝修決策系統，整合決策流程、專案管理工具與個人化數據。';
---

<BaseLayout title="關於懂屋" description={description}>
  <header class="post-topbar">
    <div class="post-topbar-inner">
      <a href="/" class="post-brand">
        <img src="/images/logo-dongwu-white.png" alt="" class="post-brand-logo" width="32" height="32" />
        <span class="brand-full">懂屋 · Know Your Home</span>
        <span class="brand-short">懂屋</span>
      </a>
      <nav class="post-nav post-nav-desktop" aria-label="主導覽">
        <a href="/about/" class="post-nav-link" aria-current="page">關於懂屋</a>
        <a href="/posts/" class="post-nav-link">所有文章</a>
        <a href="/ai-diagnosis/" class="post-nav-cta post-nav-cta-primary">免費裝修診斷</a>
        <a href="/subscribe/" class="post-nav-cta">訂閱電子報</a>
      </nav>
      <div class="post-nav-mobile">
        <a href="/ai-diagnosis/" class="post-nav-cta post-nav-cta-mobile post-nav-cta-primary">免費裝修診斷</a>
        <a href="/subscribe/" class="post-nav-cta post-nav-cta-mobile">訂閱電子報</a>
        <details class="post-menu">
          <summary class="post-menu-toggle" aria-label="開啟選單">
            <span class="post-menu-bars" aria-hidden="true"></span>
          </summary>
          <nav class="post-menu-panel" aria-label="次要導覽">
            <a href="/about/" class="post-menu-link" aria-current="page">關於懂屋</a>
            <a href="/posts/" class="post-menu-link">所有文章</a>
          </nav>
        </details>
      </div>
    </div>
  </header>

  <main class="about-main">
    <article class="about-article">
      <p class="about-eyebrow">ABOUT</p>
      <h1 class="about-title">給新手屋主的裝修導航</h1>
      <p class="about-lead">
        懂屋是一個正在搭建的決策系統。<br />
        從預算規劃、客變、風格選擇到驗收避雷——把屋主在每個環節最容易踩到的坑，整理成你查得到、看得懂、用得上的內容。
      </p>

      <section class="about-section">
        <h2>為什麼會有懂屋</h2>
        <p>
          很多屋主第一次裝修都從同一個問題開始：「我到底要準備多少錢？」
        </p>
        <p>
          然後從這個問題開始衍生一百個問題——客變要做什麼、設計師怎麼挑、預算被吃到哪去、合約有沒有陷阱、收納要做木作還是系統櫃。
        </p>
        <p>
          這些問題的答案在網路上散落各處，但沒有一個地方把它們組成一張地圖。
        </p>
        <p>
          懂屋想做這張地圖。
        </p>
      </section>

      <section class="about-section">
        <h2>懂屋會做什麼</h2>
        <ul class="about-roadmap">
          <li>
            <span class="about-roadmap-status active">進行中</span>
            <strong>365 天，每天 1 題</strong>
            <span class="about-roadmap-desc">把裝修問題拆成每天 1 題，1 年累積完整知識庫</span>
          </li>
          <li>
            <span class="about-roadmap-status">即將上線</span>
            <strong>互動工具</strong>
            <span class="about-roadmap-desc">預算組裝器、風格產生器、驗收導航、合約避雷針</span>
          </li>
          <li>
            <span class="about-roadmap-status">即將上線</span>
            <strong>新成屋導航手冊</strong>
            <span class="about-roadmap-desc">電子書，把首購族最容易爆預算的環節整理成一本</span>
          </li>
        </ul>
      </section>

      <section class="about-section">
        <h2>關於創辦人</h2>
        <div class="about-founder">
          <img src="https://minxindesign.com.tw/wp-content/uploads/2026/03/bibo-designer-profile-scaled.jpg" alt="鄭晏旻 Bibo" class="about-founder-photo" />
          <div class="about-founder-bio">
            <p class="about-founder-name">鄭晏旻（Bibo）</p>
            <p class="about-founder-role">旻欣室內裝修設計工作室 · 設計師</p>
            <p>
              持有建築物室內設計乙級、建築物室內裝修工程管理乙級雙合格證照。
              專注於透天裝潢、新成屋裝修與老屋翻新，喜歡把屋主的生活習慣融進設計裡，讓每個家住起來順手、看起來舒服。
            </p>
            <p>
              懂屋是把多年實務累積的踩坑經驗，整理成屋主能直接用的決策工具。
            </p>
          </div>
        </div>
      </section>

      <section class="about-cta">
        <p>準備好了嗎？</p>
        <div class="about-cta-actions">
          <a href="/posts/" class="about-cta-btn primary">開始看文章</a>
          <a href="/subscribe/" class="about-cta-btn secondary">訂閱電子報</a>
        </div>
      </section>
    </article>
  </main>

  <footer class="post-footer">
    <div class="post-footer-inner">
      <div class="post-footer-grid">
        <div class="post-footer-col post-footer-brand-col">
          <p class="post-footer-name">懂屋 Know Your Home</p>
          <p class="post-footer-slogan">新成屋屋主的裝修決策系統</p>
        </div>

        <div class="post-footer-col">
          <p class="post-footer-coltitle">站內導覽</p>
          <nav class="post-footer-nav">
            <a href="/about/">關於懂屋</a>
            <a href="/posts/">所有文章</a>
            <a href="https://minxindesign.com.tw" target="_blank" rel="noopener">設計師工作室</a>
            <a href="/subscribe/">訂閱電子報</a>
          </nav>
        </div>

        <div class="post-footer-col">
          <p class="post-footer-coltitle">公司資訊</p>
          <dl class="post-footer-info">
            <div>
              <dt>公司全名</dt>
              <dd>旻欣室內裝修設計工作室</dd>
            </div>
            <div>
              <dt>統一編號</dt>
              <dd>92493311</dd>
            </div>
          </dl>
        </div>
      </div>
      <p class="post-footer-copy">© 2026 懂屋 Know Your Home · 旻欣室內裝修設計工作室</p>
    </div>
  </footer>
</BaseLayout>

<style is:global>
  body.post-body {
    background: #FFFFFF;
    color: #1A1A1A;
  }

  body.post-body a {
    color: #B8977E;
    text-decoration: none;
  }

  body.post-body a:hover {
    color: #D4886A;
  }

  /* topbar 樣式同 PostLayout — 深海黑鯨金品牌色 */
  .post-topbar {
    border-bottom: 1px solid rgba(184, 151, 126, 0.22);
    background: #1C1815;
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .post-topbar-inner {
    max-width: 1180px;
    margin: 0 auto;
    padding: 16px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .post-brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 0.9rem;
    letter-spacing: 0.18em;
    color: #F5F0E8 !important;
    font-weight: 700;
    flex-shrink: 0;
  }

  .post-brand-logo {
    height: 32px;
    width: 32px;
    display: block;
    flex-shrink: 0;
  }

  .post-brand:hover {
    color: #B8977E !important;
  }

  .post-brand .brand-short {
    display: none;
  }

  .post-nav-mobile {
    display: none;
  }

  .post-nav {
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .post-nav-link {
    font-size: 0.9rem;
    color: #F5F0E8 !important;
    letter-spacing: 0.06em;
    font-weight: 600;
  }

  .post-nav-link:hover {
    color: #B8977E !important;
  }

  .post-nav-link[aria-current="page"] {
    color: #B8977E !important;
    font-weight: 700;
  }

  .post-nav-cta {
    display: inline-flex;
    align-items: center;
    padding: 9px 22px;
    border: 1px solid rgba(184, 151, 126, 0.55);
    border-radius: 999px;
    font-size: 0.85rem;
    color: #F5F0E8 !important;
    letter-spacing: 0.06em;
    font-weight: 600;
    background: transparent;
    text-decoration: none;
    transition: background 0.18s ease, color 0.18s ease, border-color 0.18s ease;
  }

  .post-nav-cta:hover {
    background: #B8977E;
    border-color: #B8977E;
    color: #1C1815 !important;
  }

  /* 主按鈕：實心金，比訂閱（外框）更突出 */
  .post-nav-cta-primary {
    background: #B8977E;
    border-color: #B8977E;
    color: #1C1815 !important;
  }

  .post-nav-cta-primary:hover {
    background: #C9A98E;
    border-color: #C9A98E;
    color: #1C1815 !important;
  }

  /* about 主體 */
  .about-main {
    background: #FFFFFF;
    min-height: calc(100vh - 200px);
    padding: 64px 24px 96px;
  }

  .about-article {
    max-width: 720px;
    margin: 0 auto;
  }

  .about-eyebrow {
    font-size: 0.8rem;
    letter-spacing: 0.3em;
    color: #B8977E;
    font-weight: 600;
    margin-bottom: 16px;
  }

  .about-title {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.01em;
    margin-bottom: 24px;
    color: #1A1A1A;
  }

  .about-lead {
    font-size: 1.15rem;
    line-height: 1.85;
    color: #444;
    margin-bottom: 56px;
  }

  .about-section {
    margin-bottom: 56px;
  }

  .about-section h2 {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 20px;
    color: #1A1A1A;
    border-left: 3px solid #B8977E;
    padding-left: 12px;
  }

  .about-section p {
    font-size: 1rem;
    line-height: 1.85;
    color: #333;
    margin-bottom: 16px;
  }

  /* roadmap 列表 */
  .about-roadmap {
    list-style: none;
    padding: 0;
    margin: 24px 0 0;
  }

  .about-roadmap li {
    display: grid;
    grid-template-columns: 90px 1fr;
    grid-template-rows: auto auto;
    gap: 4px 16px;
    padding: 18px 0;
    border-bottom: 1px solid #F0F0F0;
  }

  .about-roadmap li:last-child {
    border-bottom: none;
  }

  .about-roadmap-status {
    grid-column: 1;
    grid-row: 1 / 3;
    align-self: center;
    font-size: 0.72rem;
    color: #999;
    background: #F5F5F5;
    padding: 6px 10px;
    border-radius: 4px;
    text-align: center;
    letter-spacing: 0.05em;
    font-weight: 500;
  }

  .about-roadmap-status.active {
    color: #fff;
    background: linear-gradient(135deg, #B8977E 0%, #D4886A 100%);
  }

  .about-roadmap strong {
    font-size: 1.05rem;
    font-weight: 600;
    color: #1A1A1A;
  }

  .about-roadmap-desc {
    font-size: 0.9rem;
    color: #666;
    line-height: 1.6;
  }

  /* 創辦人 */
  .about-founder {
    display: flex;
    gap: 24px;
    align-items: flex-start;
    flex-wrap: wrap;
    background: #FAFAFA;
    padding: 28px;
    border-radius: 12px;
  }

  .about-founder-photo {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }

  .about-founder-bio {
    flex: 1;
    min-width: 240px;
  }

  .about-founder-name {
    font-size: 1.1rem;
    font-weight: 700;
    color: #1A1A1A;
    margin-bottom: 4px;
  }

  .about-founder-role {
    font-size: 0.9rem;
    color: #888;
    margin-bottom: 14px;
  }

  .about-founder-bio p {
    font-size: 0.95rem;
    line-height: 1.8;
    color: #444;
    margin-bottom: 12px;
  }

  /* CTA */
  .about-cta {
    margin-top: 80px;
    padding: 48px 32px;
    background: linear-gradient(135deg, #FAF7F2 0%, #F5EFE5 100%);
    border-radius: 16px;
    text-align: center;
  }

  .about-cta p {
    font-size: 1.3rem;
    font-weight: 600;
    color: #1A1A1A;
    margin-bottom: 24px;
  }

  .about-cta-actions {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .about-cta-btn {
    display: inline-block;
    padding: 14px 32px;
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.95rem;
    letter-spacing: 0.05em;
    transition: all 0.2s ease;
  }

  .about-cta-btn.primary {
    background: linear-gradient(135deg, #B8977E 0%, #D4886A 100%);
    color: #fff !important;
    box-shadow: 0 6px 16px rgba(184, 151, 126, 0.25);
  }

  .about-cta-btn.primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 22px rgba(212, 136, 106, 0.35);
    color: #fff !important;
  }

  .about-cta-btn.secondary {
    border: 1px solid #DDD;
    color: #AAA !important;
    background: transparent;
  }

  .about-cta-btn.disabled {
    cursor: not-allowed;
    pointer-events: none;
  }

  /* footer 同 PostLayout — 3 欄式（品牌 / 站內導覽 / 公司資訊） */
  .post-footer {
    border-top: 1px solid #EAEAEA;
    background: #FAFAFA;
  }

  .post-footer-inner {
    max-width: 1180px;
    margin: 0 auto;
    padding: 48px 24px 28px;
  }

  .post-footer-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr 1.6fr;
    gap: 48px;
    padding-bottom: 28px;
    border-bottom: 1px solid #EAEAEA;
    margin-bottom: 20px;
  }

  .post-footer-col {
    min-width: 0;
  }

  .post-footer-coltitle {
    font-size: 0.78rem;
    font-weight: 700;
    color: #1A1A1A;
    letter-spacing: 0.12em;
    margin-bottom: 16px;
    text-transform: uppercase;
  }

  .post-footer-name {
    font-size: 1.05rem;
    font-weight: 700;
    color: #1A1A1A;
    margin-bottom: 6px;
  }

  .post-footer-slogan {
    font-size: 0.875rem;
    color: #666;
    line-height: 1.6;
  }

  .post-footer-nav {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .post-footer-nav a {
    font-size: 0.875rem;
    color: #555 !important;
    text-decoration: none;
  }

  .post-footer-nav a:hover {
    color: #B8977E !important;
  }

  .post-footer-nav a.disabled {
    color: #AAA !important;
    cursor: not-allowed;
    pointer-events: none;
  }

  .post-footer-info {
    margin: 0;
  }

  .post-footer-info > div {
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: 12px;
    padding: 6px 0;
    font-size: 0.82rem;
    line-height: 1.65;
  }

  .post-footer-info dt {
    color: #888;
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  .post-footer-info dd {
    margin: 0;
    color: #333;
  }

  .post-footer-copy {
    font-size: 0.78rem;
    color: #888;
  }

  @media (max-width: 720px) {
    .post-footer-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .post-footer-info > div {
      grid-template-columns: 90px 1fr;
    }
  }

  /* about 套 post-body 樣式（白底） */
  body {
    background: #FFFFFF;
    color: #1A1A1A;
  }

  /* RWD */
  @media (max-width: 720px) {
    .post-topbar-inner {
      padding: 12px 16px;
      gap: 10px;
    }
    .post-brand {
      font-size: 1.25rem;
      letter-spacing: 0.06em;
      gap: 10px;
    }
    .post-brand-logo {
      height: 36px;
      width: 36px;
    }
    .post-brand .brand-full {
      display: none;
    }
    .post-brand .brand-short {
      display: inline;
    }
    .post-nav-desktop {
      display: none;
    }
    .post-nav-mobile {
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }
    /* 兩顆 pill 並列：免費裝修診斷（實心）+ 訂閱電子報（外框），縮小以容納漢堡 */
    .post-nav-cta-mobile {
      padding: 6px 10px;
      font-size: 0.72rem;
      letter-spacing: 0;
    }
    .post-menu {
      position: relative;
    }
    .post-menu-toggle {
      list-style: none;
      cursor: pointer;
      width: 36px;
      height: 36px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 8px;
      border: 1px solid rgba(184, 151, 126, 0.32);
    }
    .post-menu-toggle::-webkit-details-marker {
      display: none;
    }
    .post-menu-bars,
    .post-menu-bars::before,
    .post-menu-bars::after {
      display: block;
      width: 18px;
      height: 2px;
      background: #F5F0E8;
      border-radius: 2px;
    }
    .post-menu-bars {
      position: relative;
    }
    .post-menu-bars::before,
    .post-menu-bars::after {
      content: "";
      position: absolute;
      left: 0;
    }
    .post-menu-bars::before {
      top: -6px;
    }
    .post-menu-bars::after {
      top: 6px;
    }
    .post-menu-bars,
    .post-menu-bars::before,
    .post-menu-bars::after {
      transition: transform 0.2s ease, top 0.2s ease, background 0.2s ease;
    }
    /* 開啟時漢堡變 X（雷蒙風） */
    .post-menu[open] .post-menu-bars {
      background: transparent;
    }
    .post-menu[open] .post-menu-bars::before {
      top: 0;
      transform: rotate(45deg);
    }
    .post-menu[open] .post-menu-bars::after {
      top: 0;
      transform: rotate(-45deg);
    }
    /* 全寬下拉面板 — 大列好點，手機友善 */
    .post-menu[open] .post-menu-panel {
      position: fixed;
      top: 57px;
      left: 0;
      right: 0;
      background: #1C1815;
      border-top: 1px solid rgba(184, 151, 126, 0.28);
      padding: 4px 0 8px;
      display: flex;
      flex-direction: column;
      box-shadow: 0 14px 30px rgba(0, 0, 0, 0.5);
      z-index: 60;
    }
    .post-menu-link {
      display: block;
      padding: 16px 24px;
      color: #F5F0E8 !important;
      font-size: 1rem;
      letter-spacing: 0.04em;
      font-weight: 600;
      text-decoration: none;
      border-bottom: 1px solid rgba(184, 151, 126, 0.12);
    }
    .post-menu-link[aria-current="page"] {
      color: #B8977E !important;
    }
    .post-menu-link:active,
    .post-menu-link:hover {
      color: #B8977E !important;
      background: rgba(184, 151, 126, 0.08);
    }
    .about-main {
      padding: 40px 20px 64px;
    }
    .about-roadmap li {
      grid-template-columns: 1fr;
    }
    .about-roadmap-status {
      grid-row: auto;
      justify-self: start;
      margin-bottom: 6px;
    }
    .about-cta {
      padding: 32px 20px;
    }
  }

  @media (max-width: 480px) {
    .post-brand {
      font-size: 0.78rem;
      letter-spacing: 0.1em;
    }
    .post-nav-link[href="/about/"] {
      display: none;
    }
  }
</style>
