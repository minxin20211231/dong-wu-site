---
// 自動生成 — 來源：文欣交付 2026-05-19 / 懂屋_四型屋主_概覽卡_v1.html
// 重新生成請跑：python scripts/build_5types_page.py
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="五型屋主｜你是哪一型裝修屋主"
  description="資料控、直覺派、守備型、規劃型、自包派——五種裝修屋主性格，看看你是哪一型，以及最容易卡關的地方。免費 AI 診斷書幫你對號入座。"
  image="/ai-diagnosis/assets/logo_gold.png"
  imageAlt="懂屋 Know Your Home"
>
<style is:inline>
*{margin:0;padding:0;box-sizing:border-box}
:root{
  --bg-dark:#1C1815;
  --bg-light:#F5F0E8;
  --bg-cream:#E8DCC8;
  --accent:#B8977E;
  --accent2:#D4886A;
  --warn:#B85A3A;
  --ok:#6B8F5A;
  --text-on-cream:#2A2118;
  --muted-on-cream:#5A4A3D;
  --border-on-cream:rgba(28,24,21,.10);
  --border-accent:rgba(184,151,126,.35);
  --spring:cubic-bezier(.34,1.56,.64,1);
}
html{background:#1C1815}
html,body{font-family:-apple-system,"PingFang TC","Noto Serif TC","Microsoft JhengHei",serif;}
body{
  min-height:100vh;
  display:flex;flex-direction:column;align-items:center;
  padding:48px 24px;gap:32px;
  color:var(--text-on-cream);
  background:#1C1815 url('/ai-diagnosis/assets/footer_whale.png') center top / cover no-repeat fixed;
}
body::before{
  content:'';position:fixed;inset:0;pointer-events:none;z-index:0;
  background:linear-gradient(180deg,rgba(28,24,21,.25) 0%,rgba(28,24,21,.55) 50%,rgba(28,24,21,.9) 100%);
}
body > *{position:relative;z-index:1}
/* ===== Top label ===== */
.page-label{
  color:#B8977E;font-size:11px;letter-spacing:5px;text-transform:uppercase;font-weight:800;
  display:flex;gap:12px;align-items:center;
}
.page-label::before,.page-label::after{
  content:'';width:36px;height:1px;background:rgba(184,151,126,.5);
}

/* ===== Type nav (sticky chips) ===== */
.type-nav{
  position:sticky;top:16px;z-index:50;
  display:flex;gap:10px;flex-wrap:wrap;justify-content:center;
  padding:10px 14px;border-radius:30px;
  background:rgba(28,24,21,.85);backdrop-filter:blur(20px);
  border:1px solid rgba(184,151,126,.25);
  box-shadow:0 12px 32px rgba(0,0,0,.4);
}
.type-nav-item{
  font-size:12px;letter-spacing:2px;font-weight:700;
  color:rgba(245,240,232,.7);
  padding:8px 16px;border-radius:30px;
  border:1px solid rgba(184,151,126,.22);
  text-decoration:none;transition:all .2s ease;
}
.type-nav-item:hover{
  color:#fff;border-color:var(--accent2);
  background:linear-gradient(135deg,var(--accent),var(--accent2));
}

/* ===== Cards container ===== */
#cards-container{
  display:flex;flex-direction:column;gap:48px;
  align-items:center;
}
.card{scroll-margin-top:80px;}

/* ===== Card ===== */
.card{
  width:720px;
  background:var(--bg-cream);
  border-radius:32px;
  position:relative;overflow:hidden;
  box-shadow:0 30px 80px rgba(0,0,0,.6),0 0 0 1px rgba(184,151,126,.18);
  isolation:isolate;
}
/* paper texture */
.card::before{
  content:'';position:absolute;inset:0;pointer-events:none;z-index:0;
  background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='320' height='320'><filter id='p'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 0.30 0 0 0 0 0.22 0 0 0 0 0.14 0 0 0 0.06 0'/></filter><rect width='100%' height='100%' filter='url(%23p)'/></svg>");
  opacity:.55;mix-blend-mode:multiply;
}
/* soft accent glow top-right */
.card::after{
  content:'';position:absolute;
  width:420px;height:420px;border-radius:50%;
  filter:blur(80px);opacity:.28;pointer-events:none;z-index:0;
  background:radial-gradient(circle,var(--accent2),transparent 70%);
  top:-140px;right:-140px;
}
.card > *{position:relative;z-index:1}

/* ===== Hero (title + character) ===== */
.hero{
  display:grid;grid-template-columns:1fr 1fr;gap:32px;
  padding:48px 48px 24px;
  align-items:start;
}
.hero-left{display:flex;flex-direction:column;gap:18px;padding-top:8px}
.hero-left .tags{margin-top:auto;padding-top:12px}

/* "YOUR HOUSE OWNER" 標籤 */
.owner-badge{
  display:inline-flex;align-items:center;
  font-size:10px;letter-spacing:4px;font-weight:700;
  color:var(--muted-on-cream);
  background:rgba(255,255,255,.5);
  border:1px solid rgba(28,24,21,.10);
  padding:7px 16px;border-radius:30px;
  align-self:flex-start;
  text-transform:uppercase;
}

/* 主標題：宋體大字，cream 上直接顯示 */
.role-name{
  font-family:"Noto Serif TC",serif;
  font-size:46px;font-weight:900;letter-spacing:2px;line-height:1.05;
  color:var(--text-on-cream);
  margin:4px 0 0;
}

/* SPELL block — plain text 無卡片 */
.spell-block{display:flex;flex-direction:column;gap:6px;margin-top:8px}
.spell-en{
  font-size:11px;letter-spacing:6px;color:var(--accent);
  font-weight:800;text-transform:uppercase;
  font-family:"Archivo Black","Inter",sans-serif;
}
.spell-zh{
  font-family:"Noto Serif TC",serif;
  font-size:28px;font-weight:900;letter-spacing:6px;
  color:var(--text-on-cream);line-height:1.1;
}
.spell-quote{
  font-family:"Noto Serif TC",serif;
  font-size:13.5px;color:var(--muted-on-cream);
  font-style:italic;letter-spacing:1px;line-height:1.7;
  margin-top:10px;display:flex;align-items:flex-start;gap:6px;
}
.spell-quote::before{
  content:'\201C';font-size:32px;line-height:.6;color:var(--accent);
  font-style:normal;font-weight:900;font-family:"Noto Serif TC",serif;
  flex-shrink:0;margin-top:8px;
}
.spell-quote::after{
  content:'\201D';font-size:32px;line-height:0;color:var(--accent);
  font-style:normal;font-weight:900;font-family:"Noto Serif TC",serif;
  flex-shrink:0;align-self:flex-end;margin-bottom:-8px;
}

.tags{display:flex;flex-wrap:nowrap;gap:6px;margin-top:8px;white-space:nowrap}
.tag{
  display:inline-flex;align-items:center;gap:5px;
  font-size:11px;letter-spacing:.5px;
  color:var(--muted-on-cream);font-weight:700;
  background:rgba(255,255,255,.5);
  border:1px solid rgba(28,24,21,.08);
  padding:6px 11px;border-radius:30px;
  flex-shrink:0;
}
.tag svg{width:12px;height:12px;color:var(--accent);flex-shrink:0}

/* ===== Character art ===== */
.character-frame{
  border-radius:24px;
  aspect-ratio:1/1.05;
  position:relative;overflow:hidden;
  background:#FBF6EE;
  border:1px solid rgba(184,151,126,.18);
  box-shadow:0 12px 30px rgba(28,24,21,.08);
}
.char-image-area{
  position:relative;height:100%;width:100%;
  overflow:hidden;border-radius:24px;
}
.char-image-area img{
  width:100%;height:100%;display:block;
  object-fit:cover;object-position:center center;
}
.corner-badge{
  position:absolute;top:14px;left:14px;z-index:3;
  font-size:9px;letter-spacing:3px;font-weight:800;
  color:var(--accent);background:rgba(255,255,255,.85);
  border:1px solid rgba(184,151,126,.3);
  padding:4px 10px;border-radius:30px;
  text-transform:uppercase;
  backdrop-filter:blur(6px);
}
.character-fallback{
  position:absolute;inset:0;display:flex;flex-direction:column;
  align-items:center;justify-content:center;gap:8px;
  color:rgba(245,240,232,.65);
  font-size:13px;letter-spacing:2px;text-align:center;line-height:1.6;
  padding:24px;
}
.character-fallback .icon{font-size:48px;opacity:.5}

/* vertical tagline column on the right edge of frame */
.vtagline{
  writing-mode:vertical-rl;text-orientation:upright;
  font-family:"Noto Serif TC",serif;
  font-size:14px;letter-spacing:8px;line-height:1.4;
  color:rgba(245,240,232,.92);font-weight:600;
  padding:28px 0;
  background:linear-gradient(180deg,#1C1815 0%,#2A2118 100%);
  display:flex;align-items:flex-start;justify-content:center;
  position:relative;z-index:3;
  white-space:nowrap;
}

/* ===== Body — 兩張獨立卡 + 大圓 icon + 裝飾插畫 ===== */
.section-stack{
  margin:24px 48px 0;
  display:flex;flex-direction:column;gap:18px;
}
.section-card{
  background:#FFFEFC;
  border:1px solid var(--border-on-cream);
  border-radius:22px;
  padding:28px 28px 28px 100px;
  position:relative;overflow:hidden;
  box-shadow:0 8px 24px rgba(28,24,21,.06);
  min-height:140px;
  display:flex;flex-direction:column;justify-content:center;gap:10px;
}
.section-card.warn{
  background:#FFF5EE;
  border-color:rgba(184,90,58,.18);
}
.section-card .big-icon{
  position:absolute;left:28px;top:28px;
  width:54px;height:54px;border-radius:50%;
  background:linear-gradient(135deg,var(--accent),var(--accent2));
  display:flex;align-items:center;justify-content:center;
  color:#fff;font-size:24px;font-weight:900;
  box-shadow:0 6px 16px rgba(184,151,126,.4);
}
.section-card.warn .big-icon{
  background:linear-gradient(135deg,var(--warn),#D8704E);
  box-shadow:0 6px 16px rgba(184,90,58,.35);
}
.section-card .deco-illust{
  position:absolute;right:18px;top:50%;transform:translateY(-50%);
  width:130px;height:130px;opacity:.65;pointer-events:none;
}
.section-card .deco-illust img{width:100%;height:100%;object-fit:contain}
.section-title{
  font-family:"Noto Serif TC",serif;
  font-size:20px;font-weight:900;letter-spacing:2px;
  color:var(--text-on-cream);
}
.section-text{
  font-size:14.5px;line-height:1.85;
  color:var(--text-on-cream);
  letter-spacing:.5px;
}
.section-text strong{
  color:var(--accent2);font-weight:700;
}
.section-card.warn .section-text strong{
  color:var(--warn);
}

/* ===== Pairing — 獨立列（米奶底，跟前兩卡區隔）===== */
.pairing{
  margin:18px 48px 0;
  background:#F4EAD8;
  border:1px solid rgba(184,151,126,.22);
  border-radius:22px;
  padding:22px 28px;
  display:grid;grid-template-columns:auto 1fr;align-items:center;gap:28px;
  box-shadow:0 8px 24px rgba(28,24,21,.06);
}
.pairing .pair-chip{background:#fff}
.pair-label{
  display:flex;flex-direction:column;gap:2px;flex-shrink:0;
}
.pair-label-title{
  font-size:13px;letter-spacing:2px;color:var(--text-on-cream);
  font-weight:800;
}
.pair-label-sub{
  font-size:10px;letter-spacing:2px;color:var(--muted-on-cream);
  font-weight:600;
}
.pair-list{display:flex;gap:14px;flex-wrap:wrap;justify-content:center}
.pair-chip{
  display:flex;align-items:center;gap:10px;
  background:var(--bg-cream);
  border:1px solid var(--border-on-cream);
  border-radius:40px;padding:6px 16px 6px 6px;
  transition:transform .2s ease;
}
.pair-chip:hover{transform:translateY(-2px)}
.pair-avatar{
  width:48px;height:48px;border-radius:50%;
  overflow:hidden;flex-shrink:0;
  background:linear-gradient(135deg,#FFFFFF 0%,#FBF6EE 100%);
  border:2px solid #fff;
  box-shadow:0 2px 8px rgba(28,24,21,.12);
  position:relative;
}
.pair-avatar img{
  position:absolute;
  width:300%;height:auto;
  top:-22%;left:50%;
  transform:translateX(-50%);
}
.pair-name{
  font-size:13px;font-weight:700;color:var(--text-on-cream);
  letter-spacing:1px;line-height:1.2;
  display:flex;flex-direction:column;gap:1px;
}
.pair-name small{
  font-size:9.5px;color:var(--muted-on-cream);
  font-weight:600;letter-spacing:1.5px;
}
.pair-cta{
  display:flex;flex-direction:column;align-items:center;gap:2px;
  background:linear-gradient(135deg,var(--accent),var(--accent2));
  color:#fff;border-radius:14px;padding:10px 14px;
  font-size:11px;letter-spacing:2px;font-weight:800;line-height:1.3;
  text-align:center;flex-shrink:0;
  box-shadow:0 6px 16px rgba(184,151,126,.4);
}
.pair-cta .arrow{font-size:14px;letter-spacing:0;margin-top:2px}

/* ===== Footer share button ===== */
.share-btn{
  display:flex;align-items:center;gap:14px;
  margin:24px 42px 16px;
  padding:18px 24px;
  border:none;cursor:pointer;
  border-radius:18px;
  background:linear-gradient(135deg,var(--accent),var(--accent2));
  color:#fff;text-align:left;
  font-family:inherit;
  box-shadow:0 10px 28px rgba(184,151,126,.4);
  transition:transform .2s ease,box-shadow .2s ease;
  width:calc(100% - 84px);
}
.share-btn:hover{
  transform:translateY(-2px);
  box-shadow:0 14px 36px rgba(184,151,126,.5);
}
.share-btn:active{transform:translateY(0)}
.share-icon{
  width:42px;height:42px;border-radius:50%;
  background:rgba(255,255,255,.18);
  display:flex;align-items:center;justify-content:center;
  flex-shrink:0;font-size:20px;
}
.share-text{display:flex;flex-direction:column;gap:2px;flex:1}
.share-title{
  font-size:15px;font-weight:800;letter-spacing:2px;
}
.share-sub{
  font-size:11px;letter-spacing:1.5px;opacity:.85;
}
.share-arrow{
  font-size:18px;font-weight:900;
}
.share-btn{margin:24px 48px 0;width:calc(100% - 96px)}

/* ===== Brand bottom — hashes 米色 + brand-row 深色 ===== */
.brand-bottom{
  margin-top:32px;
  display:grid;grid-template-rows:auto auto;
  font-size:10.5px;letter-spacing:3px;font-weight:700;
  text-transform:uppercase;
}
.brand-bottom .brand-hashes{
  display:flex;gap:18px;justify-content:center;flex-wrap:wrap;
  padding:22px 48px;
  background:var(--bg-cream);
  color:var(--accent);font-weight:700;letter-spacing:2px;
}
.brand-bottom .brand-row{
  display:flex;justify-content:space-between;align-items:center;
  padding:18px 28px;
  background:var(--bg-dark);
  color:rgba(245,240,232,.7);
}
.brand-bottom .brand-block{
  display:flex;align-items:center;gap:10px;
}
.brand-bottom .brand-icon{
  width:24px;height:24px;border-radius:6px;
  background:linear-gradient(135deg,var(--accent),var(--accent2));
  display:flex;align-items:center;justify-content:center;
  color:#fff;font-size:13px;flex-shrink:0;
}
.brand-bottom .brand{
  color:var(--accent);font-weight:900;letter-spacing:4px;font-size:13px;
}
.brand-bottom .brand-en{
  color:rgba(245,240,232,.65);font-weight:700;letter-spacing:4px;font-size:10.5px;
}
.brand-bottom .brand-type{
  color:rgba(245,240,232,.65);font-weight:700;letter-spacing:3px;
}

/* meta note */
.meta-note{
  color:rgba(245,240,232,.4);font-size:11px;letter-spacing:2px;
  text-align:center;max-width:720px;line-height:1.7;
}
.meta-note code{
  background:rgba(184,151,126,.12);
  color:#B8977E;padding:2px 8px;border-radius:6px;
  font-family:"Noto Sans Mono",monospace;font-size:10px;letter-spacing:0;
}
</style>




<!-- Type nav -->
<nav class="type-nav">
  <a href="#type-01" class="type-nav-item">01 資料控</a>
  <a href="#type-02" class="type-nav-item">02 直覺派</a>
  <a href="#type-03" class="type-nav-item">03 守備型</a>
  <a href="#type-04" class="type-nav-item">04 規劃型</a>
  <a href="#type-05" class="type-nav-item">05 自包派</a>
</nav>

<div id="cards-container"></div>



<script is:inline>
const TYPES = [
  {
    num: '01',
    name: '資料控屋主',
    spell: '全網爬梳術',
    spellEn: 'SPELL · 01',
    quote: '「比過 5 家，才知道誰沒在打迷糊仗。」',
    tags: ['# 考據癖', '# 收藏控', '# 求精準'],
    img: '/ai-diagnosis/assets/character_resource.png',
    skill: '<strong>三家報價單你會做成 Excel 對照表</strong>，連「坪計價」「實作計價」「材料另列」這種細節都不放過。Pinterest 收藏破 200 張、Mobile01 每篇後悔文都讀過。在你眼裡，沒有「裝修玄學」這種事 —— <strong>只是還沒查到夠多案例而已。</strong>',
