    pairs: [
      { img: '/ai-diagnosis/assets/character_intuitive.png', name: '直覺派', tagline: '感覺找路徑', av: 'width:180%;top:-12%;left:50%;' },
      { img: '/ai-diagnosis/assets/character_defender.png', name: '守備型', tagline: '雙人謹慎同盟', av: 'width:180%;top:-5%;left:50%;' }
    ],
