      { img: '/ai-diagnosis/assets/character_solo.png', name: '自包派', tagline: '情報共同體', av: 'width:180%;top:-12%;left:50%;' }
    ],
    hashtags: ['# 懂屋診斷', '# 資料控屋主', '# 找你的裝修搭檔']
  },
  {
    num: '02',
    name: '直覺派屋主',
    spell: '氛圍直覺術',
    spellEn: 'SPELL · 02',
    quote: '「我說不出來，但走進去就知道對不對。」',
    tags: ['# vibe優先', '# 手感派', '# 感覺領航'],
    img: '/ai-diagnosis/assets/character_intuitive.png',
    skill: 'Pinterest 收藏 200 張全是<strong>奶油風／韓系／侘寂</strong>。你說不出「拱形門洞要 1/4 圓還是半圓」，但材質和光線你身體比腦袋先反應。對你來說，<strong>家不是「組合出來的」，是「感覺對了才是家」。</strong>',
