      { img: '/ai-diagnosis/assets/character_planner.png', name: '規劃型', tagline: '感覺先走規劃補洞', av: 'width:180%;top:-12%;left:50%;' }
    ],
    hashtags: ['# 懂屋診斷', '# 直覺派屋主', '# 找你的裝修搭檔']
  },
  {
    num: '03',
    name: '守備型屋主',
    spell: '萬全防護術',
    spellEn: 'SPELL · 03',
    quote: '「漏水沒人理之前，先把保固寫進合約。」',
    tags: ['# 防雷王', '# 謹慎派', '# 保固至上'],
    img: '/ai-diagnosis/assets/character_defender.png',
    skill: '<strong>防水保固期、五年瑕疵擔保、驗屋報告</strong>你都查過。簽約前你會把每一條條款讀三遍，連「材料品牌寫不寫進報價單」「隱藏工程怎麼驗收」都不放過。<strong>沒寫進合約的承諾，你不信。</strong>',
    stuck: '隱藏工程（水電、防水、結構）你絕對不省，但<strong>預算容易被「安全配備」吃掉</strong>，美感和個性被擠到後面 —— 做完很實用，但少了一點是「家」的感覺。',
    pairs: [
      { img: '/ai-diagnosis/assets/character_planner.png', name: '規劃型', tagline: '雙人謹慎同盟', av: 'width:180%;top:-5%;left:50%;' },
      { img: '/ai-diagnosis/assets/character_solo.png', name: '自包派', tagline: '幫你顧雷區', av: 'width:180%;top:-12%;left:50%;' }
    ],
    hashtags: ['# 懂屋診斷', '# 守備型屋主', '# 找你的裝修搭檔']
  },
  {
    num: '04',
    name: '規劃型屋主',
    spell: '十年推演術',
