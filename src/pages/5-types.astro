// 標籤 icon (3 種重複使用)
const TAG_ICONS = {
  target: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4"/><circle cx="12" cy="12" r="1" fill="currentColor"/></svg>',
  recycle: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 12a9 9 0 1 0 3-6.7"/><path d="M3 4v5h5"/></svg>',
  star: '<svg viewBox="0 0 24 24" fill="currentColor" stroke="none"><path d="M12 2l2.6 7h7.4l-6 4.4 2.3 7.6L12 16l-6.3 5 2.3-7.6-6-4.4h7.4z"/></svg>',
  spark: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 2v8M12 14v8M2 12h8M14 12h8M5 5l5 5M14 14l5 5M19 5l-5 5M10 14l-5 5"/></svg>'
};

// 裝飾插畫改用 codex 生成的 PNG（fallback 內嵌 SVG）
const DECO_SKILL_IMG = '/ai-diagnosis/assets/icon_skill.png';
const DECO_STUCK_IMG = '/ai-diagnosis/assets/icon_stuck.png';

function renderCard(t, idx) {
  const total = TYPES.length;
  const tagIcons = ['target','recycle','star','spark'];
  const tagsHtml = t.tags.map((x,i) =>
    `<span class="tag">${TAG_ICONS[tagIcons[i]]||TAG_ICONS.star}<span>${x.replace(/^#\s*/,'')}</span></span>`
  ).join('');
  const pairsHtml = t.pairs.map(p =>
    `<div class="pair-chip">
       <div class="pair-avatar"><img src="${p.img}" alt="${p.name}" style="position:absolute;transform:translateX(-50%);${p.av || 'width:300%;top:-15%;left:50%;'}"></div>
       <div class="pair-name"><span>${p.name}</span><small>${p.tagline}</small></div>
     </div>`
  ).join('');
  const hashHtml = t.hashtags.map(x => `<span>${x}</span>`).join('');
  return `
    <div class="card" id="type-${t.num}">
      <div class="hero">
        <div class="hero-left">
          <span class="owner-badge">YOUR HOUSE OWNER</span>
          <h2 class="role-name">${t.name}</h2>
          <div class="spell-block">
            <div class="spell-en">${t.spellEn}</div>
            <div class="spell-zh">${t.spell}</div>
            <div class="spell-quote">${t.quote.replace(/^[「『]|[」』]$/g,'')}</div>
          </div>
          <div class="tags">${tagsHtml}</div>
        </div>
        <div class="character-frame">
          <div class="char-image-area">
            <img src="${t.img}" alt="${t.name}"
                 onerror="this.style.display='none';this.nextElementSibling.style.display='flex';">
            <div class="character-fallback" style="display:none">
              <div class="icon">⏳</div>
              <div>角色插畫生成中…<br>codex 完成後自動載入</div>
            </div>
          </div>
        </div>
      </div>
      <div class="section-stack">
        <div class="section-card">
          <div class="big-icon">✓</div>
          <div class="section-title">絕招特徵</div>
          <p class="section-text">${t.skill}</p>
        </div>
        <div class="section-card warn">
          <div class="big-icon">⚠</div>
          <div class="section-title">容易卡關的地方</div>
          <p class="section-text">${t.stuck}</p>
        </div>
      </div>
      <div class="pairing">
        <div class="pair-label">
          <div class="pair-label-title">黃金搭檔</div>
          <div class="pair-label-sub">PARTNERS</div>
        </div>
        <div class="pair-list">${pairsHtml}</div>
      </div>
      <button class="share-btn" onclick="shareCard('${t.num}','${t.name}')">
        <span class="share-icon">↗</span>
        <span class="share-text">
          <span class="share-title">分享給你的伴侶測測看</span>
          <span class="share-sub">看看你們是不是裝修黃金組合</span>
        </span>
        <span class="share-arrow">→</span>
      </button>
      <div class="brand-bottom">
        <div class="brand-hashes">${hashHtml}</div>
        <div class="brand-row">
          <div class="brand-block">
            <img src="/ai-diagnosis/assets/logo_gold.png" alt="懂屋" style="width:28px;height:28px;object-fit:contain;flex-shrink:0">
            <span class="brand">懂屋</span>
            <span class="brand-en">KNOW YOUR HOME</span>
          </div>
          <div class="brand-type">OWNER TYPE ${t.num} / 0${total}</div>
        </div>
      </div>
    </div>
  `;
}

document.getElementById('cards-container').innerHTML =
  TYPES.map(renderCard).join('');

async function shareCard(num, name) {
  const url = window.location.href.split('#')[0] + '#type-' + num;
  const text = `我是「${name}」— 來測測你的裝修屋主類型，看我們是不是黃金組合 ↓`;
  if (navigator.share) {
    try {
      await navigator.share({ title: '懂屋・五型屋主診斷', text, url });
      return;
    } catch (e) { /* user cancelled */ }
  }
  try {
    await navigator.clipboard.writeText(text + '\n' + url);
    showToast('連結已複製，貼給你的伴侶吧 💌');
  } catch (e) {
    prompt('複製這段分享給伴侶：', text + '\n' + url);
  }
}

function showToast(msg) {
  let t = document.getElementById('toast');
  if (!t) {
    t = document.createElement('div');
    t.id = 'toast';
    t.style.cssText = 'position:fixed;bottom:32px;left:50%;transform:translateX(-50%);background:rgba(28,24,21,.95);color:#F5F0E8;padding:14px 24px;border-radius:30px;font-size:13px;letter-spacing:1.5px;font-weight:600;z-index:9999;box-shadow:0 12px 32px rgba(0,0,0,.4);transition:opacity .3s;';
    document.body.appendChild(t);
  }
  t.textContent = msg;
  t.style.opacity = '1';
  clearTimeout(t._timer);
  t._timer = setTimeout(() => { t.style.opacity = '0'; }, 2400);
}
</script>


</BaseLayout>
