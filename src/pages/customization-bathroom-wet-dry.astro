---
/*
 * D005 — 客變衛浴乾濕分離要怎麼提？預算面 5 個...
 * URL slug = customization-bathroom-wet-dry
 * 自動產生於 publish_post.py（每篇獨立 .astro 繞 Astro 5 + Windows 中括號 bug）
 */
import { getCollection } from 'astro:content';
import PostLayout from '../layouts/PostLayout.astro';

export const prerender = true;

const posts = await getCollection('posts');
const post = posts.find((p) => p.data.id === 'D005');
if (!post) throw new Error('Post D005 not found in collection');

const { Content, headings } = await post.render();
const tocHeadings = headings.filter((h) => h.depth === 2);
---

<PostLayout
  title={post.data.title}
  description={post.data.description}
  publishDate={post.data.publishDate}
  updateDate={post.data.updateDate}
  dim={post.data.dim}
  tags={post.data.tags}
  heroImage={post.data.heroImage}
  heroAlt={post.data.heroAlt}
  headings={tocHeadings}
>
  <Content />
</PostLayout>
