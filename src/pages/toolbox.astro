---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import ResourceFooter from '../components/ResourceFooter.astro';
import ResourcePreview from '../components/ResourcePreview.astro';
import RevealOnScroll from '../components/RevealOnScroll.astro';

const tools = [
  {
    title: 'AI 裝修診斷書',
    tag: '登島入口・已上線',
    hook: ['3 分鐘、18 題，', '拿到你的屋主職業卡'],
    items: [
      '你的屋主類型職業卡',
      '預算怎麼分的方向建議',
      '照你家人口與物量給的提醒清單',
    ],
    cta: '免費開始測驗',
    href: '/ai-diagnosis/',
    kind: 'diagnosis' as const,
  },
  {
    title: '裝修該花多少錢？',
    tag: 'Email 信件課・每天一封',
    hook: ['12 天搞懂', '24 個工程項目'],
    items: [
      '每天一封，拆一個花錢重點',
      '預算組裝器表格隨課附上',
      '最後一封說清楚圖說與報價的下一步',
    ],
    cta: '免費開課',
    href: '/budget-kit/',
    kind: 'budget' as const,
  },
  {
    title: '裝修前收納',
    tag: '免費工具＋知識庫',
    hook: ['櫃子做之前，', '先數東西'],
    items: [
      '物品盤點工作表：七區逐格盤點＋櫃體換算',
      '單篇收納技巧陸續整理上線',
      '「白做的櫃子」避雷提醒',
    ],
    cta: '了解這張表',
    href: '/inventory-worksheet/',
    kind: 'inventory' as const,
  },
];

const heroCharacters = [
  { file: 'character_planner', className: 'hero-character-planner' },
  { file: 'character_resource', className: 'hero-character-resource' },
  { file: 'character_intuitive', className: 'hero-character-intuitive' },
];

const routeStages = [
  { index: '01', label: '簽約前', className: 'stage-demolition' },
  { index: '02', label: '施工中', className: 'stage-structure' },
  { index: '03', label: '驗收', className: 'stage-fitout' },
  { index: '04', label: '入住', className: 'stage-complete' },
];

const routeStops = [
  ['7%', '76%'], ['13%', '69%'], ['20%', '66%'], ['27%', '72%'],
  ['34%', '78%'], ['41%', '73%'], ['48%', '65%'], ['55%', '60%'],
  ['62%', '63%'], ['69%', '70%'], ['76%', '74%'], ['82%', '68%'],
  ['87%', '58%'], ['91%', '48%'], ['94%', '37%'],
].map(([left, top], index) => ({ left, top, index: index + 1 }));
---

<BaseLayout
  title="裝修工具箱｜裝修前用得上的免費工具都在這 — 懂屋"
  description="免費裝修診斷、費用信件課、物品盤點工作表——裝修前該想清楚的，這一頁先讓你免費想一遍。留下 Email 就能拿。"
  exactTitle
  bottomNav={false}
  noindex
>
  {/* noindex＝軟上線（header 入口「建置中」期間不收錄）；正式開放時移除 */}
  <SiteHeader current="toolbox" />

  <main class="toolbox-page">
    <section class="toolbox-hero">
      <div class="toolbox-wrap hero-grid">
        <div class="hero-copy" data-reveal>
          <p class="eyebrow">KNOW YOUR HOME · TOOLBOX</p>
          <h1>裝修工具箱</h1>
          <p class="hero-lead">
            裝修前用得上的工具，懂屋都放在這一頁。<strong>留下 Email 就能拿</strong>——從測出家的方向、搞懂費用，到盤點真正需要的收納量。
          </p>
          <a class="hero-cta" href="#tools">看看有哪些工具 <span aria-hidden="true">↓</span></a>
        </div>
        <div class="hero-world" data-reveal data-toolbox-scene tabindex="0" style="--reveal-delay: 100ms" aria-label="滑過或點擊打開懂屋裝修工具箱">
          <div class="hero-world-glow" aria-hidden="true"></div>
          <div class="hero-characters" aria-hidden="true">
            {heroCharacters.map((character, index) => (
              <picture class:list={['hero-character', character.className]}>
                <source srcset={`/ai-diagnosis/assets/${character.file}.webp`} type="image/webp" />
                <img
                  src={`/ai-diagnosis/assets/${character.file}.png`}
                  alt=""
                  width="1024"
                  height="1024"
                  loading="eager"
                  fetchpriority={index === 1 ? 'high' : 'auto'}
                  decoding="async"
                />
              </picture>
            ))}
          </div>

          <div class="toolbox-effects" aria-hidden="true">
            <span class="burst-rays"></span>
            <span class="burst-ring burst-ring-one"></span>
            <span class="burst-ring burst-ring-two"></span>
            <span class="burst-spark spark-one">✦</span>
            <span class="burst-spark spark-two">✦</span>
            <span class="burst-spark spark-three">✦</span>
            <span class="burst-spark spark-four">✦</span>
            <span class="burst-spark spark-five">✦</span>
            <span class="burst-spark spark-six">✦</span>
          </div>

          <div class="hero-tool-orbit" aria-hidden="true">
            <span class="orbit-tool" data-tool-name="鐵鎚" style="--tool-x: 0px; --tool-y: -238px; --tool-r: -8deg; --tool-delay: 40ms">
              <svg class="tool-art" viewBox="0 0 80 80">
                <defs><linearGradient id="hammer-head" x1="0" x2="1"><stop stop-color="#59656A"/><stop offset=".52" stop-color="#A9B4B5"/><stop offset="1" stop-color="#40494D"/></linearGradient><linearGradient id="hammer-grip" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#F0B85D"/><stop offset="1" stop-color="#B86A3E"/></linearGradient></defs>
                <g transform="rotate(-38 40 40)"><rect x="35" y="26" width="12" height="45" rx="6" fill="url(#hammer-grip)"/><rect x="16" y="13" width="49" height="22" rx="8" fill="url(#hammer-head)"/><rect x="21" y="17" width="30" height="5" rx="2.5" fill="#DDE5E3" opacity=".68"/><path d="M61 16h7v16h-7z" fill="#30383B"/></g>
              </svg>
            </span>
            <span class="orbit-tool" data-tool-name="活動板手" style="--tool-x: -148px; --tool-y: -188px; --tool-r: -12deg; --tool-delay: 100ms">
              <svg class="tool-art" viewBox="0 0 80 80">
                <defs><linearGradient id="wrench-body" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#D9EEE8"/><stop offset=".48" stop-color="#75A6A4"/><stop offset="1" stop-color="#365E63"/></linearGradient><linearGradient id="wrench-edge" x1="0" x2="1"><stop stop-color="#F2B56E"/><stop offset="1" stop-color="#D26B4E"/></linearGradient></defs>
                <g transform="rotate(-38 40 40)"><path d="M55 5c-10-3-21 0-28 8-6 8-6 19-1 27L8 58a10 10 0 0 0 14 14l18-18c9 5 20 4 28-3 8-7 11-18 8-28L61 38 44 21 55 5Z" fill="url(#wrench-body)"/><path d="m55 5-11 16 17 17 15-15" fill="none" stroke="url(#wrench-edge)" stroke-width="7" stroke-linecap="round" stroke-linejoin="round"/><rect x="28" y="38" width="18" height="10" rx="5" fill="#344A4C"/><path d="M31 41h12" stroke="#F7D49D" stroke-width="3" stroke-linecap="round"/><circle cx="15" cy="65" r="4.5" fill="#F3D9B7" stroke="#365E63" stroke-width="3"/><path d="M13 55 35 33" stroke="#E9F4F0" stroke-width="3" stroke-linecap="round" opacity=".55"/></g>
              </svg>
            </span>
            <span class="orbit-tool" data-tool-name="電鑽" style="--tool-x: 148px; --tool-y: -188px; --tool-r: 9deg; --tool-delay: 160ms">
              <svg class="tool-art" viewBox="0 0 80 80">
                <defs><linearGradient id="drill-body" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#F2A667"/><stop offset=".6" stop-color="#D2694B"/><stop offset="1" stop-color="#9A493D"/></linearGradient><linearGradient id="drill-dark" x1="0" x2="1"><stop stop-color="#51443E"/><stop offset="1" stop-color="#261F1C"/></linearGradient></defs>
                <path d="M13 20h39c7 0 13 6 13 13v8H45l-5 7H17c-5 0-9-4-9-9V25c0-3 2-5 5-5Z" fill="url(#drill-body)"/><path d="M49 44h12v8H49z" fill="#D8C3AA"/><path d="M61 46h15v4H61z" fill="#51443E"/><path d="M27 45h19l-5 27H24l-3-14z" fill="url(#drill-dark)"/><rect x="26" y="52" width="15" height="7" rx="3" fill="#B8977E"/><rect x="16" y="25" width="27" height="6" rx="3" fill="#FFC896" opacity=".62"/><circle cx="54" cy="34" r="6" fill="#F4D49A"/>
              </svg>
            </span>
            <span class="orbit-tool" data-tool-name="滾輪" style="--tool-x: 205px; --tool-y: -70px; --tool-r: 13deg; --tool-delay: 220ms">
              <svg class="tool-art" viewBox="0 0 80 80">
                <defs><linearGradient id="roller-fill" x1="0" y1="0" x2="0" y2="1"><stop stop-color="#F5E5C8"/><stop offset="1" stop-color="#C8A77B"/></linearGradient><linearGradient id="roller-grip" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#E78967"/><stop offset="1" stop-color="#A54E3D"/></linearGradient></defs>
                <rect x="8" y="12" width="48" height="22" rx="8" fill="url(#roller-fill)"/><rect x="11" y="15" width="40" height="5" rx="2.5" fill="#FFF9EC" opacity=".75"/><path d="M56 23h9v18H42v9" fill="none" stroke="#6E655E" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"/><rect x="34" y="44" width="17" height="30" rx="8" fill="url(#roller-grip)"/><rect x="38" y="49" width="6" height="17" rx="3" fill="#F4B08D" opacity=".62"/>
              </svg>
            </span>
            <span class="orbit-tool" data-tool-name="色票" style="--tool-x: 200px; --tool-y: 44px; --tool-r: -8deg; --tool-delay: 280ms">
              <svg class="tool-art" viewBox="0 0 80 80">
                <g transform="rotate(-10 24 56)"><rect x="13" y="12" width="27" height="57" rx="8" fill="#FFF7E9" stroke="#BCA68F" stroke-width="3"/><circle cx="26" cy="58" r="4" fill="#59453A"/><circle cx="26" cy="23" r="7" fill="#D4886A"/><circle cx="26" cy="39" r="7" fill="#E7B75D"/></g><g transform="rotate(15 36 58)"><rect x="28" y="11" width="27" height="58" rx="8" fill="#F6E9D7" stroke="#BCA68F" stroke-width="3"/><circle cx="41" cy="58" r="4" fill="#59453A"/><circle cx="41" cy="23" r="7" fill="#7F9B83"/><circle cx="41" cy="39" r="7" fill="#7796A8"/></g><g transform="rotate(34 48 56)"><rect x="42" y="12" width="27" height="57" rx="8" fill="#FFF9F1" stroke="#BCA68F" stroke-width="3"/><circle cx="55" cy="58" r="4" fill="#59453A"/><circle cx="55" cy="23" r="7" fill="#9A6D58"/><circle cx="55" cy="39" r="7" fill="#D9C4AB"/></g>
              </svg>
            </span>
            <span class="orbit-tool" data-tool-name="計算器" style="--tool-x: 158px; --tool-y: 62px; --tool-r: 9deg; --tool-delay: 340ms">
              <svg class="tool-art" viewBox="0 0 80 80">
                <defs><linearGradient id="calc-body" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#5E514A"/><stop offset="1" stop-color="#211B18"/></linearGradient></defs>
                <rect x="16" y="5" width="48" height="70" rx="12" fill="url(#calc-body)"/><rect x="23" y="13" width="34" height="14" rx="5" fill="#D6E2D4"/><rect x="27" y="17" width="20" height="5" rx="2.5" fill="#718270"/><g fill="#EBD8C4"><circle cx="28" cy="38" r="6"/><circle cx="42" cy="38" r="6"/><circle cx="28" cy="53" r="6"/><circle cx="42" cy="53" r="6"/><circle cx="28" cy="67" r="6"/><rect x="36" y="61" width="20" height="12" rx="6" fill="#D4886A"/></g><circle cx="55" cy="38" r="6" fill="#E7B75D"/><circle cx="55" cy="53" r="6" fill="#A9C0B0"/>
              </svg>
            </span>
            <span class="orbit-tool" data-tool-name="捲尺" style="--tool-x: -158px; --tool-y: 62px; --tool-r: -10deg; --tool-delay: 400ms">
              <svg class="tool-art" viewBox="0 0 80 80">
                <defs><linearGradient id="tape-body" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#F3C95F"/><stop offset=".65" stop-color="#D78A3F"/><stop offset="1" stop-color="#A95738"/></linearGradient></defs>
                <path d="M12 36c0-16 12-28 28-28s28 12 28 28v19c0 10-8 18-18 18H30c-10 0-18-8-18-18Z" fill="url(#tape-body)"/><circle cx="40" cy="39" r="17" fill="#3E3530"/><circle cx="40" cy="39" r="9" fill="#F4E2C6"/><path d="M54 58h22v9H54z" fill="#F3DE95"/><path d="M60 58v9m8-9v9" stroke="#7A5D3D" stroke-width="2"/><rect x="20" y="17" width="30" height="7" rx="3.5" fill="#FFE89A" opacity=".58"/>
              </svg>
            </span>
            <span class="orbit-tool" data-tool-name="尺與筆" style="--tool-x: -200px; --tool-y: 44px; --tool-r: 8deg; --tool-delay: 460ms">
              <svg class="tool-art" viewBox="0 0 80 80">
                <defs><linearGradient id="ruler-fill" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#D9B686"/><stop offset="1" stop-color="#A97850"/></linearGradient><linearGradient id="pencil-fill" x1="0" x2="1"><stop stop-color="#EE8465"/><stop offset="1" stop-color="#C14F45"/></linearGradient></defs>
                <g transform="rotate(-34 40 40)"><rect x="31" y="3" width="18" height="74" rx="6" fill="url(#ruler-fill)"/><g stroke="#715039" stroke-width="2"><path d="M32 14h8M32 24h12M32 34h8M32 44h12M32 54h8M32 64h12"/></g></g><g transform="rotate(34 40 40)"><path d="M34 7h12v57H34z" fill="url(#pencil-fill)"/><path d="m34 64 6 13 6-13z" fill="#F1D3A1"/><path d="m38 73 2 4 2-4z" fill="#40352F"/><path d="M34 7h12v9H34z" fill="#E8B7A9"/><path d="M37 18h4v39h-4z" fill="#FFB59B" opacity=".55"/></g>
              </svg>
            </span>
            <span class="orbit-tool" data-tool-name="安全帽" style="--tool-x: -205px; --tool-y: -70px; --tool-r: -9deg; --tool-delay: 520ms">
              <svg class="tool-art" viewBox="0 0 80 80">
                <defs><linearGradient id="helmet-fill" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#FFD875"/><stop offset=".58" stop-color="#EAA84B"/><stop offset="1" stop-color="#C56B39"/></linearGradient></defs>
                <path d="M10 49c0-21 13-37 30-37s30 16 30 37H10Z" fill="url(#helmet-fill)"/><path d="M39 12v27" stroke="#B96638" stroke-width="6" stroke-linecap="round"/><path d="M8 48h64c4 0 7 3 7 7s-3 7-7 7H8c-4 0-7-3-7-7s3-7 7-7Z" fill="#F3B657"/><path d="M17 45c2-13 10-23 21-26" fill="none" stroke="#FFE6A2" stroke-width="6" stroke-linecap="round" opacity=".65"/><path d="M19 62c3 7 11 11 21 11s18-4 21-11" fill="none" stroke="#695044" stroke-width="4" stroke-linecap="round"/>
              </svg>
            </span>
          </div>

          <div class="toolbox-stage" aria-hidden="true">
            <div class="hero-toolbox">
              <div class="toolbox-lid">
                <span class="toolbox-handle"></span>
                <strong>懂屋</strong>
                <small>TOOLBOX</small>
              </div>
              <div class="toolbox-inner"><span></span><span></span><span></span><span></span></div>
              <div class="toolbox-body">
                <strong>懂屋</strong>
                <small>裝修工具箱</small>
              </div>
            </div>
          </div>

          <p class="hero-world-note"><span class="hint-pointer" aria-hidden="true">↘</span><span class="note-idle">把游標移到工具箱，打開看看</span></p>
        </div>
      </div>
    </section>

    <section class="trust-strip">
      <div class="toolbox-wrap trust-card" data-reveal>
        <div class="trust-badge" aria-hidden="true">
          <img src="/images/logo-dongwu-white.png" alt="" width="48" height="48" />
        </div>
        <div class="trust-copy">
          <p class="trust-title">先把問題整理清楚，再做決定。</p>
          <p>裝修前不用一次搞懂所有事。從預算、物品到生活需求，選一個現在用得上的工具，慢慢把家的方向理清楚。</p>
          <span>懂屋｜Know Your Home</span>
        </div>
        <a class="trust-cta" href="#tools">選一個工具開始 <span aria-hidden="true">→</span></a>
      </div>
    </section>

    <section id="tools" class="tools-section">
      <div class="toolbox-wrap">
        <div class="section-heading" data-reveal>
          <p class="eyebrow">FREE TOOLS</p>
          <h2>從你現在最卡的地方開始</h2>
          <p>不用一次把裝修全部弄懂。先拿一個工具，把眼前這題處理掉。</p>
        </div>

        <div class="tools-grid">
          {tools.map((tool, index) => (
            <article class="tool-card" data-reveal style={`--reveal-delay: ${index * 70}ms`}>
              <div class="tool-card-topline">
                <span>{tool.tag}</span>
                <small>0{index + 1}</small>
              </div>
              <ResourcePreview kind={tool.kind} label={`${tool.title}預覽`} compact />
              <div class="tool-card-copy">
                <p class="tool-name">{tool.title}</p>
                <h3>{tool.hook.map((line) => <span>{line}</span>)}</h3>
                <ul>
                  {tool.items.map((item) => <li>{item}</li>)}
                </ul>
                <a href={tool.href} class="tool-cta">{tool.cta}<span aria-hidden="true">→</span></a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="map-section">
      <div class="toolbox-wrap map-grid">
        <div class="map-copy" data-reveal>
          <p class="eyebrow">開島籌備中・登島預約</p>
          <h2>裝修新手島</h2>
          <p class="island-slogan">把裝修給導航，讓新手也能走成一條路</p>
          <p class="map-lead">Threads 上 60 多站的裝修導航系列，正在變成一座可以走的島——照裝修順序一站一站走，每站幾分鐘，走到哪、住到哪。</p>
          <ul class="island-highlights">
            <li><strong>開島第一天通知你</strong><span>Email 寄出登島消息，不用每天回來看進度。</span></li>
            <li><strong>帶著屋主職業卡上島</strong><span>做過診斷的島民，之後能解鎖自己這型屋主的專屬內容。</span></li>
            <li><strong>軟裝圖鑑籌備中</strong><span>全部符合台灣格局的風格圖庫，選風格不用再滑國外圖猜尺寸。</span></li>
          </ul>

          <form class="map-form" data-integration="pending" data-event="island_waitlist_join">
            <label for="island-name">如何稱呼你？</label>
            <input id="island-name" name="name" type="text" autocomplete="name" placeholder="你的稱呼" required />
            <label for="island-email">Email</label>
            <input id="island-email" name="email" type="email" inputmode="email" autocomplete="email" placeholder="你的 Email" required />
            <label for="island-question">你最想先解決什麼裝修問題？<small>選填</small></label>
            <textarea id="island-question" name="question" rows="3" placeholder="預算怎麼抓才不會爆？"></textarea>
            <button type="submit">預約登島</button>
            <p>不寄廣告、不給任何人你的 Email，隨時可退訂。</p>
          </form>
        </div>

        <div class="island-visuals" data-reveal style="--reveal-delay: 100ms">
          <div class="route-card" aria-label="裝修新手島 15 站路線示意">
            <div class="route-card-head">
              <div>
                <small>4 STAGES · 15 STOPS</small>
                <p>你的裝修路線</p>
              </div>
              <div class="route-whale" aria-hidden="true">
                <img src="/ai-diagnosis/assets/logo_gold.webp" alt="" width="76" height="76" loading="lazy" decoding="async" />
              </div>
            </div>
            <p class="route-swipe-hint">左右滑動看完整地圖</p>
            <div class="route-visual-scroll">
              <div class="route-visual">
                <img
                  src="/toolbox/assets/toolbox-route-map-v2.webp"
                  alt="從簽約前、施工、驗收到入住的裝修階段立體示意圖"
                  width="1536"
                  height="1024"
                  loading="lazy"
                  decoding="async"
                />
                <div class="route-stops" aria-hidden="true">
                  {routeStops.map((stop) => (
                    <span style={`--stop-left:${stop.left};--stop-top:${stop.top}`}>{stop.index}</span>
                  ))}
                </div>
                {routeStages.map((stage) => (
                  <div class:list={['map-stage-tag', stage.className]}>
                    <span>{stage.index}</span>
                    <strong>{stage.label}</strong>
                  </div>
                ))}
              </div>
            </div>
            <div class="route-phases" aria-hidden="true">
              <span>簽約前</span><span>施工中</span><span>驗收</span><span>入住</span>
            </div>
            <div class="route-stamp">COMING SOON</div>
          </div>

          <div class="atlas-card" data-asset-slot="soft-furnishing-atlas.webp" role="img" aria-label="軟裝圖鑑預告：四種台灣居家風格示意">
            <div class="atlas-copy">
              <small>ISLAND PREVIEW</small>
