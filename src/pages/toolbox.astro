<script>
  const hoverPointer = window.matchMedia('(hover: hover) and (pointer: fine)');

  document.querySelectorAll<HTMLElement>('[data-toolbox-scene]').forEach((scene) => {
    scene.addEventListener('pointermove', (event) => {
      if (!hoverPointer.matches) return;
      const bounds = scene.getBoundingClientRect();
      const x = (event.clientX - bounds.left) / bounds.width - 0.5;
      const y = (event.clientY - bounds.top) / bounds.height - 0.5;
      scene.style.setProperty('--scene-rx', `${(-y * 4).toFixed(2)}deg`);
      scene.style.setProperty('--scene-ry', `${(x * 5).toFixed(2)}deg`);
    });

    scene.addEventListener('pointerleave', () => {
      scene.style.setProperty('--scene-rx', '0deg');
      scene.style.setProperty('--scene-ry', '0deg');
    });

    scene.addEventListener('click', () => {
      if (hoverPointer.matches) return;
      const willOpen = !scene.classList.contains('is-open');
      scene.classList.toggle('is-open', willOpen);
      if (!willOpen) scene.blur();
    });

    scene.addEventListener('keydown', (event) => {
      if (event.key !== 'Enter' && event.key !== ' ') return;
      event.preventDefault();
      scene.classList.toggle('is-open');
    });
  });
</script>

